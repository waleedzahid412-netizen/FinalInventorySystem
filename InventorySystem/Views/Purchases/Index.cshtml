@model InventorySystem.ViewModels.Purchases.PurchaseListViewModel

@{
    ViewData["Title"] = "Purchase Invoices";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-cart-check-fill text-primary me-2"></i>Purchase Invoices</h2>
            <p class="text-muted mb-0">Procure inventory from manufacturing companies and track vendor balances.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Create Purchase Invoice
            </a>
        </div>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Form -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Invoice Number</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-hash"></i></span>
                        <input type="text" name="InvoiceNumber" value="@Model.Filter.InvoiceNumber" class="form-control" placeholder="PINV-..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Company</label>
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                            <i class="bi bi-building me-1"></i>@Model.CompanyName
                        </span>
                    </div>
                    <input type="hidden" name="CompanyID" value="@Model.Filter.CompanyID" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Warehouse</label>
                    <select name="WarehouseID" class="form-select form-select-sm" asp-items="Model.Warehouses">
                        <option value="">-- All Warehouses --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Date From</label>
                    <input type="date" name="DateFrom" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Date To</label>
                    <input type="date" name="DateTo" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Invoices Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Invoice Number</th>
                            <th>Company</th>
                            <th>Warehouse</th>
                            <th>Invoice Date</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-end">Paid Amount</th>
                            <th class="text-end">Outstanding</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Items != null && Model.Items.Items.Any())
                        {
                            foreach (var item in Model.Items.Items)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">
                                        <i class="bi bi-receipt me-1"></i>@item.InvoiceNumber
                                    </td>
                                    <td>@item.CompanyName</td>
                                    <td><span class="badge bg-light text-dark border">@item.WarehouseName</span></td>
                                    <td>@item.InvoiceDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end fw-semibold">PKR @item.GrandTotal.ToString("N2")</td>
                                    <td class="text-end text-success">PKR @item.PaidAmount.ToString("N2")</td>
                                    <td class="text-end @(item.Outstanding > 0 ? "text-danger fw-bold" : "text-muted")">
                                        PKR @item.Outstanding.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (item.PaymentStatus == "PAID")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>PAID</span>
                                        }
                                        else if (item.PaymentStatus == "PARTIAL")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>PARTIAL</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>UNPAID</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Details" asp-route-id="@item.PurchaseInvoiceID" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No purchase invoices found matching your criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (Model.Items.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <span class="small text-muted">
                    Showing @(((Model.Items.PageNumber - 1) * Model.Items.PageSize) + 1) to
                    @(Math.Min(Model.Items.PageNumber * Model.Items.PageSize, Model.Items.TotalCount)) of @Model.Items.TotalCount invoices
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.Items.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageNumber="@(Model.Items.PageNumber - 1)"
                               asp-route-InvoiceNumber="@Model.Filter.InvoiceNumber"
                               asp-route-CompanyID="@Model.Filter.CompanyID"
                               asp-route-WarehouseID="@Model.Filter.WarehouseID"
                               asp-route-PaymentStatus="@Model.Filter.PaymentStatus">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.Items.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Items.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-PageNumber="@i"
                                   asp-route-InvoiceNumber="@Model.Filter.InvoiceNumber"
                                   asp-route-CompanyID="@Model.Filter.CompanyID"
                                   asp-route-WarehouseID="@Model.Filter.WarehouseID"
                                   asp-route-PaymentStatus="@Model.Filter.PaymentStatus">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.Items.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageNumber="@(Model.Items.PageNumber + 1)"
                               asp-route-InvoiceNumber="@Model.Filter.InvoiceNumber"
                               asp-route-CompanyID="@Model.Filter.CompanyID"
                               asp-route-WarehouseID="@Model.Filter.WarehouseID"
                               asp-route-PaymentStatus="@Model.Filter.PaymentStatus">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
