@model InventorySystem.DTOs.Common.PagedResult<InventorySystem.DTOs.Purchases.PurchaseLedgerEntryDto>

@if (Model.Items != null && Model.Items.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ledger ID</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th class="text-end">Debit (Payment)</th>
                    <th class="text-end">Credit (Purchase)</th>
                    <th>Created By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><code>#CL-@item.CompanyLedgerID</code></td>
                        <td>@item.TransactionDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge bg-secondary">@item.TransactionType</span></td>
                        <td>@item.Description</td>
                        <td class="text-end text-success">
                            PKR @item.DebitAmount.ToString("N2")
                        </td>
                        <td class="text-end text-danger fw-bold">
                            PKR @item.CreditAmount.ToString("N2")
                        </td>
                        <td>@item.CreatedByName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info border-0 bg-light text-center py-4 mb-0">
        <i class="bi bi-info-circle fs-3 d-block mb-2 text-primary"></i>
        No ledger transactions posted for this purchase invoice yet.
    </div>
}
