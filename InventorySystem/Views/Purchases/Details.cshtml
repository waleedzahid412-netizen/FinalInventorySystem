@model InventorySystem.ViewModels.Purchases.PurchaseDetailsViewModel

@{
    ViewData["Title"] = $"Purchase Invoice - {Model.Header.InvoiceNumber}";
    var header = Model.Header;
    var financial = Model.Financial;
}

@section Styles {
    <link rel="stylesheet" href="~/css/sales-details.css" asp-append-version="true" />
}

<div class="container-fluid px-4 py-4 purchase-details-page">
    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-start mb-4 sd-page-header">
        <div class="sd-breadcrumb">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Purchasing</a></li>
                    <li class="breadcrumb-item active">@header.InvoiceNumber</li>
                </ol>
            </nav>
            <h1 class="sd-page-title">Invoice #@header.InvoiceNumber</h1>
            <p class="sd-page-subtitle mb-0">@header.CompanyName · @header.InvoiceDate.ToString("dd MMM yyyy")</p>
        </div>

        <div class="sd-toolbar">
            @if (financial.Outstanding > 0)
            {
                <div class="sd-toolbar-group">
                    <button type="button" class="sd-btn sd-btn-primary" id="btnOpenCompanyPaymentModal">
                        <i class="bi bi-cash-stack"></i> Record Company Payment
                    </button>
                </div>
                <span class="sd-toolbar-divider" aria-hidden="true"></span>
            }

            <div class="sd-toolbar-group">
                <a asp-controller="Returns" asp-action="ProcessPurchaseReturn" asp-route-invoiceId="@header.PurchaseInvoiceID" class="sd-btn sd-btn-outline">
                    <i class="bi bi-box-arrow-left"></i> Process Return
                </a>
                @if (!Model.IsLocked)
                {
                    <a asp-action="Edit" asp-route-id="@header.PurchaseInvoiceID" class="sd-btn sd-btn-outline">
                        <i class="bi bi-pencil-square"></i> Edit Invoice
                    </a>
                }
                else
                {
                    <span class="sd-lock-badge"><i class="bi bi-lock-fill"></i> Financial Lock</span>
                }
            </div>

            <span class="sd-toolbar-divider" aria-hidden="true"></span>

            <div class="sd-toolbar-group">
                <a asp-action="DownloadPdf" asp-route-id="@header.PurchaseInvoiceID" class="sd-btn sd-btn-outline" target="_blank">
                    <i class="bi bi-file-earmark-pdf"></i> Download PDF
                </a>
            </div>

            <span class="sd-toolbar-divider" aria-hidden="true"></span>

            <a asp-action="Index" class="sd-btn sd-btn-link">
                <i class="bi bi-arrow-left"></i> Back to Invoices
            </a>
        </div>
    </div>

    <!-- Locked Banner if Payments Exist -->
    <div id="lockedCompanyInvoiceBanner" class="sd-lock-banner d-flex align-items-start gap-3 mb-4 @(Model.IsLocked ? "" : "d-none")" role="alert">
        <i class="bi bi-lock-fill flex-shrink-0 mt-1"></i>
        <div>
            <strong>Invoice locked.</strong> Company payments have been recorded against this purchase invoice. Historical financial transactions are permanently immutable.
        </div>
    </div>

    <!-- Financial KPI Summary -->
    <div class="sd-kpi-grid mb-4">
        <div class="sd-kpi">
            <div class="sd-kpi-label">Grand Total</div>
            <div class="sd-kpi-value" id="kpiCompanyGrandTotal">PKR @financial.GrandTotal.ToString("N2")</div>
        </div>
        <div class="sd-kpi">
            <div class="sd-kpi-label">Paid Amount</div>
            <div class="sd-kpi-value" id="kpiCompanyPaidAmount">PKR @financial.PaidAmount.ToString("N2")</div>
        </div>
        <div class="sd-kpi">
            <div class="sd-kpi-label">Outstanding Payable</div>
            <div class="sd-kpi-value sd-kpi-value--emphasis" id="kpiCompanyOutstanding">PKR @financial.Outstanding.ToString("N2")</div>
        </div>
        <div class="sd-kpi">
            <div class="sd-kpi-label">Payment Status</div>
            <div id="kpiCompanyPaymentStatus">
                @if (header.PaymentStatus == "PAID")
                {
                    <span class="sd-status sd-status--paid"><i class="bi bi-check-circle"></i> Paid</span>
                }
                else if (header.PaymentStatus == "PARTIAL")
                {
                    <span class="sd-status sd-status--partial"><i class="bi bi-clock-history"></i> Partial</span>
                }
                else
                {
                    <span class="sd-status sd-status--unpaid"><i class="bi bi-circle"></i> Unpaid</span>
                }
            </div>
        </div>
    </div>

    <!-- Header Details -->
    <div class="sd-section mb-4">
        <div class="sd-section-header">Invoice Information</div>
        <div class="sd-section-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="sd-field-label">Company</span>
                    <span class="sd-field-value">@header.CompanyName</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">System Invoice #</span>
                    <span class="sd-field-value sd-field-value--mono">@header.InvoiceNumber</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Supplier Invoice #</span>
                    <span class="sd-field-value">@(string.IsNullOrWhiteSpace(header.SupplierInvoiceNumber) ? "—" : header.SupplierInvoiceNumber)</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Destination Warehouse</span>
                    <span class="sd-field-value">@header.WarehouseName</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Purchase Date</span>
                    <span class="sd-field-value">@header.InvoiceDate.ToString("dd MMMM yyyy")</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Created By</span>
                    <span class="sd-field-value">@header.CreatedByName</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Created Timestamp</span>
                    <span class="sd-field-value sd-field-value--mono">@header.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Purchased Line Items -->
    <div class="sd-section mb-4">
        <div class="sd-section-header">Purchased Line Items</div>
        <div class="sd-section-body sd-section-body--flush">
            <div class="table-responsive">
                <table class="table align-middle mb-0 sd-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product Name</th>
                            <th>SKU</th>
                            <th class="text-center">Packaging Unit</th>
                            <th class="text-end">Purchased Qty</th>
                            <th class="text-end">Converted Base Qty</th>
                            <th class="text-end">Unit Cost</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            int index = 1;
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-muted">@index</td>
                                    <td class="fw-semibold">@item.ProductName</td>
                                    <td><span class="sd-tag">@(item.SKU ?? "-")</span></td>
                                    <td class="text-center"><span class="sd-unit-tag">@item.UnitName</span></td>
                                    <td class="text-end">@item.Quantity.ToString("G29")</td>
                                    <td class="text-end sd-field-value--mono">@item.ConvertedQuantity.ToString("G29") @item.BaseUnitName</td>
                                    <td class="text-end">PKR @item.UnitCost.ToString("N2")</td>
                                    <td class="text-end fw-semibold">PKR @item.TotalCost.ToString("N2")</td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-end sd-grand-total">Grand Total</td>
                            <td class="text-end sd-grand-total">PKR @financial.GrandTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Asynchronous Financial History Tabs (AD-7) -->
    <div class="sd-section mb-5">
        <ul class="sd-tabs nav nav-tabs border-0" id="purchaseTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="sd-tab nav-link active border-0" id="payments-tab" data-bs-toggle="tab" data-bs-target="#payments" type="button" role="tab">
                    Payment History
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="sd-tab nav-link border-0" id="ledger-tab" data-bs-toggle="tab" data-bs-target="#ledger" type="button" role="tab">
                    Company Ledger
                </button>
            </li>
        </ul>
        <div class="tab-content" id="purchaseTabsContent">
            <div class="tab-pane fade show active sd-tab-pane" id="payments" role="tabpanel">
                <div id="paymentsTabContainer">
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Loading payment history...
                    </div>
                </div>
            </div>
            <div class="tab-pane fade sd-tab-pane" id="ledger" role="tabpanel">
                <div id="ledgerTabContainer">
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Loading ledger entries...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Record Company Payment Modal -->
<div class="modal fade" id="recordCompanyPaymentModal" tabindex="-1" aria-labelledby="recordCompanyPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content sd-modal-content border-0">
            <div class="modal-header sd-modal-header">
                <h5 class="modal-title" id="recordCompanyPaymentModalLabel">Record Company Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="recordCompanyPaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="payCompanyPurchaseInvoiceID" value="@header.PurchaseInvoiceID" />
                <input type="hidden" id="payCompanyCompanyID" value="@header.CompanyID" />

                <div class="modal-body py-3">
                    <div class="sd-summary mb-3">
                        <div class="sd-summary-row">
                            <span class="text-muted">Target Invoice</span>
                            <strong>#@header.InvoiceNumber</strong>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Company (Supplier)</span>
                            <strong>@header.CompanyName</strong>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Grand Total</span>
                            <span class="fw-semibold">PKR @financial.GrandTotal.ToString("N2")</span>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Already Paid</span>
                            <span class="fw-semibold" id="payCompanyModalAlreadyPaid">PKR @financial.PaidAmount.ToString("N2")</span>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Outstanding Balance</span>
                            <strong id="payCompanyModalOutstanding">PKR @financial.Outstanding.ToString("N2")</strong>
                        </div>
                    </div>

                    <div id="companyPaymentModalAlert" class="alert alert-danger p-2 small d-none mb-3"></div>

                    <div class="mb-3">
                        <label for="payCompanyAmount" class="form-label fw-semibold small">Payment Amount (PKR) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control form-control-lg" id="payCompanyAmount" value="@financial.Outstanding.ToString("F2")" required />
                        <div class="form-text small">Must not exceed outstanding balance.</div>
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyMethod" class="form-label fw-semibold small">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="payCompanyMethod" required data-no-select2>
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <div id="detailsCompanyChequeFields" class="sd-cheque-panel mb-3 d-none">
                        <h6 class="fw-bold small mb-2">Cheque Details</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label for="payCompanyChequeNumber" class="form-label small fw-semibold">Cheque Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="payCompanyChequeNumber" placeholder="e.g. CHQ-771122" />
                            </div>
                            <div class="col-md-6">
                                <label for="payCompanyBankName" class="form-label small fw-semibold">Bank Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="payCompanyBankName" placeholder="e.g. Allied Bank" />
                            </div>
                            <div class="col-md-6">
                                <label for="payCompanyIssueDate" class="form-label small fw-semibold">Issue Date</label>
                                <input type="date" class="form-control form-control-sm" id="payCompanyIssueDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label for="payCompanyChequeDate" class="form-label small fw-semibold">Cheque Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control form-control-sm" id="payCompanyChequeDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyReference" class="form-label fw-semibold small">Reference Number</label>
                        <input type="text" class="form-control" id="payCompanyReference" placeholder="e.g. Bank Transfer Ref / Voucher #" />
                        <div class="form-text small d-none" id="refCompanyRequiredHelp">Reference number is required for Bank payments.</div>
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyDate" class="form-label fw-semibold small">Payment Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="payCompanyDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyRemarks" class="form-label fw-semibold small">Remarks / Notes</label>
                        <input type="text" class="form-control" id="payCompanyRemarks" placeholder="Optional payment notes" />
                    </div>
                </div>

                <div class="modal-footer sd-modal-footer">
                    <button type="button" class="sd-btn sd-btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="sd-btn sd-btn-primary" id="btnSubmitCompanyPayment">
                        <span id="payCompanySpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i id="payCompanyIcon" class="bi bi-check-circle"></i> Save Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const invoiceId = @header.PurchaseInvoiceID;
            let currentOutstanding = @financial.Outstanding;
            let currentPaid = @financial.PaidAmount;
            const grandTotal = @financial.GrandTotal;

            const paymentModal = new bootstrap.Modal(document.getElementById('recordCompanyPaymentModal'));
            const btnOpenModal = document.getElementById('btnOpenCompanyPaymentModal');

            if (btnOpenModal) {
                btnOpenModal.addEventListener('click', function () {
                    document.getElementById('payCompanyAmount').value = currentOutstanding.toFixed(2);
                    document.getElementById('companyPaymentModalAlert').classList.add('d-none');
                    paymentModal.show();
                });
            }

            const payMethodSelect = document.getElementById('payCompanyMethod');
            const refRequiredHelp = document.getElementById('refCompanyRequiredHelp');
            const detailsChequeFields = document.getElementById('detailsCompanyChequeFields');

            function toggleCompanyChequeFields(method) {
                if (method === 'Cheque') {
                    detailsChequeFields.classList.remove('d-none');
                    refRequiredHelp.classList.add('d-none');
                } else if (method === 'Bank') {
                    detailsChequeFields.classList.add('d-none');
                    refRequiredHelp.classList.remove('d-none');
                } else {
                    detailsChequeFields.classList.add('d-none');
                    refRequiredHelp.classList.add('d-none');
                }
            }

            if (window.jQuery) {
                window.jQuery(payMethodSelect).off('change.chequeToggle').on('change.chequeToggle', function () {
                    toggleCompanyChequeFields(window.jQuery(this).val());
                });
            } else {
                payMethodSelect.addEventListener('change', function () {
                    toggleCompanyChequeFields(this.value);
                });
            }

            // Submit Payment AJAX
            document.getElementById('btnSubmitCompanyPayment').addEventListener('click', function () {
                const alertBox = document.getElementById('companyPaymentModalAlert');
                alertBox.classList.add('d-none');

                const amount = parseFloat(document.getElementById('payCompanyAmount').value) || 0;
                const method = document.getElementById('payCompanyMethod').value;
                const reference = document.getElementById('payCompanyReference').value;
                const payDate = document.getElementById('payCompanyDate').value;
                const remarks = document.getElementById('payCompanyRemarks').value;

                const chqNum = document.getElementById('payCompanyChequeNumber').value;
                const bankName = document.getElementById('payCompanyBankName').value;
                const issueDate = document.getElementById('payCompanyIssueDate').value;
                const chequeDate = document.getElementById('payCompanyChequeDate').value;

                if (amount <= 0) {
                    alertBox.textContent = 'Payment amount must be greater than zero.';
                    alertBox.classList.remove('d-none');
                    return;
                }

                if (amount > currentOutstanding + 0.001) {
                    alertBox.textContent = `Payment cannot exceed outstanding balance (PKR ${currentOutstanding.toFixed(2)}).`;
                    alertBox.classList.remove('d-none');
                    return;
                }

                if (method === 'Cheque') {
                    if (!chqNum.trim()) {
                        alertBox.textContent = 'Cheque Number is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (!bankName.trim()) {
                        alertBox.textContent = 'Bank Name is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (!chequeDate) {
                        alertBox.textContent = 'Cheque Date is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                } else if (method === 'Bank' && !reference.trim()) {
                    alertBox.textContent = 'Reference Number is required for Bank payments.';
                    alertBox.classList.remove('d-none');
                    return;
                }

                const payload = {
                    PurchaseInvoiceID: invoiceId,
                    CompanyID: parseInt(document.getElementById('payCompanyCompanyID').value),
                    Amount: amount,
                    PaymentMethod: method,
                    ReferenceNumber: reference,
                    PaymentDate: payDate,
                    Remarks: remarks,
                    ChequeNumber: chqNum,
                    BankName: bankName,
                    IssueDate: issueDate || null,
                    ChequeDate: chequeDate || null
                };

                const token = document.querySelector('#recordCompanyPaymentForm input[name="__RequestVerificationToken"]').value;

                const btn = this;
                btn.disabled = true;
                document.getElementById('payCompanySpinner').classList.remove('d-none');
                document.getElementById('payCompanyIcon').classList.add('d-none');

                fetch('/Payments/RecordCompanyPayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                })
                .then(res => res.json())
                .then(data => {
                    btn.disabled = false;
                    document.getElementById('payCompanySpinner').classList.add('d-none');
                    document.getElementById('payCompanyIcon').classList.remove('d-none');

                    if (data.success) {
                        paymentModal.hide();

                        currentPaid += amount;
                        currentOutstanding = Math.max(0, grandTotal - currentPaid);

                        document.getElementById('kpiCompanyPaidAmount').textContent = 'PKR ' + currentPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('kpiCompanyOutstanding').textContent = 'PKR ' + currentOutstanding.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('payCompanyModalAlreadyPaid').textContent = 'PKR ' + currentPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('payCompanyModalOutstanding').textContent = 'PKR ' + currentOutstanding.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                        const statusElem = document.getElementById('kpiCompanyPaymentStatus');
                        if (currentOutstanding <= 0.001) {
                            statusElem.innerHTML = '<span class="sd-status sd-status--paid"><i class="bi bi-check-circle"></i> Paid</span>';
                            if (btnOpenModal) btnOpenModal.classList.add('d-none');
                        } else {
                            statusElem.innerHTML = '<span class="sd-status sd-status--partial"><i class="bi bi-clock-history"></i> Partial</span>';
                        }

                        document.getElementById('lockedCompanyInvoiceBanner').classList.remove('d-none');

                        loadPaymentsTab(1);
                        if (ledgerLoaded) loadLedgerTab(1);
                    } else {
                        alertBox.textContent = data.message || 'Failed to record payment.';
                        alertBox.classList.remove('d-none');
                    }
                })
                .catch(err => {
                    btn.disabled = false;
                    document.getElementById('payCompanySpinner').classList.add('d-none');
                    document.getElementById('payCompanyIcon').classList.remove('d-none');
                    alertBox.textContent = 'An error occurred while saving payment.';
                    alertBox.classList.remove('d-none');
                });
            });

            // Load Payment History Tab
            function loadPaymentsTab(page) {
                fetch(`/Payments/GetCompanyPaymentHistoryPartial?invoiceId=${invoiceId}`)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('paymentsTabContainer').innerHTML = html;
                    })
                    .catch(err => {
                        document.getElementById('paymentsTabContainer').innerHTML = '<div class="alert alert-danger">Failed to load payments.</div>';
                    });
            }

            let ledgerLoaded = false;
            function loadLedgerTab(page) {
                fetch(`/Purchases/LedgerTab/${invoiceId}?pageNumber=${page}`)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('ledgerTabContainer').innerHTML = html;
                    })
                    .catch(err => {
                        document.getElementById('ledgerTabContainer').innerHTML = '<div class="alert alert-danger">Failed to load ledger.</div>';
                    });
            }

            loadPaymentsTab(1);

            document.getElementById('ledger-tab').addEventListener('shown.bs.tab', function () {
                if (!ledgerLoaded) {
                    loadLedgerTab(1);
                    ledgerLoaded = true;
                }
            });
        });
    </script>
}
