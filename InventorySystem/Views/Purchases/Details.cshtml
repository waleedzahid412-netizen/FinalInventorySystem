@model InventorySystem.ViewModels.Purchases.PurchaseDetailsViewModel

@{
    ViewData["Title"] = $"Purchase Invoice - {Model.Header.InvoiceNumber}";
    var header = Model.Header;
    var financial = Model.Financial;
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Purchasing</a></li>
                    <li class="breadcrumb-item active">Invoice Details</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>Invoice #@header.InvoiceNumber
            </h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Returns" asp-action="ProcessPurchaseReturn" asp-route-invoiceId="@header.PurchaseInvoiceID" class="btn btn-primary shadow-sm">
                <i class="bi bi-box-arrow-left me-1"></i> Process Return
            </a>
            @if (!Model.IsLocked)
            {
                <a asp-action="Edit" asp-route-id="@header.PurchaseInvoiceID" class="btn btn-warning shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit Invoice
                </a>
            }
            else
            {
                <span class="badge bg-secondary d-flex align-items-center px-3"><i class="bi bi-lock-fill me-1"></i> Financial Lock</span>
            }
            @if (financial.Outstanding > 0)
            {
                <button type="button" class="btn btn-success shadow-sm" id="btnOpenCompanyPaymentModal">
                    <i class="bi bi-cash-stack me-1"></i> Record Company Payment
                </button>
            }
            <a asp-action="DownloadPdf" asp-route-id="@header.PurchaseInvoiceID" class="btn btn-danger shadow-sm" target="_blank">
                <i class="bi bi-file-earmark-pdf me-1"></i> Download PDF
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Invoices
            </a>
        </div>
    </div>

    <!-- Locked Banner if Payments Exist -->
    <div id="lockedCompanyInvoiceBanner" class="alert alert-warning border-warning d-flex align-items-center mb-4 @(Model.IsLocked ? "" : "d-none")" role="alert">
        <i class="bi bi-lock-fill fs-4 me-3 text-warning"></i>
        <div>
            <strong>🔒 Invoice Locked:</strong> Company payments have been recorded against this purchase invoice. Historical financial transactions are permanently immutable.
        </div>
    </div>

    <!-- Financial KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-bold text-uppercase">Grand Total</div>
                    <div class="fs-3 fw-bold mt-1" id="kpiCompanyGrandTotal">PKR @financial.GrandTotal.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-bold text-uppercase">Paid Amount</div>
                    <div class="fs-3 fw-bold mt-1" id="kpiCompanyPaidAmount">PKR @financial.PaidAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm @(financial.Outstanding > 0 ? "bg-danger text-white" : "bg-light text-dark")" id="kpiCompanyOutstandingCard">
                <div class="card-body p-3">
                    <div class="small fw-bold text-uppercase" id="kpiCompanyOutstandingLabel">Outstanding Payable</div>
                    <div class="fs-3 fw-bold mt-1" id="kpiCompanyOutstanding">PKR @financial.Outstanding.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Header Details Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 text-primary fw-semibold"><i class="bi bi-info-circle me-2"></i>Invoice Information</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold">Company (Supplier)</div>
                    <div class="fw-bold fs-6">@header.CompanyName</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold">Destination Warehouse</div>
                    <div><span class="badge bg-light text-dark border fs-6">@header.WarehouseName</span></div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold">Purchase Date</div>
                    <div class="fw-semibold">@header.InvoiceDate.ToString("dd MMMM yyyy")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold">Payment Status</div>
                    <div id="kpiCompanyPaymentStatus">
                        @if (header.PaymentStatus == "PAID")
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>PAID</span>
                        }
                        else if (header.PaymentStatus == "PARTIAL")
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>PARTIAL</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>UNPAID</span>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold">Created By</div>
                    <div>@header.CreatedByName</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small fw-semibold">Created Timestamp</div>
                    <div>@header.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Purchased Line Items Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 text-primary fw-semibold"><i class="bi bi-box-seam me-2"></i>Purchased Line Items</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Product Name</th>
                            <th>SKU</th>
                            <th>Packaging Unit</th>
                            <th class="text-center">Purchased Qty</th>
                            <th class="text-center">Converted Base Qty</th>
                            <th class="text-end">Unit Cost</th>
                            <th class="text-end pe-3">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            int index = 1;
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@index</td>
                                    <td class="fw-bold">@item.ProductName</td>
                                    <td><code>@item.SKU</code></td>
                                    <td><span class="badge bg-secondary">@item.UnitName</span></td>
                                    <td class="text-center fw-semibold">@item.Quantity.ToString("G29")</td>
                                    <td class="text-center text-primary fw-bold">
                                        @item.ConvertedQuantity.ToString("G29") @item.BaseUnitName
                                    </td>
                                    <td class="text-end">PKR @item.UnitCost.ToString("N2")</td>
                                    <td class="text-end pe-3 fw-bold">PKR @item.TotalCost.ToString("N2")</td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="7" class="text-end fw-bold">Grand Total:</td>
                            <td class="text-end pe-3 fs-6 fw-bold text-primary">PKR @financial.GrandTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Asynchronous Financial History Tabs (AD-7) -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white pb-0">
            <ul class="nav nav-tabs card-header-tabs" id="purchaseTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="payments-tab" data-bs-toggle="tab" data-bs-target="#payments" type="button" role="tab">
                        <i class="bi bi-cash-coin me-1"></i> Payment History
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="ledger-tab" data-bs-toggle="tab" data-bs-target="#ledger" type="button" role="tab">
                        <i class="bi bi-journal-text me-1"></i> Company Ledger
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-3">
            <div class="tab-content" id="purchaseTabsContent">
                <div class="tab-pane fade show active" id="payments" role="tabpanel">
                    <div id="paymentsTabContainer">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted small mt-2">Loading payment history...</p>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="ledger" role="tabpanel">
                    <div id="ledgerTabContainer">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted small mt-2">Loading ledger entries...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Record Company Payment Modal -->
<div class="modal fade" id="recordCompanyPaymentModal" tabindex="-1" aria-labelledby="recordCompanyPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title h6" id="recordCompanyPaymentModalLabel"><i class="bi bi-cash-stack me-2"></i> Record Company Payment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="recordCompanyPaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="payCompanyPurchaseInvoiceID" value="@header.PurchaseInvoiceID" />
                <input type="hidden" id="payCompanyCompanyID" value="@header.CompanyID" />

                <div class="modal-body py-3">
                    <div class="alert alert-light border small mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Target Invoice:</span>
                            <strong class="text-dark">#@header.InvoiceNumber</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Company (Supplier):</span>
                            <strong class="text-dark">@header.CompanyName</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Grand Total:</span>
                            <span class="fw-semibold">PKR @financial.GrandTotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Already Paid:</span>
                            <span class="fw-semibold text-success" id="payCompanyModalAlreadyPaid">PKR @financial.PaidAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Outstanding Balance:</span>
                            <strong class="text-danger" id="payCompanyModalOutstanding">PKR @financial.Outstanding.ToString("N2")</strong>
                        </div>
                    </div>

                    <div id="companyPaymentModalAlert" class="alert alert-danger p-2 small d-none mb-3"></div>

                    <div class="mb-3">
                        <label for="payCompanyAmount" class="form-label fw-semibold">Payment Amount (PKR) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control form-control-lg fw-bold text-success" id="payCompanyAmount" value="@financial.Outstanding.ToString("F2")" required />
                        <div class="form-text small">Must not exceed outstanding balance.</div>
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyMethod" class="form-label fw-semibold">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="payCompanyMethod" required>
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <!-- Cheque Specific Fields -->
                    <div id="detailsCompanyChequeFields" class="p-3 bg-light rounded border mb-3 d-none">
                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-card-heading me-1 text-primary"></i> Cheque Details</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label for="payCompanyChequeNumber" class="form-label small fw-semibold">Cheque Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="payCompanyChequeNumber" placeholder="e.g. CHQ-771122" />
                            </div>
                            <div class="col-md-6">
                                <label for="payCompanyBankName" class="form-label small fw-semibold">Bank Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="payCompanyBankName" placeholder="e.g. Allied Bank" />
                            </div>
                            <div class="col-md-6">
                                <label for="payCompanyIssueDate" class="form-label small fw-semibold">Issue Date</label>
                                <input type="date" class="form-control form-control-sm" id="payCompanyIssueDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label for="payCompanyChequeDate" class="form-label small fw-semibold">Cheque Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control form-control-sm" id="payCompanyChequeDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyReference" class="form-label fw-semibold">Reference Number</label>
                        <input type="text" class="form-control" id="payCompanyReference" placeholder="e.g. Bank Transfer Ref / Voucher #" />
                        <div class="form-text small text-info d-none" id="refCompanyRequiredHelp">Reference number is required for Bank payments.</div>
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyDate" class="form-label fw-semibold">Payment Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="payCompanyDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label for="payCompanyRemarks" class="form-label fw-semibold">Remarks / Notes</label>
                        <input type="text" class="form-control" id="payCompanyRemarks" placeholder="Optional payment notes" />
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success px-4" id="btnSubmitCompanyPayment">
                        <span id="payCompanySpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                        <i id="payCompanyIcon" class="bi bi-check-circle me-1"></i> Save Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const invoiceId = @header.PurchaseInvoiceID;
            let currentOutstanding = @financial.Outstanding;
            let currentPaid = @financial.PaidAmount;
            const grandTotal = @financial.GrandTotal;

            const paymentModal = new bootstrap.Modal(document.getElementById('recordCompanyPaymentModal'));
            const btnOpenModal = document.getElementById('btnOpenCompanyPaymentModal');

            if (btnOpenModal) {
                btnOpenModal.addEventListener('click', function () {
                    document.getElementById('payCompanyAmount').value = currentOutstanding.toFixed(2);
                    document.getElementById('companyPaymentModalAlert').classList.add('d-none');
                    paymentModal.show();
                });
            }

            const payMethodSelect = document.getElementById('payCompanyMethod');
            const refRequiredHelp = document.getElementById('refCompanyRequiredHelp');
            const detailsChequeFields = document.getElementById('detailsCompanyChequeFields');

            payMethodSelect.addEventListener('change', function () {
                if (this.value === 'Cheque') {
                    detailsChequeFields.classList.remove('d-none');
                    refRequiredHelp.classList.add('d-none');
                } else if (this.value === 'Bank') {
                    detailsChequeFields.classList.add('d-none');
                    refRequiredHelp.classList.remove('d-none');
                } else {
                    detailsChequeFields.classList.add('d-none');
                    refRequiredHelp.classList.add('d-none');
                }
            });

            // Submit Payment AJAX
            document.getElementById('btnSubmitCompanyPayment').addEventListener('click', function () {
                const alertBox = document.getElementById('companyPaymentModalAlert');
                alertBox.classList.add('d-none');

                const amount = parseFloat(document.getElementById('payCompanyAmount').value) || 0;
                const method = document.getElementById('payCompanyMethod').value;
                const reference = document.getElementById('payCompanyReference').value;
                const payDate = document.getElementById('payCompanyDate').value;
                const remarks = document.getElementById('payCompanyRemarks').value;

                const chqNum = document.getElementById('payCompanyChequeNumber').value;
                const bankName = document.getElementById('payCompanyBankName').value;
                const issueDate = document.getElementById('payCompanyIssueDate').value;
                const chequeDate = document.getElementById('payCompanyChequeDate').value;

                if (amount <= 0) {
                    alertBox.textContent = 'Payment amount must be greater than zero.';
                    alertBox.classList.remove('d-none');
                    return;
                }

                if (amount > currentOutstanding + 0.001) {
                    alertBox.textContent = `Payment cannot exceed outstanding balance (PKR ${currentOutstanding.toFixed(2)}).`;
                    alertBox.classList.remove('d-none');
                    return;
                }

                if (method === 'Cheque') {
                    if (!chqNum.trim()) {
                        alertBox.textContent = 'Cheque Number is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (!bankName.trim()) {
                        alertBox.textContent = 'Bank Name is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (!chequeDate) {
                        alertBox.textContent = 'Cheque Date is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                } else if (method === 'Bank' && !reference.trim()) {
                    alertBox.textContent = 'Reference Number is required for Bank payments.';
                    alertBox.classList.remove('d-none');
                    return;
                }

                const payload = {
                    PurchaseInvoiceID: invoiceId,
                    CompanyID: parseInt(document.getElementById('payCompanyCompanyID').value),
                    Amount: amount,
                    PaymentMethod: method,
                    ReferenceNumber: reference,
                    PaymentDate: payDate,
                    Remarks: remarks,
                    ChequeNumber: chqNum,
                    BankName: bankName,
                    IssueDate: issueDate || null,
                    ChequeDate: chequeDate || null
                };

                const token = document.querySelector('#recordCompanyPaymentForm input[name="__RequestVerificationToken"]').value;

                const btn = this;
                btn.disabled = true;
                document.getElementById('payCompanySpinner').classList.remove('d-none');
                document.getElementById('payCompanyIcon').classList.add('d-none');

                fetch('/Payments/RecordCompanyPayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                })
                .then(res => res.json())
                .then(data => {
                    btn.disabled = false;
                    document.getElementById('payCompanySpinner').classList.add('d-none');
                    document.getElementById('payCompanyIcon').classList.remove('d-none');

                    if (data.success) {
                        paymentModal.hide();

                        currentPaid += amount;
                        currentOutstanding = Math.max(0, grandTotal - currentPaid);

                        document.getElementById('kpiCompanyPaidAmount').textContent = 'PKR ' + currentPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('kpiCompanyOutstanding').textContent = 'PKR ' + currentOutstanding.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('payCompanyModalAlreadyPaid').textContent = 'PKR ' + currentPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('payCompanyModalOutstanding').textContent = 'PKR ' + currentOutstanding.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                        const statusElem = document.getElementById('kpiCompanyPaymentStatus');
                        if (currentOutstanding <= 0.001) {
                            statusElem.innerHTML = '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>PAID</span>';
                            if (btnOpenModal) btnOpenModal.classList.add('d-none');
                        } else {
                            statusElem.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>PARTIAL</span>';
                        }

                        document.getElementById('lockedCompanyInvoiceBanner').classList.remove('d-none');

                        loadPaymentsTab(1);
                        if (ledgerLoaded) loadLedgerTab(1);
                    } else {
                        alertBox.textContent = data.message || 'Failed to record payment.';
                        alertBox.classList.remove('d-none');
                    }
                })
                .catch(err => {
                    btn.disabled = false;
                    document.getElementById('payCompanySpinner').classList.add('d-none');
                    document.getElementById('payCompanyIcon').classList.remove('d-none');
                    alertBox.textContent = 'An error occurred while saving payment.';
                    alertBox.classList.remove('d-none');
                });
            });

            // Load Payment History Tab
            function loadPaymentsTab(page) {
                fetch(`/Payments/GetCompanyPaymentHistoryPartial?invoiceId=${invoiceId}`)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('paymentsTabContainer').innerHTML = html;
                    })
                    .catch(err => {
                        document.getElementById('paymentsTabContainer').innerHTML = '<div class="alert alert-danger">Failed to load payments.</div>';
                    });
            }

            let ledgerLoaded = false;
            function loadLedgerTab(page) {
                fetch(`/Purchases/LedgerTab/${invoiceId}?pageNumber=${page}`)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('ledgerTabContainer').innerHTML = html;
                    })
                    .catch(err => {
                        document.getElementById('ledgerTabContainer').innerHTML = '<div class="alert alert-danger">Failed to load ledger.</div>';
                    });
            }

            loadPaymentsTab(1);

            document.getElementById('ledger-tab').addEventListener('shown.bs.tab', function () {
                if (!ledgerLoaded) {
                    loadLedgerTab(1);
                    ledgerLoaded = true;
                }
            });
        });
    </script>
}
