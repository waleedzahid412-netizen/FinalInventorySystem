@model InventorySystem.ViewModels.Home.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var userName = User.Identity?.Name ?? "there";
}

<div class="dash">
    <!-- Page header -->
    <div class="dash-hero">
        <div>
            <div class="dash-eyebrow"><i class="bi bi-grid-1x2"></i> Dashboard</div>
            <h1 class="dash-title">@greeting, @userName</h1>
            <p class="dash-subtitle">
                Your wholesale ops at a glance — sales, stock, and cash flow.
            </p>
            @if (Model.ShowAllCompanies)
            {
                <span class="dash-scope"><i class="bi bi-buildings"></i> All companies</span>
            }
            else if (Model.HasCompanyScope)
            {
                <span class="dash-scope"><i class="bi bi-building"></i> @Model.ScopedCompanyName</span>
            }
        </div>
        <div class="dash-actions">
            <a asp-controller="Sales" asp-action="Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i> New sale
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </a>
        </div>
    </div>

    <!-- Priority alert -->
    @if (Model.LowStockCount > 0)
    {
        <div class="dash-alert" role="status">
            <div>
                <strong>@Model.LowStockCount product@(Model.LowStockCount == 1 ? "" : "s") below reorder level.</strong>
                <span class="d-block small mt-1 opacity-75">Restock soon to avoid stockouts on active sales routes.</span>
            </div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-danger">Review stock</a>
        </div>
    }

    <!-- KPI grid -->
    <div class="dash-kpi-grid">
        <a asp-controller="Sales" asp-action="Index" class="kpi kpi--sales">
            <div class="kpi-top">
                <span class="kpi-label">Sales this month</span>
                <span class="kpi-icon"><i class="bi bi-receipt"></i></span>
            </div>
            <p class="kpi-value">@Model.TotalSalesThisMonth.ToString("C2")</p>
            <div class="kpi-meta">Today <strong>@Model.TotalSalesToday.ToString("C2")</strong></div>
        </a>

        <a asp-controller="Purchases" asp-action="Index" class="kpi kpi--purchases">
            <div class="kpi-top">
                <span class="kpi-label">Purchases this month</span>
                <span class="kpi-icon"><i class="bi bi-cart-check"></i></span>
            </div>
            <p class="kpi-value">@Model.TotalPurchasesThisMonth.ToString("C2")</p>
            <div class="kpi-meta">Today <strong>@Model.TotalPurchasesToday.ToString("C2")</strong></div>
        </a>

        <a asp-controller="Customers" asp-action="Index" class="kpi kpi--receivables">
            <div class="kpi-top">
                <span class="kpi-label">Customer receivables</span>
                <span class="kpi-icon"><i class="bi bi-wallet2"></i></span>
            </div>
            <p class="kpi-value">@Model.CustomerReceivables.ToString("C2")</p>
            <div class="kpi-meta">Outstanding customer balances</div>
        </a>

        @if (Model.HasCompanyScope && !Model.ShowAllCompanies)
        {
            <a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.ScopedCompanyId" class="kpi kpi--payables">
                <div class="kpi-top">
                    <span class="kpi-label">Supplier payables</span>
                    <span class="kpi-icon"><i class="bi bi-credit-card"></i></span>
                </div>
                <p class="kpi-value">@Model.SupplierPayables.ToString("C2")</p>
                <div class="kpi-meta">Outstanding supplier debts</div>
            </a>
        }
        else
        {
            <a asp-controller="Companies" asp-action="Index" class="kpi kpi--payables">
                <div class="kpi-top">
                    <span class="kpi-label">Supplier payables</span>
                    <span class="kpi-icon"><i class="bi bi-credit-card"></i></span>
                </div>
                <p class="kpi-value">@Model.SupplierPayables.ToString("C2")</p>
                <div class="kpi-meta">Outstanding supplier debts</div>
            </a>
        }

        <a asp-controller="Products" asp-action="Index" class="kpi kpi-wide kpi--inventory">
            <div class="kpi-top">
                <span class="kpi-label">Inventory value</span>
                <span class="kpi-icon"><i class="bi bi-box-seam"></i></span>
            </div>
            <p class="kpi-value">@Model.InventoryValue.ToString("C2")</p>
            <div class="kpi-meta">Base-unit stock at average cost</div>
        </a>

        <a asp-controller="Products" asp-action="Index" class="kpi kpi-wide kpi--lowstock @(Model.LowStockCount == 0 ? "is-ok" : "")">
            <div class="kpi-top">
                <span class="kpi-label">Low stock items</span>
                <span class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></span>
            </div>
            <p class="kpi-value">@Model.LowStockCount</p>
            <div class="kpi-meta">
                @if (Model.LowStockCount > 0)
                {
                    <span class="status-pill alert">Action needed</span>
                }
                else
                {
                    <span class="status-pill ok">Healthy</span>
                }
            </div>
        </a>

        <a asp-controller="Returns" asp-action="CustomerReturns" class="kpi kpi-wide kpi--returns">
            <div class="kpi-top">
                <span class="kpi-label">Returns today</span>
                <span class="kpi-icon"><i class="bi bi-arrow-return-left"></i></span>
            </div>
            <p class="kpi-value">@Model.TodayReturnsCount</p>
            <div class="kpi-meta">Sales returns recorded today</div>
        </a>
    </div>

    <!-- Activity tables -->
    <div class="dash-split">
        <section class="dash-panel mb-0" aria-labelledby="dash-recent-sales">
            <div class="dash-panel-head">
                <h2 id="dash-recent-sales" class="dash-panel-title">
                    <i class="bi bi-clock-history"></i> Recent sales
                </h2>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <div class="dash-panel-body flush">
                @if (Model.RecentSales != null && Model.RecentSales.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in Model.RecentSales)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.InvoiceID" class="invoice-link">
                                                @sale.InvoiceNumber
                                            </a>
                                        </td>
                                        <td>@sale.CustomerName</td>
                                        <td>@sale.InvoiceDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end"><span class="money pos">@sale.TotalAmount.ToString("C2")</span></td>
                                        <td class="text-center">
                                            <span class="status-pill @(sale.PaymentStatus == "PAID" ? "paid" : sale.PaymentStatus == "PARTIAL" ? "partial" : "unpaid")">
                                                @sale.PaymentStatus
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon"><i class="bi bi-receipt"></i></div>
                        <strong>No sales yet</strong>
                        <p>Create your first sales invoice to see activity here.</p>
                    </div>
                }
            </div>
        </section>

        <section class="dash-panel mb-0" aria-labelledby="dash-recent-purchases">
            <div class="dash-panel-head">
                <h2 id="dash-recent-purchases" class="dash-panel-title">
                    <i class="bi bi-cart-check"></i> Recent purchases
                </h2>
                <a asp-controller="Purchases" asp-action="Index" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <div class="dash-panel-body flush">
                @if (Model.RecentPurchases != null && Model.RecentPurchases.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    <th>Supplier</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pur in Model.RecentPurchases)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Purchases" asp-action="Details" asp-route-id="@pur.InvoiceID" class="invoice-link">
                                                @pur.InvoiceNumber
                                            </a>
                                        </td>
                                        <td>@pur.SupplierName</td>
                                        <td>@pur.InvoiceDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-end"><span class="money">@pur.TotalAmount.ToString("C2")</span></td>
                                        <td class="text-center">
                                            <span class="status-pill @(pur.PaymentStatus == "PAID" ? "paid" : pur.PaymentStatus == "PARTIAL" ? "partial" : "unpaid")">
                                                @pur.PaymentStatus
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon"><i class="bi bi-cart"></i></div>
                        <strong>No purchases yet</strong>
                        <p>Record a purchase invoice when stock arrives.</p>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="dash-split">
        <section class="dash-panel mb-0" aria-labelledby="dash-recent-returns">
            <div class="dash-panel-head">
                <h2 id="dash-recent-returns" class="dash-panel-title">
                    <i class="bi bi-arrow-return-left"></i> Recent returns
                </h2>
                <a asp-controller="Returns" asp-action="CustomerReturns" class="btn btn-sm btn-outline-secondary">View all</a>
            </div>
            <div class="dash-panel-body flush">
                @if (Model.RecentReturns != null && Model.RecentReturns.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Return</th>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th class="text-center">Type</th>
                                    <th class="text-end">Refund</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ret in Model.RecentReturns)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Returns" asp-action="SalesReturnDetails" asp-route-id="@ret.SalesReturnID" class="invoice-link">
                                                @ret.ReturnNumber
                                            </a>
                                        </td>
                                        <td>@ret.CustomerName</td>
                                        <td>@ret.ReturnDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-center">
                                            <span class="status-pill @(ret.ReturnType == "MANUAL" ? "partial" : "neutral")">
                                                @ret.ReturnType
                                            </span>
                                        </td>
                                        <td class="text-end"><span class="money neg">@ret.NetRefundAmount.ToString("C2")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon"><i class="bi bi-check2-circle"></i></div>
                        <strong>No recent returns</strong>
                        <p>Customer returns will appear here when processed.</p>
                    </div>
                }
            </div>
        </section>

        <section class="dash-panel mb-0" aria-labelledby="dash-low-stock">
            <div class="dash-panel-head">
                <h2 id="dash-low-stock" class="dash-panel-title">
                    <i class="bi bi-exclamation-triangle"></i> Low stock alerts
                </h2>
                <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-secondary">Manage products</a>
            </div>
            <div class="dash-panel-body flush">
                @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>SKU</th>
                                    <th class="text-center">On hand</th>
                                    <th class="text-center">Min</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in Model.LowStockProducts)
                                {
                                    <tr>
                                        <td class="fw-semibold">@prod.ProductName</td>
                                        <td class="small text-muted">@prod.SKU</td>
                                        <td class="text-center"><span class="money neg">@prod.CurrentStock.ToString("N2")</span></td>
                                        <td class="text-center">@prod.MinStockLevel.ToString("N2")</td>
                                        <td class="text-center"><span class="status-pill alert">Low</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="dash-empty">
                        <div class="dash-empty-icon" style="background: var(--erp-success-soft); color: var(--erp-success);">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <strong>Stock looks healthy</strong>
                        <p>No products are at or below their minimum level.</p>
                    </div>
                }
            </div>
        </section>
    </div>

    <p class="dash-footer-note mb-0">Amounts update when invoices and payments are finalized. Inventory is valued in base units.</p>
</div>
