@model InventorySystem.DTOs.Common.PagedResult<InventorySystem.DTOs.Sales.SalesPaymentHistoryDto>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Payment #</th>
                <th>Payment Date</th>
                <th>Payment Method</th>
                <th>Reference #</th>
                <th class="text-end">Amount Paid</th>
                <th>Recorded By</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-bold">@item.PaymentNumber</td>
                        <td>@item.PaymentDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge bg-secondary">@item.PaymentMethod</span></td>
                        <td>@(item.ReferenceNumber ?? "-")</td>
                        <td class="text-end fw-bold text-success">PKR @item.Amount.ToString("N2")</td>
                        <td>@item.CreatedByUserName</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        <i class="bi bi-wallet2 fs-3 d-block mb-2"></i>
                        No payments recorded for this sales invoice.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="small text-muted">Page @Model.PageNumber of @Model.TotalPages</span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <button class="page-link payment-page-btn" data-page="@(Model.PageNumber - 1)">Previous</button>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <button class="page-link payment-page-btn" data-page="@i">@i</button>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <button class="page-link payment-page-btn" data-page="@(Model.PageNumber + 1)">Next</button>
                </li>
            </ul>
        </nav>
    </div>
}
