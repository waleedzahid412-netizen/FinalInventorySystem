@model InventorySystem.ViewModels.Sales.CreateSalesViewModel
@{
    ViewData["Title"] = "Quick Create Sale";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold"><i class="bi bi-receipt text-primary me-2"></i> Quick Create Sales Invoice</h1>
            <p class="text-muted small mb-0">Fast POS-style sales entry for counter sales and direct deliveries.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Sales List
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" id="quickSaleForm">
        @Html.AntiForgeryToken()

        <!-- STICKY TOP CUSTOMER & HEADER SELECTION -->
        <div class="card shadow-sm border-0 mb-4 sticky-top bg-white" style="top: 60px; z-index: 900;">
            <div class="card-body py-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="CustomerID" class="form-label fw-bold small">Customer <span class="text-danger">*</span></label>
                        <select asp-for="CustomerID" asp-items="Model.Customers" class="form-select" required>
                            <option value="">-- Select Customer --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WarehouseID" class="form-label fw-bold small">Source Warehouse <span class="text-danger">*</span></label>
                        <select asp-for="WarehouseID" asp-items="Model.Warehouses" class="form-select" required>
                            <option value="">-- Select Warehouse --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DeliveryPersonID" class="form-label fw-bold small">Delivery Agent</label>
                        <select asp-for="DeliveryPersonID" asp-items="Model.DeliveryPersons" class="form-select">
                            <option value="">-- Direct Counter Sale --</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- LEFT SECTION: PRODUCT SEARCH & CART TABLE -->
            <div class="col-lg-8">
                <!-- PRODUCT SEARCH CARD -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-search me-2"></i> Add Product Line</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">Select Product</label>
                                <select id="selectQuickProduct" class="form-select">
                                    <option value="">-- Search / Select Product --</option>
                                    @foreach (var p in Model.Products)
                                    {
                                        <option value="@p.Value">@p.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Packaging Unit</label>
                                <select id="selectQuickUnit" class="form-select" disabled>
                                    <option value="">-- Select Unit --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Qty</label>
                                <input type="number" id="inputQuickQty" min="1" step="any" class="form-control text-center" value="1" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" id="btnAddQuickLine" class="btn btn-primary w-100 fw-bold">
                                    <i class="bi bi-plus-lg me-1"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CART TABLE CARD -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-cart3 me-2"></i> Order Items Cart</h6>
                        <span class="badge bg-secondary" id="cartItemCount">0 Items</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table id="quickCartTable" class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Unit</th>
                                        <th style="width: 15%;" class="text-center">Qty</th>
                                        <th style="width: 18%;" class="text-end">Unit Price ($)</th>
                                        <th style="width: 18%;" class="text-end">Total ($)</th>
                                        <th style="width: 5%;" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr id="emptyCartRow">
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="bi bi-cart-x display-6 d-block mb-2"></i> Your order cart is empty. Select products above to build sale.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT SECTION: TOTALS & PAYMENT SETTLEMENT -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 140px;">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="card-title mb-0 fw-bold"><i class="bi bi-calculator me-2"></i> Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Sub Total:</span>
                            <span class="fw-bold" id="lblSubTotal">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span class="text-muted">Discount:</span>
                            <span class="fw-bold" id="lblDiscount">$0.00</span>
                        </div>

                        <hr />

                        <div class="p-3 bg-light rounded border mb-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold fs-6">GRAND TOTAL:</span>
                                <span class="fw-bold fs-3 text-success" id="lblGrandTotal">$0.00</span>
                            </div>
                        </div>

                        <!-- PAYMENT METHOD SELECTION -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small">Initial Payment Method</label>
                            <div class="form-check p-2 border rounded bg-light mb-2">
                                <input class="form-check-input ms-1" type="radio" name="PaymentMethod" id="payCash" value="CASH" checked>
                                <label class="form-check-label fw-bold ms-2" for="payCash">
                                    <i class="bi bi-cash-stack text-success me-1"></i> Paid in Full (Cash)
                                </label>
                            </div>
                            <div class="form-check p-2 border rounded bg-light">
                                <input class="form-check-input ms-1" type="radio" name="PaymentMethod" id="payCredit" value="CREDIT">
                                <label class="form-check-label fw-bold ms-2" for="payCredit">
                                    <i class="bi bi-person-badge text-primary me-1"></i> Credit / On Account
                                </label>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">
                                <i class="bi bi-check-circle-fill me-2"></i> Finalize Sales Invoice
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let lineIdx = 0;
            let currentFetchedPrice = 0.00;

            $('#selectQuickProduct').on('change', function () {
                const prodId = $(this).val();
                const $unit = $('#selectQuickUnit').empty().append('<option value="">Loading...</option>').prop('disabled', true);
                currentFetchedPrice = 0.00;

                if (prodId) {
                    $.getJSON('/Sales/GetProductUnits', { productId: prodId }, function (units) {
                        $unit.empty();
                        if (units && units.length > 0) {
                            units.forEach(u => {
                                const uid = u.productUnitId || u.productUnitID || u.id;
                                const uname = u.unitName || u.name || 'Unit';
                                $unit.append(`<option value="${uid}">${uname}</option>`);
                            });
                            $unit.prop('disabled', false).trigger('change');
                        } else {
                            $unit.append('<option value="">No Units Available</option>');
                        }
                    }).fail(function () {
                        $unit.empty().append('<option value="">Error loading units</option>');
                    });
                }
            });

            $('#selectQuickUnit').on('change', function () {
                const prodId = $('#selectQuickProduct').val();
                const unitId = $(this).val();
                if (prodId && unitId) {
                    $.getJSON('/Sales/GetProductUnitPrice', { productId: prodId, productUnitId: unitId }, function (res) {
                        if (res && res.price !== undefined) {
                            currentFetchedPrice = parseFloat(res.price) || 0.00;
                        }
                    }).fail(function () {
                        currentFetchedPrice = 0.00;
                    });
                }
            });

            $('#btnAddQuickLine').on('click', function () {
                const prodId = $('#selectQuickProduct').val();
                const prodText = $('#selectQuickProduct option:selected').text();
                const unitId = $('#selectQuickUnit').val();
                const unitText = $('#selectQuickUnit option:selected').text();
                const qty = parseFloat($('#inputQuickQty').val()) || 1;
                const unitPrice = currentFetchedPrice;

                if (!prodId || !unitId || qty <= 0) {
                    alert('Please select a valid product, unit, and quantity.');
                    return;
                }

                $('#emptyCartRow').remove();

                const rowHtml = `
                    <tr class="cart-row">
                        <td>
                            <input type="hidden" name="Items[${lineIdx}].ProductID" value="${prodId}" />
                            <span class="fw-bold">${prodText}</span>
                        </td>
                        <td>
                            <input type="hidden" name="Items[${lineIdx}].ProductUnitID" value="${unitId}" />
                            <span>${unitText}</span>
                        </td>
                        <td class="text-center">
                            <input type="number" name="Items[${lineIdx}].Quantity" min="0.001" step="any" class="form-control form-control-sm text-center input-qty" value="${qty}" />
                        </td>
                        <td>
                            <input type="number" name="Items[${lineIdx}].UnitPrice" min="0" step="0.01" class="form-control form-control-sm text-end input-price" value="${unitPrice.toFixed(2)}" />
                        </td>
                        <td class="text-end fw-bold line-total">$${(qty * unitPrice).toFixed(2)}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-cart" title="Remove"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                `;
                $('#quickCartTable tbody').append(rowHtml);
                lineIdx++;
                recalcCart();
            });

            function recalcCart() {
                let subtotal = 0;
                let count = 0;
                $('#quickCartTable tbody tr.cart-row').each(function () {
                    const q = parseFloat($(this).find('.input-qty').val()) || 0;
                    const p = parseFloat($(this).find('.input-price').val()) || 0;
                    const tot = Math.round(q * p * 100) / 100;
                    $(this).find('.line-total').text('$' + tot.toFixed(2));
                    subtotal += tot;
                    count++;
                });

                $('#lblSubTotal').text('$' + subtotal.toFixed(2));
                $('#lblGrandTotal').text('$' + subtotal.toFixed(2));
                $('#cartItemCount').text(`${count} Items`);
            }

            $(document).on('input change', '.input-qty, .input-price', function () { recalcCart(); });
            $(document).on('click', '.btn-remove-cart', function () { $(this).closest('tr').remove(); recalcCart(); });
        });
    </script>
}
