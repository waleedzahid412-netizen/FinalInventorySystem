@model InventorySystem.ViewModels.Sales.SalesDetailsViewModel
@using InventorySystem.Constants
@{
    ViewData["Title"] = $"Sales Invoice #{Model.Details.Header.InvoiceNumber}";
    var header = Model.Details.Header;
    var canProcessReturn = PermCtx.CanView(PageKeys.SalesCreateReturn) || PermCtx.CanAdd(PageKeys.SalesCreateReturn);
    var canRecordPayment = PermCtx.CanAdd(PageKeys.CustomerPayments);
    var canEditInvoice = PermCtx.CanEdit(PageKeys.SalesInvoices);
}

@section Styles {
    <link rel="stylesheet" href="~/css/sales-details.css" asp-append-version="true" />
}

<div class="container-fluid px-4 py-4 sales-details-page">
    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-start mb-4 sd-page-header">
        <div class="sd-breadcrumb">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Sales Invoices</a></li>
                    <li class="breadcrumb-item active">@header.InvoiceNumber</li>
                </ol>
            </nav>
            <h1 class="sd-page-title">Invoice #@header.InvoiceNumber</h1>
            <p class="sd-page-subtitle mb-0">@header.CustomerName · @header.InvoiceDate.ToString("dd MMM yyyy")</p>
        </div>

        <div class="sd-toolbar">
            @if (header.OutstandingBalance > 0 && canRecordPayment)
            {
                <div class="sd-toolbar-group">
                    <button type="button" class="sd-btn sd-btn-primary" id="btnOpenPaymentModal">
                        <i class="bi bi-cash-stack"></i> Record Payment
                    </button>
                </div>
                <span class="sd-toolbar-divider" aria-hidden="true"></span>
            }

            <div class="sd-toolbar-group">
                @if (canProcessReturn)
                {
                    <a asp-controller="Returns" asp-action="ProcessSalesReturn" asp-route-invoiceId="@header.InvoiceID" class="sd-btn sd-btn-outline">
                        <i class="bi bi-arrow-return-left"></i> Process Return
                    </a>
                }
                @if (!Model.IsLocked && canEditInvoice)
                {
                    <a asp-action="Edit" asp-route-id="@header.InvoiceID" class="sd-btn sd-btn-outline">
                        <i class="bi bi-pencil-square"></i> Edit Invoice
                    </a>
                }
                else if (Model.IsLocked)
                {
                    <span class="sd-lock-badge"><i class="bi bi-lock-fill"></i> Financial Lock</span>
                }
            </div>

            <span class="sd-toolbar-divider" aria-hidden="true"></span>

            <div class="sd-toolbar-group">
                <a asp-action="DownloadPdf" asp-route-id="@header.InvoiceID" class="sd-btn sd-btn-outline" target="_blank">
                    <i class="bi bi-file-earmark-pdf"></i> Download PDF
                </a>
                <button type="button" class="sd-btn sd-btn-outline" onclick="window.print();">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>

            <span class="sd-toolbar-divider" aria-hidden="true"></span>

            <a asp-action="Index" class="sd-btn sd-btn-link">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Locked banner -->
    <div id="lockedInvoiceBanner" class="sd-lock-banner d-flex align-items-start gap-3 mb-4 @(Model.IsLocked ? "" : "d-none")" role="alert">
        <i class="bi bi-lock-fill flex-shrink-0 mt-1"></i>
        <div>
            <strong>Invoice locked.</strong> Payments have been recorded for this finalized sales invoice. It is permanently read-only per business rules (BR-017).
        </div>
    </div>

    <!-- Financial summary -->
    <div class="sd-kpi-grid mb-4">
        <div class="sd-kpi">
            <div class="sd-kpi-label">Grand Total</div>
            <div class="sd-kpi-value" id="kpiGrandTotal">PKR @header.GrandTotal.ToString("N2")</div>
        </div>
        <div class="sd-kpi">
            <div class="sd-kpi-label">Paid Amount</div>
            <div class="sd-kpi-value" id="kpiPaidAmount">PKR @header.PaidAmount.ToString("N2")</div>
        </div>
        @if (header.ReturnedAmount > 0)
        {
            <div class="sd-kpi">
                <div class="sd-kpi-label">Returned Credit</div>
                <div class="sd-kpi-value" id="kpiReturnedAmount">PKR @header.ReturnedAmount.ToString("N2")</div>
            </div>
        }
        <div class="sd-kpi">
            <div class="sd-kpi-label">Outstanding Balance</div>
            <div class="sd-kpi-value sd-kpi-value--emphasis" id="kpiOutstanding">PKR @header.OutstandingBalance.ToString("N2")</div>
        </div>
        <div class="sd-kpi">
            <div class="sd-kpi-label">Payment Status</div>
            <div id="kpiPaymentStatus">
                @if (header.PaymentStatus == "PAID")
                {
                    <span class="sd-status sd-status--paid"><i class="bi bi-check-circle"></i> Paid</span>
                }
                else if (header.PaymentStatus == "PARTIAL")
                {
                    <span class="sd-status sd-status--partial"><i class="bi bi-clock-history"></i> Partial</span>
                }
                else
                {
                    <span class="sd-status sd-status--unpaid"><i class="bi bi-circle"></i> Unpaid</span>
                }
            </div>
        </div>
    </div>

    <!-- Header details -->
    <div class="sd-section mb-4">
        <div class="sd-section-header">Invoice Details</div>
        <div class="sd-section-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="sd-field-label">Invoice Number</span>
                    <span class="sd-field-value sd-field-value--mono">@header.InvoiceNumber</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Invoice Date</span>
                    <span class="sd-field-value">@header.InvoiceDate.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Customer</span>
                    <span class="sd-field-value">@header.CustomerName</span>
                    @if (!string.IsNullOrWhiteSpace(header.ShopName))
                    {
                        <span class="sd-field-label mt-1">@header.ShopName</span>
                    }
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Destination Warehouse</span>
                    <span class="sd-field-value">@header.WarehouseName</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Supplier</span>
                    <span class="sd-field-value">@(header.SupplierName ?? "Unassigned")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(header.CompanyName))
                {
                    @* Legacy invoices only — suppliers are a product-level attribute, not an invoice header field. *@
                    <div class="col-md-3">
                        <span class="sd-field-label">Supplier (Legacy)</span>
                        <span class="sd-field-value">@header.CompanyName</span>
                    </div>
                }
                <div class="col-md-3">
                    <span class="sd-field-label">Booker</span>
                    <span class="sd-field-value">@(header.BookerName ?? "—")</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Salesperson</span>
                    <span class="sd-field-value">@(header.SalespersonName ?? "—")</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Area / SubArea</span>
                    <span class="sd-field-value">@(header.AreaName ?? "N/A") @(header.SubAreaName != null ? $"/ {header.SubAreaName}" : "")</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Created By</span>
                    <span class="sd-field-value">@header.CreatedByUserName</span>
                </div>
                <div class="col-md-3">
                    <span class="sd-field-label">Created At</span>
                    <span class="sd-field-value sd-field-value--mono">@header.CreatedAt.ToString("yyyy-MM-dd HH:mm UTC")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Line items -->
    <div class="sd-section mb-4">
        <div class="sd-section-header">Sold Line Items</div>
        <div class="sd-section-body sd-section-body--flush">
            <div class="table-responsive">
                <table class="table align-middle mb-0 sd-table">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>SKU</th>
                            <th class="text-center">Sold Unit</th>
                            <th class="text-end">Sold Qty</th>
                            <th class="text-end">Base Unit Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Details.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td><span class="sd-tag">@(item.SKU ?? "-")</span></td>
                                <td class="text-center"><span class="sd-unit-tag">@item.UnitName</span></td>
                                <td class="text-end">@item.Quantity.ToString("N2")</td>
                                <td class="text-end sd-field-value--mono">@item.ConvertedQuantity.ToString("N2") @item.BaseUnitName</td>
                                <td class="text-end">PKR @item.UnitPrice.ToString("N2")</td>
                                <td class="text-end">PKR @item.DiscountAmount.ToString("N2")</td>
                                <td class="text-end fw-semibold">PKR @item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="7" class="text-end fw-semibold">Subtotal</td>
                            <td class="text-end fw-semibold">PKR @Model.Details.Financial.SubTotal.ToString("N2")</td>
                        </tr>
                        @if (Model.Details.Financial.DiscountTotal > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end fw-semibold">Total Discount</td>
                                <td class="text-end fw-semibold">− PKR @Model.Details.Financial.DiscountTotal.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="7" class="text-end sd-grand-total">Grand Total</td>
                            <td class="text-end sd-grand-total">PKR @Model.Details.Financial.GrandTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Payment history & ledger tabs -->
    <div class="sd-section mb-5">
        <ul class="sd-tabs nav nav-tabs border-0" id="detailsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="sd-tab nav-link active border-0" id="payments-tab" data-bs-toggle="tab" data-bs-target="#payments-pane" type="button" role="tab">
                    Payment History
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="sd-tab nav-link border-0" id="ledger-tab" data-bs-toggle="tab" data-bs-target="#ledger-pane" type="button" role="tab">
                    Customer Ledger
                </button>
            </li>
        </ul>
        <div class="tab-content" id="detailsTabsContent">
            <div class="tab-pane fade show active sd-tab-pane" id="payments-pane" role="tabpanel">
                <div id="paymentHistoryTabContainer">
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Loading payment history...
                    </div>
                </div>
            </div>
            <div class="tab-pane fade sd-tab-pane" id="ledger-pane" role="tabpanel">
                <div id="ledgerTabContainer">
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Loading customer ledger...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Record Customer Payment Modal -->
@if (canRecordPayment)
{
<div class="modal fade" id="recordPaymentModal" tabindex="-1" aria-labelledby="recordPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content sd-modal-content border-0">
            <div class="modal-header sd-modal-header">
                <h5 class="modal-title" id="recordPaymentModalLabel">Record Customer Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="recordPaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="payInvoiceID" value="@header.InvoiceID" />
                <input type="hidden" id="payCustomerID" value="@header.CustomerID" />

                <div class="modal-body py-3">
                    <div class="sd-summary mb-3">
                        <div class="sd-summary-row">
                            <span class="text-muted">Target Invoice</span>
                            <strong>#@header.InvoiceNumber</strong>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Customer</span>
                            <strong>@header.CustomerName</strong>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Grand Total</span>
                            <span class="fw-semibold">PKR @header.GrandTotal.ToString("N2")</span>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Already Paid</span>
                            <span class="fw-semibold" id="payModalAlreadyPaid">PKR @header.PaidAmount.ToString("N2")</span>
                        </div>
                        <div class="sd-summary-row">
                            <span class="text-muted">Outstanding Balance</span>
                            <strong id="payModalOutstanding">PKR @header.OutstandingBalance.ToString("N2")</strong>
                        </div>
                    </div>

                    <div id="paymentModalAlert" class="alert alert-danger p-2 small d-none mb-3"></div>

                    <div class="mb-3">
                        <label for="payAmount" class="form-label fw-semibold small">Payment Amount (PKR) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0.01" class="form-control form-control-lg" id="payAmount" value="@header.OutstandingBalance.ToString("F2")" required />
                        <div class="form-text small">Must not exceed outstanding balance.</div>
                    </div>

                    <div class="mb-3">
                        <label for="payMethod" class="form-label fw-semibold small">Payment Method <span class="text-danger">*</span></label>
                        <select class="form-select" id="payMethod" required data-no-select2>
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <div id="detailsChequeFields" class="sd-cheque-panel mb-3 d-none">
                        <h6 class="fw-bold small mb-2">Cheque Details</h6>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label for="payChequeNumber" class="form-label small fw-semibold">Cheque Number <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="payChequeNumber" placeholder="e.g. CHQ-100234" />
                            </div>
                            <div class="col-md-6">
                                <label for="payBankName" class="form-label small fw-semibold">Bank Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm" id="payBankName" placeholder="e.g. MCB Bank" />
                            </div>
                            <div class="col-md-6">
                                <label for="payIssueDate" class="form-label small fw-semibold">Issue Date</label>
                                <input type="date" class="form-control form-control-sm" id="payIssueDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-md-6">
                                <label for="payChequeDate" class="form-label small fw-semibold">Cheque Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control form-control-sm" id="payChequeDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" id="refNumberContainer">
                        <label for="payReference" class="form-label fw-semibold small">Reference Number</label>
                        <input type="text" class="form-control" id="payReference" placeholder="e.g. Bank Transfer Ref / Receipt #" />
                        <div class="form-text small d-none" id="refRequiredHelp">Reference number is required for Bank payments.</div>
                    </div>

                    <div class="mb-3">
                        <label for="payDate" class="form-label fw-semibold small">Payment Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="payDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label for="payRemarks" class="form-label fw-semibold small">Remarks / Notes</label>
                        <input type="text" class="form-control" id="payRemarks" placeholder="Optional payment notes" />
                    </div>
                </div>

                <div class="modal-footer sd-modal-footer">
                    <button type="button" class="sd-btn sd-btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="sd-btn sd-btn-primary" id="btnSubmitPayment">
                        <span id="paySpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i id="payIcon" class="bi bi-check-circle"></i> Save Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const invoiceId = @header.InvoiceID;
            let currentOutstanding = @header.OutstandingBalance;
            let currentPaid = @header.PaidAmount;
            const grandTotal = @header.GrandTotal;
            const canRecordPayment = @(canRecordPayment ? "true" : "false");

            if (canRecordPayment) {
            const paymentModal = new bootstrap.Modal(document.getElementById('recordPaymentModal'));
            const btnOpenModal = document.getElementById('btnOpenPaymentModal');

            if (btnOpenModal) {
                btnOpenModal.addEventListener('click', function () {
                    document.getElementById('payAmount').value = currentOutstanding.toFixed(2);
                    document.getElementById('paymentModalAlert').classList.add('d-none');
                    paymentModal.show();
                });
            }

            const payMethodSelect = document.getElementById('payMethod');
            const refRequiredHelp = document.getElementById('refRequiredHelp');
            const detailsChequeFields = document.getElementById('detailsChequeFields');

            function toggleChequeFields(method) {
                if (method === 'Cheque') {
                    detailsChequeFields.classList.remove('d-none');
                    refRequiredHelp.classList.add('d-none');
                } else if (method === 'Bank') {
                    detailsChequeFields.classList.add('d-none');
                    refRequiredHelp.classList.remove('d-none');
                } else {
                    detailsChequeFields.classList.add('d-none');
                    refRequiredHelp.classList.add('d-none');
                }
            }

            if (window.jQuery) {
                window.jQuery(payMethodSelect).off('change.chequeToggle').on('change.chequeToggle', function () {
                    toggleChequeFields(window.jQuery(this).val());
                });
            } else {
                payMethodSelect.addEventListener('change', function () {
                    toggleChequeFields(this.value);
                });
            }

            document.getElementById('btnSubmitPayment').addEventListener('click', function () {
                const alertBox = document.getElementById('paymentModalAlert');
                alertBox.classList.add('d-none');

                const amount = parseFloat(document.getElementById('payAmount').value) || 0;
                const method = document.getElementById('payMethod').value;
                const reference = document.getElementById('payReference').value;
                const payDate = document.getElementById('payDate').value;
                const remarks = document.getElementById('payRemarks').value;

                const chqNum = document.getElementById('payChequeNumber').value;
                const bankName = document.getElementById('payBankName').value;
                const issueDate = document.getElementById('payIssueDate').value;
                const chequeDate = document.getElementById('payChequeDate').value;

                if (amount <= 0) {
                    alertBox.textContent = 'Payment amount must be greater than zero.';
                    alertBox.classList.remove('d-none');
                    return;
                }

                if (amount > currentOutstanding + 0.001) {
                    alertBox.textContent = `Payment cannot exceed outstanding balance (PKR ${currentOutstanding.toFixed(2)}).`;
                    alertBox.classList.remove('d-none');
                    return;
                }

                if (method === 'Cheque') {
                    if (!chqNum.trim()) {
                        alertBox.textContent = 'Cheque Number is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (!bankName.trim()) {
                        alertBox.textContent = 'Bank Name is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                    if (!chequeDate) {
                        alertBox.textContent = 'Cheque Date is required.';
                        alertBox.classList.remove('d-none');
                        return;
                    }
                } else if (method === 'Bank' && !reference.trim()) {
                    alertBox.textContent = 'Reference Number is required for Bank payments.';
                    alertBox.classList.remove('d-none');
                    return;
                }

                const payload = {
                    InvoiceID: invoiceId,
                    CustomerID: parseInt(document.getElementById('payCustomerID').value),
                    Amount: amount,
                    PaymentMethod: method,
                    ReferenceNumber: reference,
                    PaymentDate: payDate,
                    Remarks: remarks,
                    ChequeNumber: chqNum,
                    BankName: bankName,
                    IssueDate: issueDate || null,
                    ChequeDate: chequeDate || null
                };

                const token = document.querySelector('#recordPaymentForm input[name="__RequestVerificationToken"]').value;

                const btn = this;
                btn.disabled = true;
                document.getElementById('paySpinner').classList.remove('d-none');
                document.getElementById('payIcon').classList.add('d-none');

                fetch('/Payments/RecordCustomerPayment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                })
                .then(async res => {
                    const data = await res.json().catch(() => ({}));
                    if (res.status === 403 || data.success === false) {
                        throw new Error(data.message || 'You do not have permission to perform this action.');
                    }
                    return data;
                })
                .then(data => {
                    btn.disabled = false;
                    document.getElementById('paySpinner').classList.add('d-none');
                    document.getElementById('payIcon').classList.remove('d-none');

                    if (data.success) {
                        paymentModal.hide();

                        currentPaid += amount;
                        currentOutstanding = Math.max(0, grandTotal - currentPaid);

                        document.getElementById('kpiPaidAmount').textContent = 'PKR ' + currentPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('kpiOutstanding').textContent = 'PKR ' + currentOutstanding.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('payModalAlreadyPaid').textContent = 'PKR ' + currentPaid.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        document.getElementById('payModalOutstanding').textContent = 'PKR ' + currentOutstanding.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                        const statusElem = document.getElementById('kpiPaymentStatus');
                        if (currentOutstanding <= 0.001) {
                            statusElem.innerHTML = '<span class="sd-status sd-status--paid"><i class="bi bi-check-circle"></i> Paid</span>';
                            if (btnOpenModal) btnOpenModal.classList.add('d-none');
                        } else {
                            statusElem.innerHTML = '<span class="sd-status sd-status--partial"><i class="bi bi-clock-history"></i> Partial</span>';
                        }

                        document.getElementById('lockedInvoiceBanner').classList.remove('d-none');

                        loadPaymentHistory(1);
                        if (ledgerLoaded) loadLedger(1);
                    } else {
                        alertBox.textContent = data.message || 'Failed to record payment.';
                        alertBox.classList.remove('d-none');
                    }
                })
                .catch(err => {
                    btn.disabled = false;
                    document.getElementById('paySpinner').classList.add('d-none');
                    document.getElementById('payIcon').classList.remove('d-none');
                    paymentModal.hide();
                    if (window.WimsToast) {
                        window.WimsToast.show(err.message || 'An error occurred while saving payment.', 'danger');
                    } else {
                        alertBox.textContent = err.message || 'An error occurred while saving payment.';
                        alertBox.classList.remove('d-none');
                    }
                });
            });
            }

            function loadPaymentHistory(page = 1) {
                const container = document.getElementById('paymentHistoryTabContainer');
                fetch(`/Payments/GetCustomerPaymentHistoryPartial?invoiceId=${invoiceId}`)
                    .then(res => res.text())
                    .then(html => {
                        container.innerHTML = html;
                    })
                    .catch(err => {
                        container.innerHTML = '<div class="alert alert-danger">Failed to load payment history.</div>';
                    });
            }

            function loadLedger(page = 1) {
                const container = document.getElementById('ledgerTabContainer');
                fetch(`/Sales/LedgerTab/${invoiceId}?pageNumber=${page}`)
                    .then(res => res.text())
                    .then(html => {
                        container.innerHTML = html;
                    })
                    .catch(err => {
                        container.innerHTML = '<div class="alert alert-danger">Failed to load ledger.</div>';
                    });
            }

            loadPaymentHistory(1);

            let ledgerLoaded = false;
            document.getElementById('ledger-tab').addEventListener('click', function () {
                if (!ledgerLoaded) {
                    loadLedger(1);
                    ledgerLoaded = true;
                }
            });
        });
    </script>
}
