@model InventorySystem.ViewModels.Sales.EditSalesViewModel
@{
    ViewData["Title"] = $"Edit Sales Invoice #{Model.InvoiceNumber}";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Sales Invoices</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.InvoiceID">@Model.InvoiceNumber</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-pencil-square me-2 text-warning"></i> Edit Sales Invoice #@Model.InvoiceNumber
            </h1>
        </div>
        <div>
            <a asp-action="Details" asp-route-id="@Model.InvoiceID" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
        </div>
    </div>

    <!-- Error Summary -->
    <div asp-validation-summary="All" class="alert alert-danger shadow-sm d-none" id="validationSummary"></div>

    <form asp-action="Edit" method="post" id="salesEditForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InvoiceID" />
        <input type="hidden" asp-for="InvoiceNumber" />
        <input type="hidden" asp-for="CustomerID" />
        <input type="hidden" asp-for="WarehouseID" />
        <input type="hidden" asp-for="ItemsJson" id="ItemsJson" />
        <input type="hidden" asp-for="AppliedDiscountRuleID" id="AppliedDiscountRuleID" />
        <input type="hidden" asp-for="DiscountMode" id="DiscountMode" />
        <input type="hidden" asp-for="ManualDiscountType" id="ManualDiscountType" />
        <input type="hidden" asp-for="ManualDiscountValue" id="ManualDiscountValue" />
        <input type="hidden" asp-for="ApplyPromotions" id="ApplyPromotions" />

        <!-- Header Card (Immutable Fields Read-Only) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-info-circle me-2"></i> Invoice Information</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Invoice Number</label>
                        <input type="text" class="form-control bg-light" value="@Model.InvoiceNumber" readonly />
                        <span class="form-text text-muted"><i class="bi bi-lock-fill me-1"></i> Permanently Locked</span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Customer</label>
                        <input type="text" class="form-control bg-light" value="@Model.CustomerName" readonly />
                        <span class="form-text text-muted"><i class="bi bi-lock-fill me-1"></i> Permanently Locked</span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Warehouse</label>
                        <input type="text" class="form-control bg-light" value="@Model.WarehouseName" readonly />
                        <span class="form-text text-muted"><i class="bi bi-lock-fill me-1"></i> Permanently Locked</span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="InvoiceDate" class="form-label fw-semibold"></label>
                        <input asp-for="InvoiceDate" class="form-control" type="date" />
                        <span asp-validation-for="InvoiceDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="BrokerID" class="form-label fw-semibold"></label>
                        <select asp-for="BrokerID" asp-items="Model.Brokers" class="form-select" id="brokerSelect" required>
                            <option value="">-- Select Bookie --</option>
                        </select>
                        <span asp-validation-for="BrokerID" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SalespersonID" class="form-label fw-semibold"></label>
                        <select asp-for="SalespersonID" asp-items="Model.Salespersons" class="form-select" id="salespersonSelect" required>
                            <option value="">-- Select Salesperson --</option>
                        </select>
                        <span asp-validation-for="SalespersonID" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DeliveryPersonID" class="form-label fw-semibold"></label>
                        <select asp-for="DeliveryPersonID" asp-items="Model.DeliveryPersons" class="form-select">
                            <option value="">-- None / Direct Pick --</option>
                        </select>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Remarks" class="form-label fw-semibold"></label>
                        <input asp-for="Remarks" class="form-control" placeholder="Optional notes or delivery instructions..." />
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Line Items Table -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-cart3 me-2"></i> Line Items Grid</h5>
                <button type="button" class="btn btn-primary btn-sm shadow-sm" id="btnAddRow">
                    <i class="bi bi-plus-lg me-1"></i> Add Product Row
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="itemsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%;">Product *</th>
                                <th style="width: 15%;">Unit *</th>
                                <th style="width: 12%;">Qty *</th>
                                <th style="width: 12%;">Stock Avail.</th>
                                <th style="width: 14%;">Unit Price</th>
                                <th style="width: 14%;">Line Total</th>
                                <th style="width: 4%;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="itemsTbody">
                            <!-- Dynamic Javascript Rows -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Real-Time Promotion & Discount Summary Panel -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="card-title mb-0 fw-bold text-success"><i class="bi bi-gift-fill me-2"></i> Promotional Schemes & Financial Summary</h5>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span class="fw-semibold small text-muted mb-0">Discount Mode:</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Discount mode toggle">
                        <input type="radio" class="btn-check" name="discountModeToggle" id="discountModeNone" value="None" autocomplete="off" @(Model.DiscountMode == "None" ? "checked" : "")>
                        <label class="btn btn-outline-secondary" for="discountModeNone">None</label>
                        <input type="radio" class="btn-check" name="discountModeToggle" id="discountModeAutomatic" value="Automatic" autocomplete="off" @(Model.DiscountMode != "Manual" && Model.DiscountMode != "None" ? "checked" : "")>
                        <label class="btn btn-outline-primary" for="discountModeAutomatic">Automatic</label>
                        <input type="radio" class="btn-check" name="discountModeToggle" id="discountModeManual" value="Manual" autocomplete="off" @(Model.DiscountMode == "Manual" ? "checked" : "")>
                        <label class="btn btn-outline-warning" for="discountModeManual">Manual</label>
                    </div>
                    <span class="fw-semibold small text-muted mb-0">Apply Promotion:</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Apply promotions toggle">
                        <input type="radio" class="btn-check" name="applyPromotionsToggle" id="applyPromotionsYes" value="true" autocomplete="off" @(Model.ApplyPromotions ? "checked" : "")>
                        <label class="btn btn-outline-success" for="applyPromotionsYes">Yes</label>
                        <input type="radio" class="btn-check" name="applyPromotionsToggle" id="applyPromotionsNo" value="false" autocomplete="off" @(!Model.ApplyPromotions ? "checked" : "")>
                        <label class="btn btn-outline-secondary" for="applyPromotionsNo">No</label>
                    </div>
                    <span class="badge bg-primary fs-6" id="summaryHeaderGrandTotal">Total: PKR 0.00</span>
                </div>
            </div>
            <div class="card-body">
                <div id="manualDiscountPanel" class="border rounded p-3 mb-3 bg-light @(Model.DiscountMode == "Manual" ? "" : "d-none")">
                    <h6 class="fw-bold mb-2"><i class="bi bi-sliders me-1"></i> Manual Discount (no threshold)</h6>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Type</label>
                            <select id="manualDiscountTypeSelect" class="form-select form-select-sm">
                                <option value="Percentage" selected>Percentage (%)</option>
                                <option value="FixedAmount">Fixed Amount (PKR)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold mb-1">Value</label>
                            <input type="number" id="manualDiscountValueInput" class="form-control form-control-sm" min="0" step="0.01" value="@(Model.ManualDiscountValue)" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-7 mb-3 mb-md-0">
                        <label class="fw-semibold text-dark mb-2">Promotions & Discounts Active Status</label>
                        <div id="promotionsContainer" class="p-3 bg-light rounded border">
                            <div class="text-muted small"><i class="bi bi-info-circle me-1"></i> Add or modify line items to evaluate promotional schemes.</div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="p-3 bg-light rounded border">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Paid Items Subtotal:</span>
                                <strong id="summarySubtotal">PKR 0.00</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-danger">
                                <span>Order Discount:</span>
                                <strong id="summaryDiscount">- PKR 0.00</strong>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between fs-5 fw-bold text-dark">
                                <span>Grand Total:</span>
                                <span id="summaryGrandTotalAmount" class="text-primary">PKR 0.00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reason for Edit & Submission -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold text-warning"><i class="bi bi-exclamation-triangle me-2"></i> Audit Requirement</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <label asp-for="EditReason" class="form-label fw-bold text-dark">Reason for Editing Invoice *</label>
                        <textarea asp-for="EditReason" class="form-control" rows="2" placeholder="State the business reason for modifying this unpaid invoice (e.g. Corrected item quantity, updated discount)..." required></textarea>
                        <span asp-validation-for="EditReason" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light text-end py-3">
                <a asp-action="Details" asp-route-id="@Model.InvoiceID" class="btn btn-outline-secondary me-2">Cancel</a>
                <button type="button" class="btn btn-warning px-4 shadow-sm fw-bold" id="btnSubmitEdit">
                    <i class="bi bi-check-circle me-1"></i> Save Updated Invoice
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const existingItems = JSON.parse('@Html.Raw(Model.ItemsJson)');
        const warehouseId = @Model.WarehouseID;
        const customerId = @Model.CustomerID;
        let productOptionsHtml = '<option value="">-- Select Product --</option>';

        function isApplyPromotionsEnabled() {
            return $('#applyPromotionsYes').is(':checked');
        }

        function setApplyPromotions(enabled) {
            $('#applyPromotionsYes').prop('checked', enabled);
            $('#applyPromotionsNo').prop('checked', !enabled);
            $('#ApplyPromotions').val(enabled ? 'true' : 'false');
        }

        function clearFreePromoRows() {
            $('#itemsTbody tr[data-item-type="FREE"]').remove();
            recalculateInvoiceSummary();
        }

        $(document.body).ready(async function () {
            setApplyPromotions(@(Model.ApplyPromotions ? "true" : "false"));

            $('#applyPromotionsYes').on('change', function () {
                if (this.checked) {
                    setApplyPromotions(true);
                    recalculateInvoiceSummary();
                }
            });

            $('#applyPromotionsNo').on('change', function () {
                if (this.checked) {
                    setApplyPromotions(false);
                    clearFreePromoRows();
                    $('#promotionsContainer').html(`
                        <div class="alert alert-secondary py-2 mb-0 small">
                            <i class="bi bi-slash-circle me-1"></i> Promotions will not be applied. Only paid (NORMAL) lines will be saved.
                        </div>`);
                }
            });

            await loadProducts();
            if (existingItems && existingItems.length > 0) {
                existingItems.forEach(item => addRow(item));
            } else {
                addRow();
            }
            recalculateInvoiceSummary();
        });

        async function loadProducts() {
            try {
                const res = await fetch(`/Sales/GetProductsByWarehouse?warehouseId=${warehouseId}`);
                const products = await res.json();
                productOptionsHtml = '<option value="">-- Select Product --</option>';
                products.forEach(p => {
                    productOptionsHtml += `<option value="${p.id}">${p.name}</option>`;
                });
            } catch (err) {
                console.error("Failed to load products:", err);
            }
        }

        function addRow(itemData = null) {
            const isFree = itemData && (itemData.ItemType === "FREE" || itemData.itemType === "FREE");
            const promoId = itemData ? (itemData.PromotionID || itemData.promotionID || 0) : 0;
            const rowId = Date.now() + Math.random().toString(36).substr(2, 5);

            let tr = '';
            if (isFree) {
                const prodName = itemData.ProductName || itemData.productName || 'Promotional Free Item';
                const unitName = itemData.UnitName || itemData.unitName || 'Unit';
                const prodId = itemData.ProductID || itemData.productID;
                const unitId = itemData.ProductUnitID || itemData.productUnitID;
                const qty = itemData.Quantity || itemData.quantity || 1;

                tr = `
                    <tr id="row_${rowId}" class="item-row table-success" data-item-type="FREE" data-promo-id="${promoId}">
                        <td>
                            <input type="hidden" class="item-product" value="${prodId}" />
                            <span class="fw-bold text-success">${prodName}</span>
                            <span class="badge bg-success ms-2">PROMOTIONAL FREE ITEM</span>
                        </td>
                        <td>
                            <input type="hidden" class="item-unit" value="${unitId}" />
                            <span class="fw-semibold text-secondary">${unitName}</span>
                        </td>
                        <td>
                            <input type="number" class="form-control item-qty bg-light fw-bold text-success" value="${qty}" readonly />
                        </td>
                        <td>
                            <span class="badge bg-info text-dark item-stock">-</span>
                        </td>
                        <td>
                            <input type="number" class="form-control item-price bg-light" value="0.00" readonly />
                        </td>
                        <td>
                            <input type="text" class="form-control bg-light item-total font-monospace text-success fw-bold" value="FREE" readonly />
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">AUTO</span>
                        </td>
                    </tr>
                `;
            } else {
                tr = `
                    <tr id="row_${rowId}" class="item-row" data-item-type="NORMAL">
                        <td>
                            <select class="form-select item-product" required onchange="onProductChange('${rowId}')">
                                ${productOptionsHtml}
                            </select>
                        </td>
                        <td>
                            <select class="form-select item-unit" required onchange="onUnitChange('${rowId}')">
                                <option value="">-- Select Unit --</option>
                            </select>
                        </td>
                        <td>
                            <input type="number" class="form-control item-qty" step="0.01" min="0.01" value="${itemData ? itemData.Quantity : 1}" oninput="calculateRowTotal('${rowId}')" required />
                        </td>
                        <td>
                            <span class="badge bg-info text-dark item-stock">-</span>
                        </td>
                        <td>
                            <input type="number" class="form-control item-price" step="0.01" min="0" value="${itemData ? itemData.UnitPrice : 0}" oninput="calculateRowTotal('${rowId}')" required />
                        </td>
                        <td>
                            <input type="text" class="form-control bg-light item-total" readonly value="0.00" />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow('${rowId}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }

            $('#itemsTbody').append(tr);

            if (!isFree && itemData) {
                const $row = $(`#row_${rowId}`);
                const prodId = itemData.ProductID || itemData.productID || itemData.productId;
                const unitId = itemData.ProductUnitID || itemData.productUnitID || itemData.productUnitId;
                $row.find('.item-product').val(prodId);
                onProductChange(rowId, unitId);
            }
        }

        async function onProductChange(rowId, selectedUnitId = null) {
            const $row = $(`#row_${rowId}`);
            const productId = $row.find('.item-product').val();
            const $unitSelect = $row.find('.item-unit');

            $unitSelect.html('<option value="">Loading...</option>');
            if (!productId) return;

            try {
                const res = await fetch(`/Sales/GetProductUnits?productId=${productId}`);
                const units = await res.json();
                let html = '<option value="">-- Select Unit --</option>';
                units.forEach(u => {
                    const uid = u.id !== undefined ? u.id : (u.productUnitId || u.productUnitID);
                    const uname = u.name || u.unitName || 'Unit';
                    const uprice = u.salePrice !== undefined ? u.salePrice : (u.sellingPrice || 0);
                    html += `<option value="${uid}" data-price="${uprice}">${uname}</option>`;
                });
                $unitSelect.html(html);

                if (selectedUnitId) {
                    $unitSelect.val(selectedUnitId);
                } else if (units.length > 0) {
                    const defaultUid = units[0].id !== undefined ? units[0].id : (units[0].productUnitId || units[0].productUnitID);
                    const defaultPrice = units[0].salePrice !== undefined ? units[0].salePrice : (units[0].sellingPrice || 0);
                    $unitSelect.val(defaultUid);
                    $row.find('.item-price').val(defaultPrice);
                }
                if (window.WimsSelect2) {
                    window.WimsSelect2.sync($unitSelect[0]);
                }
                updateStockDisplay(rowId);
                calculateRowTotal(rowId);
            } catch (err) {
                console.error("Failed to load units:", err);
            }
        }

        async function onUnitChange(rowId) {
            const $row = $(`#row_${rowId}`);
            const price = $row.find('.item-unit option:selected').data('price');
            if (price !== undefined) {
                $row.find('.item-price').val(price);
            }
            updateStockDisplay(rowId);
            calculateRowTotal(rowId);
        }

        async function updateStockDisplay(rowId) {
            const $row = $(`#row_${rowId}`);
            const productId = $row.find('.item-product').val();
            const unitId = $row.find('.item-unit').val();
            if (!productId || !unitId) return;

            try {
                const res = await fetch(`/Sales/GetAvailableStock?productId=${productId}&warehouseId=${warehouseId}&unitId=${unitId}`);
                const data = await res.json();
                $row.find('.item-stock').text(`${data.availableStock} ${data.unitName}`);
            } catch (err) {
                console.error("Failed to fetch stock:", err);
            }
        }

        function getDiscountMode() {
            return $('input[name="discountModeToggle"]:checked').val() || 'Automatic';
        }

        function syncDiscountHiddenFields(subtotal) {
            const mode = getDiscountMode();
            $('#DiscountMode').val(mode);
            if (mode === 'Manual') {
                const type = $('#manualDiscountTypeSelect').val() || 'Percentage';
                let value = parseFloat($('#manualDiscountValueInput').val()) || 0;
                if (type === 'Percentage' && value > 100) value = 100;
                if (value < 0) value = 0;
                $('#ManualDiscountType').val(type);
                $('#ManualDiscountValue').val(value);
                $('#AppliedDiscountRuleID').val('');
                let amount = 0;
                if (subtotal > 0 && value > 0) {
                    amount = type === 'FixedAmount' ? value : (subtotal * (value / 100));
                    amount = Math.min(subtotal, Math.round(amount * 100) / 100);
                }
                return amount;
            }
            $('#ManualDiscountType').val('');
            $('#ManualDiscountValue').val('0');
            if (mode === 'None') {
                $('#AppliedDiscountRuleID').val('');
                return 0;
            }
            return null; // Automatic: caller uses evaluation
        }

        $('input[name="discountModeToggle"]').on('change', function () {
            const mode = getDiscountMode();
            $('#manualDiscountPanel').toggleClass('d-none', mode !== 'Manual');
            if (mode !== 'Automatic') {
                $('#AppliedDiscountRuleID').val('');
            }
            recalculateInvoiceSummary();
        });
        $('#manualDiscountTypeSelect, #manualDiscountValueInput').on('change input', function () {
            recalculateInvoiceSummary();
        });

        function calculateRowTotal(rowId) {
            const $row = $(`#row_${rowId}`);
            const qty = parseFloat($row.find('.item-qty').val()) || 0;
            const price = parseFloat($row.find('.item-price').val()) || 0;
            const total = Math.max(0, qty * price);
            $row.find('.item-total').val(total.toFixed(2));
            recalculateInvoiceSummary();
        }

        function removeRow(rowId) {
            if ($('#itemsTbody tr[data-item-type="NORMAL"]').length <= 1) {
                alert("Sales invoice must contain at least one paid product row.");
                return;
            }
            $(`#row_${rowId}`).remove();
            recalculateInvoiceSummary();
        }

        $('#btnAddRow').click(function () {
            addRow();
        });

        async function recalculateInvoiceSummary() {
            const cartItems = [];
            let subtotal = 0;

            $('#itemsTbody tr[data-item-type="NORMAL"]').each(function () {
                const productId = parseInt($(this).find('.item-product').val());
                const unitId = parseInt($(this).find('.item-unit').val());
                const qty = parseFloat($(this).find('.item-qty').val()) || 0;
                const price = parseFloat($(this).find('.item-price').val()) || 0;

                if (productId > 0 && unitId > 0 && qty > 0) {
                    subtotal += (qty * price);
                    cartItems.push({
                        ProductID: productId,
                        ProductUnitID: unitId,
                        Quantity: qty,
                        UnitPrice: price,
                        DiscountAmount: 0,
                        ItemType: "NORMAL"
                    });
                }
            });

            $('#summarySubtotal').text(`PKR ${subtotal.toFixed(2)}`);

            const mode = getDiscountMode();
            if (mode === 'Manual' || mode === 'None') {
                const manualOrZero = syncDiscountHiddenFields(subtotal) || 0;
                if (!isApplyPromotionsEnabled()) {
                    syncFreeItemsWithPromotions([]);
                    $('#promotionsContainer').html(`
                        <div class="alert alert-secondary py-2 mb-0 small">
                            <i class="bi bi-slash-circle me-1"></i> Promotions will not be applied. Only paid (NORMAL) lines will be saved.
                        </div>`);
                }
                updateTotalsDisplay(subtotal, mode === 'Manual' ? manualOrZero : 0);
                if (mode === 'Manual' && isApplyPromotionsEnabled() && cartItems.length > 0) {
                    // still evaluate promos only
                } else if (mode !== 'Automatic') {
                    if (!isApplyPromotionsEnabled() || cartItems.length === 0) {
                        return;
                    }
                }
            }

            if (!isApplyPromotionsEnabled() && mode !== 'Automatic') {
                return;
            }

            if (!isApplyPromotionsEnabled() && mode === 'Automatic') {
                syncFreeItemsWithPromotions([]);
            }

            if (cartItems.length === 0) {
                $('#promotionsContainer').html('<div class="text-muted small"><i class="bi bi-info-circle me-1"></i> Add products to cart to evaluate promotional schemes.</div>');
                syncFreeItemsWithPromotions([]);
                updateTotalsDisplay(subtotal, mode === 'Manual' ? (syncDiscountHiddenFields(subtotal) || 0) : 0);
                return;
            }

            const payload = {
                CustomerID: customerId,
                WarehouseID: warehouseId,
                SubTotal: subtotal,
                Items: cartItems
            };

            try {
                const res = await fetch('/Sales/EvaluatePromotionsAndDiscounts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                renderPromotionsAndDiscounts(data, subtotal);
                syncFreeItemsWithPromotions(data.promotions || []);
            } catch (err) {
                console.error("Failed to evaluate promotions and discounts:", err);
            }
        }

        function syncFreeItemsWithPromotions(promotions) {
            const activePromoIds = promotions.map(p => parseInt(p.promotionID));

            // Remove FREE rows that are no longer eligible
            $('#itemsTbody tr[data-item-type="FREE"]').each(function () {
                const promoId = parseInt($(this).attr('data-promo-id'));
                if (!activePromoIds.includes(promoId)) {
                    $(this).remove();
                }
            });

            // Add or update FREE rows for eligible promotions
            promotions.forEach(p => {
                const promoId = parseInt(p.promotionID);
                const rewardQty = parseInt(p.rewardQuantity);
                let $freeRow = $(`#itemsTbody tr[data-item-type="FREE"][data-promo-id="${promoId}"]`);

                if (rewardQty <= 0) {
                    if ($freeRow.length > 0) $freeRow.remove();
                    return;
                }

                if ($freeRow.length > 0) {
                    // Update existing FREE row quantity
                    $freeRow.find('.item-qty').val(rewardQty);
                } else {
                    // Append new FREE row
                    const freeRowId = Date.now() + Math.random().toString(36).substr(2, 5);
                    const tr = `
                        <tr id="row_${freeRowId}" class="item-row table-success" data-item-type="FREE" data-promo-id="${promoId}">
                            <td>
                                <input type="hidden" class="item-product" value="${p.freeProductID}" />
                                <span class="fw-bold text-success">${p.freeProductName}</span>
                                <span class="badge bg-success ms-2">PROMOTIONAL FREE ITEM</span>
                            </td>
                            <td>
                                <input type="hidden" class="item-unit" value="${p.freeUnitID}" />
                                <span class="fw-semibold text-secondary">${p.freeUnitName}</span>
                            </td>
                            <td>
                                <input type="number" class="form-control item-qty bg-light fw-bold text-success" value="${rewardQty}" readonly />
                            </td>
                            <td>
                                <span class="badge bg-info text-dark item-stock">-</span>
                            </td>
                            <td>
                                <input type="number" class="form-control item-price bg-light" value="0.00" readonly />
                            </td>
                            <td>
                                <input type="text" class="form-control bg-light item-total font-monospace text-success fw-bold" value="FREE" readonly />
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">AUTO</span>
                            </td>
                        </tr>
                    `;
                    $('#itemsTbody').append(tr);
                }
            });
        }

        function renderPromotionsAndDiscounts(data, subtotal) {
            let html = '';
            const hasPromos = data.promotions && data.promotions.length > 0;
            const hasDiscounts = data.discounts && data.discounts.length > 0;

            if (!hasPromos && !hasDiscounts) {
                $('#promotionsContainer').html('<div class="text-muted small"><i class="bi bi-info-circle me-1"></i> No promotional schemes or order discounts eligible for current items.</div>');
                $('#AppliedDiscountRuleID').val('');
                updateTotalsDisplay(subtotal, 0);
                return;
            }

            if (hasPromos) {
                html += '<div class="fw-bold text-success mb-2"><i class="bi bi-gift-fill me-1"></i> Active Promotional Schemes:</div>';
                data.promotions.forEach(p => {
                    html += `
                        <div class="alert alert-success border-success py-2 px-3 mb-2 small">
                            <strong class="d-block text-success">${p.title}</strong>
                            <span>${p.message}</span>
                        </div>
                    `;
                });
            }

            let calculatedDiscount = 0;
            if (hasDiscounts && getDiscountMode() === 'Automatic') {
                const discount = data.discounts[0];
                calculatedDiscount = parseFloat(discount.calculatedDiscountAmount) || 0;
                $('#AppliedDiscountRuleID').val(discount.discountRuleID);
                $('#DiscountMode').val('Automatic');

                html += `
                    <div class="alert alert-info border-info py-2 px-3 mb-0 mt-2 small">
                        <strong class="d-block text-primary"><i class="bi bi-tag-fill me-1"></i> Eligible Order Discount: ${discount.ruleName}</strong>
                        <span>Save PKR ${calculatedDiscount.toFixed(2)} (${discount.message})</span>
                    </div>
                `;
            } else if (getDiscountMode() === 'Manual') {
                calculatedDiscount = syncDiscountHiddenFields(subtotal) || 0;
                html += `<div class="alert alert-warning py-2 small mb-0 mt-2"><i class="bi bi-info-circle me-1"></i> Manual discount mode — automatic rules are not applied.</div>`;
            } else {
                $('#AppliedDiscountRuleID').val('');
            }

            $('#promotionsContainer').html(html);
            updateTotalsDisplay(subtotal, calculatedDiscount);
        }

        function updateTotalsDisplay(subtotal, discountTotal) {
            const grandTotal = Math.max(0, subtotal - discountTotal);
            $('#summarySubtotal').text(`PKR ${subtotal.toFixed(2)}`);
            $('#summaryDiscount').text(`- PKR ${discountTotal.toFixed(2)}`);
            $('#summaryGrandTotalAmount').text(`PKR ${grandTotal.toFixed(2)}`);
            $('#summaryHeaderGrandTotal').text(`Total: PKR ${grandTotal.toFixed(2)}`);
        }

        $('#btnSubmitEdit').click(function () {
            const items = [];
            let isValid = true;

            $('#itemsTbody tr').each(function () {
                const itemType = $(this).attr('data-item-type') || "NORMAL";
                const promoId = parseInt($(this).attr('data-promo-id')) || null;
                const productId = parseInt($(this).find('.item-product').val());
                const unitId = parseInt($(this).find('.item-unit').val());
                const qty = parseFloat($(this).find('.item-qty').val());
                const price = parseFloat($(this).find('.item-price').val()) || 0;

                if (!productId || !unitId || !qty || qty <= 0) {
                    if (itemType !== "FREE") {
                        isValid = false;
                        return false;
                    }
                }

                items.push({
                    ProductID: productId,
                    ProductUnitID: unitId,
                    Quantity: qty,
                    UnitPrice: price,
                    DiscountAmount: 0,
                    ItemType: itemType,
                    PromotionID: promoId
                });
            });

            if (!isValid || items.length === 0) {
                alert("Please ensure all product rows have valid products, units, and positive quantities.");
                return;
            }

            const editReason = $('#EditReason').val().trim();
            if (!editReason) {
                alert("An edit reason is mandatory for audit trail logging.");
                $('#EditReason').focus();
                return;
            }

            const paidSub = items.filter(i => i.ItemType !== 'FREE').reduce((s, i) => s + (i.Quantity * i.UnitPrice), 0);
            syncDiscountHiddenFields(paidSub);
            if (getDiscountMode() === 'Automatic' && !$('#AppliedDiscountRuleID').val()) {
                // keep Automatic with no rule → server treats as None amount
            }
            $('#ItemsJson').val(JSON.stringify(items));
            setApplyPromotions(isApplyPromotionsEnabled());
            $('#salesEditForm').submit();
        });
    </script>
}
