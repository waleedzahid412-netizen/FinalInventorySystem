@{
    var section = ViewData["AnalyticsSection"]?.ToString() ?? "Overview";
}
<ul class="nav nav-pills gap-2 mb-3 flex-wrap">
    <li class="nav-item">
        <a class="nav-link @(section == "Overview" ? "active" : "")" asp-controller="Analytics" asp-action="Index">Overview</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(section == "Sales" ? "active" : "")" asp-controller="Analytics" asp-action="Sales">Sales</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(section == "Customers" ? "active" : "")" asp-controller="Analytics" asp-action="Customers">Customers</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(section == "Products" ? "active" : "")" asp-controller="Analytics" asp-action="Products">Products</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(section == "Bookers" ? "active" : "")" asp-controller="Analytics" asp-action="Bookers">Bookers</a>
    </li>
</ul>
