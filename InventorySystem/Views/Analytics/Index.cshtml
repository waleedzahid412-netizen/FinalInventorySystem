        // ===== 4. SALES BY CATEGORY =====
        async function loadCategorySales() {
            $('#categorySalesSpinner').show();
            $('#categorySalesEmpty').hide();
            $('#categoryLegendContainer').empty();

            try {
                const res = await fetch('/Analytics/GetCategorySales', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(buildFilterPayload())
                });
                const items = await res.json();
                $('#categorySalesSpinner').hide();

                if (!items || items.length === 0) {
                    if (chartCategorySalesInstance) chartCategorySalesInstance.destroy();
                    $('#categorySalesEmpty').show();
                    return;
                }

                const labels = items.map(x => x.categoryName);
                const salesData = items.map(x => x.salesAmount);

                const colorPalette = [
                    '#198754', '#0d6efd', '#ffc107', '#0dcaf0', '#6f42c1',
                    '#fd7e14', '#20c997', '#d63384', '#6c757d', '#212529'
                ];

                const chartColors = items.map((_, idx) => colorPalette[idx % colorPalette.length]);

                // Render Custom Legend Badges
                let legendHtml = '';
                items.forEach((cat, idx) => {
                    const color = chartColors[idx];
                    legendHtml += `
                        <div class="d-flex justify-content-between align-items-center py-2 px-2 border-bottom">
                            <span class="d-flex align-items-center">
                                <span class="d-inline-block rounded-circle me-2" style="width: 12px; height: 12px; background-color: ${color};"></span>
                                <strong class="text-dark small">${cat.categoryName}</strong>
                            </span>
                            <span class="badge bg-light text-dark border font-monospace">PKR ${cat.salesAmount.toLocaleString(undefined, { minimumFractionDigits: 2 })} (${cat.percentage}%)</span>
                        </div>
                    `;
                });
                $('#categoryLegendContainer').html(legendHtml);

                const ctx = document.getElementById('chartCategorySales').getContext('2d');
                if (chartCategorySalesInstance) chartCategorySalesInstance.destroy();

                const isDonut = items.length <= 10;
                chartCategorySalesInstance = new Chart(ctx, {
                    type: isDonut ? 'doughnut' : 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Category Sales (PKR)',
                            data: salesData,
                            backgroundColor: chartColors
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: !isDonut }
                        }
                    }
                });
            } catch (err) {
                $('#categorySalesSpinner').hide();
                console.error("Failed to load Category Sales:", err);
            }
        }
    </script>
}
