@model InventorySystem.DTOs.Analytics.OverviewAnalyticsDto
@{
    ViewData["Title"] = "Analytics Overview";
    ViewData["ShowPdfExport"] = true;
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="bi bi-graph-up-arrow me-2 text-primary"></i> Analytics &amp; Insights</h2>
            <p class="text-muted mb-0">Period KPIs, sales trend, and operational warnings. Estimated profit uses average purchase cost, not FIFO.</p>
        </div>
    </div>

    <partial name="_AnalyticsNav" />
    <partial name="_AnalyticsFilters" />

    <div id="businessInsightsContainer" class="row g-3 mb-4"></div>

    <div class="row g-3 mb-4" id="kpiCardsContainer">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-primary border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Total Sales</span>
                    <h3 class="fw-bold mb-1" id="kpiTotalSales">@Model.Kpi.TotalSales.FormattedCurrentValue</h3>
                    <span class="badge bg-light text-dark" id="kpiTotalSalesChange">@Model.Kpi.TotalSales.ComparisonText</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-dark border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Net Sales</span>
                    <h3 class="fw-bold mb-1" id="kpiNetSales">@Model.Kpi.NetSales.FormattedCurrentValue</h3>
                    <span class="badge bg-light text-dark" id="kpiNetSalesChange">@Model.Kpi.NetSales.ComparisonText</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-danger border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Returns</span>
                    <h3 class="fw-bold mb-1" id="kpiTotalReturns">@Model.Kpi.TotalReturns.FormattedCurrentValue</h3>
                    <span class="badge bg-light text-dark" id="kpiTotalReturnsChange">@Model.Kpi.TotalReturns.ComparisonText</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-success border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Est. Gross Profit (Avg Cost)</span>
                    <h3 class="fw-bold mb-1" id="kpiEstimatedGrossProfit">@Model.Kpi.EstimatedGrossProfit.FormattedCurrentValue</h3>
                    <span class="badge bg-light text-dark" id="kpiEstimatedGrossProfitChange">@Model.Kpi.EstimatedGrossProfit.ComparisonText</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-warning border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Customer Receivables</span>
                    <h3 class="fw-bold mb-1" id="kpiCustomerReceivables">@Model.Kpi.CustomerReceivables.FormattedCurrentValue</h3>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Cumulative ledger balance</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-info border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Company Payables</span>
                    <h3 class="fw-bold mb-1" id="kpiCompanyPayables">@Model.Kpi.CompanyPayables.FormattedCurrentValue</h3>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Cumulative ledger balance</span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Out of Stock</span>
                    <h3 class="fw-bold mb-1" id="kpiOutOfStock">@Model.Inventory.OutOfStockProductCount</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Low Stock</span>
                    <h3 class="fw-bold mb-1" id="kpiLowStock">@Model.Inventory.LowStockProductCount</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h5 class="card-title mb-0 fw-bold">Sales Trend</h5>
                <p class="text-muted small mb-0">Revenue buckets for the selected period.</p>
            </div>
            <div class="btn-group btn-group-sm" id="salesTrendIntervalGroup">
                <button type="button" class="btn btn-outline-secondary active" data-interval="Daily">Daily</button>
                <button type="button" class="btn btn-outline-secondary" data-interval="Weekly">Weekly</button>
                <button type="button" class="btn btn-outline-secondary" data-interval="Monthly">Monthly</button>
            </div>
        </div>
        <div class="card-body" style="min-height: 320px;">
            <canvas id="chartSalesTrend" style="max-height: 350px;"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let currentPreset = 'ThisMonth';
        let currentInterval = 'Daily';
        let chartSalesTrendInstance = null;

        $(function () {
            loadOverview();
            $('#presetGroup button').click(function () {
                $('#presetGroup button').removeClass('active');
                $(this).addClass('active');
                currentPreset = $(this).attr('data-preset');
                if (currentPreset === 'Custom') $('.custom-date-container').slideDown();
                else { $('.custom-date-container').slideUp(); loadOverview(); }
            });
            $('#salesTrendIntervalGroup button').click(function () {
                $('#salesTrendIntervalGroup button').removeClass('active');
                $(this).addClass('active');
                currentInterval = $(this).attr('data-interval');
                loadOverview();
            });
            $('#btnApplyFilter').click(loadOverview);
            $('#btnExportPdf').click(function () {
                const f = buildFilterPayload();
                window.open('/Analytics/ExportPdf?' + $.param({
                    preset: f.Preset, startDate: f.StartDate, endDate: f.EndDate,
                    warehouseId: f.WarehouseID, customerId: f.CustomerID, categoryId: f.CategoryID, brokerId: f.BrokerID
                }), '_blank');
            });
        });

        function buildFilterPayload() {
            return {
                Preset: currentPreset,
                StartDate: currentPreset === 'Custom' ? $('#startDate').val() : null,
                EndDate: currentPreset === 'Custom' ? $('#endDate').val() : null,
                WarehouseID: parseInt($('#warehouseId').val()) || null,
                CustomerID: parseInt($('#customerId').val()) || null,
                CategoryID: parseInt($('#categoryId').val()) || null,
                BrokerID: parseInt($('#brokerId').val()) || ($('#brokerId').val() === '-1' ? -1 : null)
            };
        }

        function money(v) { return 'PKR ' + Number(v || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

        async function loadOverview() {
            const res = await fetch('/Analytics/GetOverview?interval=' + currentInterval, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(buildFilterPayload())
            });
            const data = await res.json();
            const kpi = data.kpi || {};
            $('#kpiTotalSales').text(kpi.totalSales?.formattedCurrentValue || money(kpi.totalSales?.currentValue));
            $('#kpiTotalSalesChange').text(kpi.totalSales?.comparisonText || '');
            $('#kpiNetSales').text(kpi.netSales?.formattedCurrentValue || money(kpi.netSales?.currentValue));
            $('#kpiNetSalesChange').text(kpi.netSales?.comparisonText || '');
            $('#kpiTotalReturns').text(kpi.totalReturns?.formattedCurrentValue || money(kpi.totalReturns?.currentValue));
            $('#kpiTotalReturnsChange').text(kpi.totalReturns?.comparisonText || '');
            $('#kpiEstimatedGrossProfit').text(kpi.estimatedGrossProfit?.formattedCurrentValue || money(kpi.estimatedGrossProfit?.currentValue));
            $('#kpiEstimatedGrossProfitChange').text(kpi.estimatedGrossProfit?.comparisonText || '');
            $('#kpiCustomerReceivables').text(kpi.customerReceivables?.formattedCurrentValue || money(kpi.customerReceivables?.currentValue));
            $('#kpiCompanyPayables').text(kpi.companyPayables?.formattedCurrentValue || money(kpi.companyPayables?.currentValue));
            $('#kpiOutOfStock').text(data.inventory?.outOfStockProductCount ?? 0);
            $('#kpiLowStock').text(data.inventory?.lowStockProductCount ?? 0);
            renderInsights(data.insights || []);
            renderTrend(data.salesTrend || []);
        }

        function renderInsights(list) {
            const colors = { DANGER: 'danger', WARNING: 'warning', SUCCESS: 'success', INFO: 'info' };
            $('#businessInsightsContainer').html((list || []).map(i =>
                `<div class="col-md-6"><div class="alert alert-${colors[i.type] || 'info'} mb-0"><i class="bi ${i.icon} me-2"></i><strong>${i.title}:</strong> ${i.message}</div></div>`
            ).join(''));
        }

        function renderTrend(rows) {
            const ctx = document.getElementById('chartSalesTrend');
            if (chartSalesTrendInstance) chartSalesTrendInstance.destroy();
            chartSalesTrendInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: rows.map(r => r.label),
                    datasets: [{ label: 'Sales', data: rows.map(r => r.salesAmount), borderColor: '#0d6efd', tension: 0.2, fill: false }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
            });
        }
    </script>
}
