@model InventorySystem.DTOs.LoginRequestDTO

@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";

    var generalErrors = new List<string>();
    foreach (var entry in ViewData.ModelState)
    {
        if (!string.IsNullOrEmpty(entry.Key) || entry.Value is null)
        {
            continue;
        }

        foreach (var error in entry.Value.Errors)
        {
            generalErrors.Add(string.IsNullOrWhiteSpace(error.ErrorMessage)
                ? "We couldn't sign you in. Please check your details and try again."
                : error.ErrorMessage);
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-page">
    <!-- ================= BRAND PANEL ================= -->
    <aside class="login-brand" aria-label="About WIMS ERP">
        <div class="login-brand-inner">
            <div class="login-logo">
                <span class="login-logo-mark" aria-hidden="true">
                    <i class="bi bi-box-seam-fill"></i>
                </span>
                <div>
                    <span class="login-logo-name">WIMS <span class="login-logo-badge">ERP</span></span>
                    <span class="login-logo-sub">Wholesale Inventory Management</span>
                </div>
            </div>

            <div class="login-brand-copy">
                <span class="login-eyebrow">Wholesale operations, unified</span>
                <h1 class="login-brand-title">Run your wholesale operation from <span>one place.</span></h1>
                <p class="login-brand-lead">
                    Inventory, sales, purchasing, finance and analytics — connected in a single
                    workspace built for accuracy and speed.
                </p>

                <ul class="login-feature-list">
                    <li class="login-feature">
                        <span class="login-feature-icon" aria-hidden="true">
                            <i class="bi bi-boxes"></i>
                        </span>
                        <div>
                            <strong>Inventory in real time</strong>
                            <p>Live stock across warehouses, companies and locations.</p>
                        </div>
                    </li>
                    <li class="login-feature">
                        <span class="login-feature-icon" aria-hidden="true">
                            <i class="bi bi-receipt"></i>
                        </span>
                        <div>
                            <strong>Sales and purchasing, connected</strong>
                            <p>Invoices, returns and load sheets flow through one system.</p>
                        </div>
                    </li>
                    <li class="login-feature">
                        <span class="login-feature-icon" aria-hidden="true">
                            <i class="bi bi-graph-up-arrow"></i>
                        </span>
                        <div>
                            <strong>Decisions backed by data</strong>
                            <p>Ledgers, payments and analytics, always up to date.</p>
                        </div>
                    </li>
                </ul>
            </div>

            <div class="login-brand-footer">
                <div class="login-trust">
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Role-based access</span>
                    <span><i class="bi bi-lock" aria-hidden="true"></i> Secure sessions</span>
                    <span><i class="bi bi-building" aria-hidden="true"></i> Multi-company support</span>
                </div>
            </div>
        </div>
    </aside>

    <!-- ================= SIGN-IN PANEL ================= -->
    <section class="login-form-panel" aria-label="Sign in">
        <div class="login-mobile-brand">
            <span class="login-logo-mark" aria-hidden="true">
                <i class="bi bi-box-seam-fill"></i>
            </span>
            <div>
                <span class="login-logo-name">WIMS <span class="login-logo-badge">ERP</span></span>
                <span class="login-logo-sub">Wholesale Inventory Management</span>
            </div>
        </div>

        <div class="login-form-wrap">
            <div class="login-form-head">
                <span class="login-form-kicker">Secure access</span>
                <h2 class="login-form-title">Welcome back</h2>
                <p class="login-form-sub">Sign in to continue to your WIMS workspace.</p>
            </div>

            @if (ViewBag.SessionExpired == true)
            {
                <div class="login-alert login-alert--warning" role="alert">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                    <div>Your session has expired. Please sign in again.</div>
                </div>
            }

            @if (ViewBag.RateLimited == true)
            {
                <div class="login-alert login-alert--warning" role="alert">
                    <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                    <div>Too many sign-in attempts. Please wait a moment and try again.</div>
                </div>
            }

            @if (generalErrors.Count > 0)
            {
                <div class="login-alert login-alert--danger" role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                    <div>
                        <strong>Sign-in failed</strong>
                        @foreach (var error in generalErrors)
                        {
                            <p>@error</p>
                        }
                    </div>
                </div>
            }

            <form asp-action="Login" asp-controller="Auth" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div class="login-field">
                    <label asp-for="Username" class="login-label">Username</label>
                    <div class="login-input">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <input asp-for="Username"
                               class="login-control"
                               placeholder="Enter your username"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               aria-describedby="usernameError"
                               required
                               autofocus />
                    </div>
                    <span asp-validation-for="Username" id="usernameError" class="login-field-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password" class="login-label">Password</label>
                    <div class="login-input login-input--password">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="Password"
                               type="password"
                               id="inputPassword"
                               class="login-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               aria-describedby="passwordError capsLockHint"
                               required />
                        <button type="button"
                                class="login-eye"
                                id="togglePassword"
                                aria-label="Show password"
                                aria-pressed="false"
                                aria-controls="inputPassword">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" id="passwordError" class="login-field-error"></span>
                    <div class="login-caps" id="capsLockHint" role="status" hidden>
                        <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> Caps Lock is on
                    </div>
                </div>

                <div class="login-options">
                    <label class="login-remember" for="RememberMeSwitch">
                        <input asp-for="RememberMe" id="RememberMeSwitch" class="login-remember-input" />
                        <span>Remember me</span>
                    </label>
                    <span class="login-session-note">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        <span id="sessionNoteText">1-hour session</span>
                    </span>
                </div>

                <button type="submit" class="login-submit" id="loginSubmit">
                    <span class="login-submit-idle" id="loginSubmitIdle">
                        Sign in <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </span>
                    <span class="login-submit-loading" id="loginSubmitLoading" hidden>
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Signing in&hellip;
                    </span>
                </button>
            </form>

            <div class="login-form-foot">
                <p class="login-help">
                    <i class="bi bi-life-preserver" aria-hidden="true"></i>
                    Trouble signing in? Contact your system administrator.
                </p>
                <p class="login-copyright">
                    &copy; @DateTime.Now.Year WIMS — Wholesale Inventory Management System
                </p>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var form = document.getElementById('loginForm');
            var password = document.getElementById('inputPassword');
            var toggle = document.getElementById('togglePassword');
            var toggleIcon = toggle ? toggle.querySelector('i') : null;
            var capsHint = document.getElementById('capsLockHint');
            var remember = document.getElementById('RememberMeSwitch');
            var sessionNote = document.getElementById('sessionNoteText');
            var submit = document.getElementById('loginSubmit');
            var submitIdle = document.getElementById('loginSubmitIdle');
            var submitLoading = document.getElementById('loginSubmitLoading');

            /* Show / hide password */
            if (toggle && password) {
                toggle.addEventListener('click', function () {
                    var show = password.type === 'password';
                    password.type = show ? 'text' : 'password';
                    toggle.setAttribute('aria-pressed', String(show));
                    toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');

                    if (toggleIcon) {
                        toggleIcon.classList.toggle('bi-eye', !show);
                        toggleIcon.classList.toggle('bi-eye-slash', show);
                    }

                    password.focus({ preventScroll: true });
                });
            }

            /* Caps Lock hint */
            function updateCapsLock(event) {
                if (!capsHint) {
                    return;
                }

                var isOn = typeof event.getModifierState === 'function' && event.getModifierState('CapsLock');
                capsHint.hidden = !isOn;
            }

            if (password && capsHint) {
                password.addEventListener('keydown', updateCapsLock);
                password.addEventListener('keyup', updateCapsLock);
                password.addEventListener('blur', function () {
                    capsHint.hidden = true;
                });
            }

            /* Explain the session length tied to "Remember me" */
            function updateSessionNote() {
                if (!remember || !sessionNote) {
                    return;
                }

                sessionNote.textContent = remember.checked ? '7-day session' : '1-hour session';
            }

            if (remember) {
                updateSessionNote();
                remember.addEventListener('change', updateSessionNote);
            }

            /* Prevent double submits and show progress */
            if (form && submit) {
                form.addEventListener('submit', function () {
                    if (!form.checkValidity()) {
                        return;
                    }

                    submit.disabled = true;
                    submit.setAttribute('aria-busy', 'true');

                    if (submitIdle) {
                        submitIdle.hidden = true;
                    }

                    if (submitLoading) {
                        submitLoading.hidden = false;
                    }
                });

                window.addEventListener('pageshow', function () {
                    submit.disabled = false;
                    submit.removeAttribute('aria-busy');

                    if (submitIdle) {
                        submitIdle.hidden = false;
                    }

                    if (submitLoading) {
                        submitLoading.hidden = true;
                    }
                });
            }
        })();
    </script>
}
