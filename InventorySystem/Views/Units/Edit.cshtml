@model InventorySystem.ViewModels.Units.EditUnitViewModel
@{
    ViewData["Title"] = "Edit Unit";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-pencil-square me-2 text-primary"></i>Edit Unit
            </h1>
            <p class="text-muted small mb-0">Update unit <strong>@Model.UnitName</strong>.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm col-lg-8 mx-auto">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="UnitID" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                @if (Model.IsInUse)
                {
                    <div class="alert alert-info mb-4" role="alert">
                        <i class="bi bi-info-circle me-1"></i>
                        This unit is assigned to one or more products. You can rename or deactivate it, but it cannot be deleted.
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="UnitName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="UnitName" class="form-control" required />
                        <span asp-validation-for="UnitName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Update Unit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
