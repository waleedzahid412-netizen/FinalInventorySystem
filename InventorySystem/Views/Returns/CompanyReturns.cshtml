@model InventorySystem.ViewModels.Returns.CompanyReturnsListViewModel
@{
    ViewData["Title"] = "Company Purchase Returns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0 text-gray-800"><i class="bi bi-box-arrow-left text-primary me-2"></i> Company Purchase Returns</h2>
        <p class="text-muted small mb-0">Manage returns to suppliers, update inventory, and post ledger debits</p>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FILTER CARD -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-controller="Returns" asp-action="CompanyReturns" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Return Number</label>
                <input type="text" asp-for="Filter.ReturnNumber" class="form-control form-control-sm" placeholder="e.g. PR-00001" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Purchase Invoice Number</label>
                <input type="text" asp-for="Filter.InvoiceNumber" class="form-control form-control-sm" placeholder="e.g. PUR-00001" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Company / Supplier</label>
                <select asp-for="Filter.CompanyID" asp-items="Model.Companies" class="form-select form-select-sm">
                    <option value="">-- All Companies --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-filter me-1"></i> Filter</button>
                <a asp-action="CompanyReturns" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- RETURNS TABLE -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Return #</th>
                        <th>Purchase Invoice #</th>
                        <th>Supplier / Company</th>
                        <th>Return Date</th>
                        <th class="text-center">Items</th>
                        <th class="text-end">Net Refund</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Returns != null && Model.Returns.Items.Any())
                    {
                        @foreach (var item in Model.Returns.Items)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.ReturnNumber</td>
                                <td>
                                    <a asp-controller="Purchases" asp-action="Details" asp-route-id="@item.PurchaseInvoiceID" class="text-decoration-none fw-semibold">
                                        @item.InvoiceNumber
                                    </a>
                                </td>
                                <td>@item.CompanyName</td>
                                <td>@item.ReturnDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center"><span class="badge bg-secondary">@item.ItemCount</span></td>
                                <td class="text-end fw-bold text-primary">@item.NetRefundAmount.ToString("C2")</td>
                                <td class="text-center">
                                    <a asp-action="PurchaseReturnDetails" asp-route-id="@item.PurchaseReturnID" class="btn btn-xs btn-outline-info" title="View Details">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i> No purchase returns found matching your filter criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
