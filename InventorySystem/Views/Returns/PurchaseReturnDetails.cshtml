@model InventorySystem.DTOs.Returns.PurchaseReturnDetailsDto
@{
    ViewData["Title"] = $"Purchase Return #{Model.Header.ReturnNumber}";
    var header = Model.Header;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0 text-gray-800"><i class="bi bi-box-arrow-left text-primary me-2"></i> Purchase Return #@header.ReturnNumber</h2>
        <p class="text-muted small mb-0">Processed on @header.ReturnDate.ToString("dd MMM yyyy HH:mm") UTC by <strong>@header.CreatedByUserName</strong></p>
    </div>
    <div>
        <a asp-action="CompanyReturns" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Company Returns
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- HEADER INFORMATION -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i> Return Summary & Details</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <span class="text-muted small d-block">Original Purchase Invoice</span>
                        <a asp-controller="Purchases" asp-action="Details" asp-route-id="@header.PurchaseInvoiceID" class="fw-bold text-decoration-none fs-5">
                            @header.InvoiceNumber <i class="bi bi-box-arrow-up-right small"></i>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">Company / Supplier</span>
                        <span class="fw-bold">@header.CompanyName</span>
                    </div>
                    <div class="col-md-4">
                        <span class="text-muted small d-block">Warehouse</span>
                        <span class="fw-bold"><i class="bi bi-building me-1"></i> @header.WarehouseName</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(header.Reason))
                    {
                        <div class="col-md-12">
                            <span class="text-muted small d-block">Remarks / Return Reason</span>
                            <div class="p-2 bg-light rounded border text-dark">@header.Reason</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RETURNED ITEMS TABLE -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i> Returned Line Items</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th class="text-center">Return Qty</th>
                                <th>Condition</th>
                                <th>Reason</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end">Refund Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                int idx = 1;
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@(idx++)</td>
                                        <td>
                                            <div class="fw-bold">@item.ProductName</div>
                                            <span class="small text-muted">@item.SKU | Base Qty: @item.ConvertedQuantity.ToString("N2")</span>
                                        </td>
                                        <td class="text-center fw-bold">@item.Quantity.ToString("N2") @item.UnitName</td>
                                        <td>
                                            <span class="badge @(string.Equals(item.ReturnCondition, "Sellable", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-warning text-dark")">
                                                @item.ReturnCondition
                                            </span>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Reason) ? "-" : item.Reason)</td>
                                        <td class="text-end">@item.RefundUnitCost.ToString("C2")</td>
                                        <td class="text-end fw-semibold">@item.RefundAmount.ToString("C2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- FINANCIAL BREAKDOWN -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold"><i class="bi bi-wallet2 me-2"></i> Ledger Debit Breakdown</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Gross Return Value:</span>
                    <span class="fw-bold">@header.GrossAmount.ToString("C2")</span>
                </div>
                <hr />
                <div class="p-3 bg-light rounded border text-center">
                    <span class="text-muted small d-block">NET COMPANY LEDGER DEBIT</span>
                    <span class="fs-3 fw-bold text-primary">@header.NetRefundAmount.ToString("C2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
