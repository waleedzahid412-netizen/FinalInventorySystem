@model InventorySystem.ViewModels.Returns.CreateReturnViewModel
@{
    ViewData["Title"] = "Create Sales Return";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0 fw-bold text-gray-800">
                <i class="bi bi-arrow-return-left me-2 text-danger"></i> Create Sales Return
            </h1>
            <p class="text-muted small mb-0">
                Select a customer and invoice, then process the return with the same logic used from Sales Invoice → Process Return.
            </p>
        </div>
        <a asp-action="CustomerReturns" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Returns
        </a>
    </div>

    <!-- Step indicators -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body py-3">
            <div class="d-flex justify-content-around text-center">
                <div id="stepHeader1" class="wizard-step active fw-bold text-primary">
                    <span class="badge bg-primary rounded-circle me-1">1</span> Select Customer
                </div>
                <div id="stepHeader2" class="wizard-step text-muted">
                    <span class="badge bg-secondary rounded-circle me-1">2</span> Return Type
                </div>
                <div id="stepHeader3" class="wizard-step text-muted">
                    <span class="badge bg-secondary rounded-circle me-1">3</span> Select Invoice
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <!-- STEP 1: CUSTOMER -->
            <div id="stepPanel1" class="wizard-panel">
                <h5 class="fw-bold mb-3"><i class="bi bi-person-check me-2 text-primary"></i> Step 1: Select Customer</h5>
                <div class="col-lg-6 mb-4">
                    <label class="form-label fw-semibold" for="wizardCustomer">Customer <span class="text-danger">*</span></label>
                    <select id="wizardCustomer" class="form-select" data-placeholder="Search customer...">
                        <option value="">-- Select Customer --</option>
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.Value">@c.Text</option>
                        }
                    </select>
                    <div class="form-text">Only invoices for this customer will be listed next.</div>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" id="btnStep1Next" class="btn btn-primary px-4 fw-semibold" disabled>
                        Next <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 2: TYPE -->
            <div id="stepPanel2" class="wizard-panel d-none">
                <h5 class="fw-bold mb-3"><i class="bi bi-diagram-3 me-2 text-primary"></i> Step 2: Choose Return Type</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="card h-100 border shadow-sm p-3 cursor-pointer return-type-card" for="typeInvoice">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="wizardReturnType" id="typeInvoice" value="INVOICE" checked>
                                <span class="form-check-label fw-bold ms-1">
                                    <i class="bi bi-receipt text-primary me-1"></i> Return Against Sales Invoice
                                </span>
                            </div>
                            <p class="text-muted small mb-0 mt-2">
                                Pick an invoice, then use the full Process Sales Return screen
                                (quantities, carton/bottle, reasons, scheme clawback, settlement).
                            </p>
                        </label>
                    </div>
                    <div class="col-md-6">
                        <label class="card h-100 border shadow-sm p-3 cursor-pointer return-type-card" for="typeManual">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="wizardReturnType" id="typeManual" value="MANUAL">
                                <span class="form-check-label fw-bold ms-1">
                                    <i class="bi bi-pencil-square text-warning me-1"></i> Manual / Direct Return
                                </span>
                            </div>
                            <p class="text-muted small mb-0 mt-2">
                                Return without an invoice — opens the dedicated manual return page.
                            </p>
                        </label>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" id="btnStep2Prev">
                        <i class="bi bi-arrow-left me-1"></i> Previous
                    </button>
                    <button type="button" id="btnStep2Next" class="btn btn-primary px-4 fw-semibold">
                        Next <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>

            <!-- STEP 3: INVOICE PICKER -->
            <div id="stepPanel3Invoice" class="wizard-panel d-none">
                <h5 class="fw-bold mb-3"><i class="bi bi-receipt me-2 text-primary"></i> Step 3: Select Sales Invoice</h5>
                <p class="text-muted small mb-3">
                    After you choose an invoice, you will continue on the same <strong>Process Sales Return</strong>
                    screen used when starting a return from that invoice.
                </p>

                <div class="col-lg-8 mb-3">
                    <label class="form-label fw-semibold" for="wizardInvoiceSelect">Sales Invoice <span class="text-danger">*</span></label>
                    <select id="wizardInvoiceSelect" class="form-select" data-placeholder="Search invoice...">
                        <option value="">-- Select Invoice --</option>
                    </select>
                    <div id="invoiceLoadStatus" class="form-text"></div>
                </div>

                <div id="selectedInvoiceSummary" class="alert alert-light border d-none mb-4">
                    <div class="fw-semibold mb-1" id="summaryInvoiceNumber"></div>
                    <div class="small text-muted" id="summaryInvoiceMeta"></div>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" id="btnStep3Prev">
                        <i class="bi bi-arrow-left me-1"></i> Previous
                    </button>
                    <button type="button" id="btnContinueProcessReturn" class="btn btn-danger px-4 fw-semibold" disabled>
                        <i class="bi bi-arrow-return-left me-1"></i> Continue to Process Return
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .return-type-card { cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .return-type-card:hover { border-color: var(--bs-primary) !important; }
    .wizard-step { font-size: 0.9rem; }
</style>

@section Scripts {
    <script>
        (function () {
            var currentStep = 1;
            var selectedCustomerId = null;
            var selectedInvoiceId = null;

            function setStep(step) {
                currentStep = step;
                $('.wizard-panel').addClass('d-none');
                for (var i = 1; i <= 3; i++) {
                    var $h = $('#stepHeader' + i);
                    $h.removeClass('active fw-bold text-primary text-muted');
                    $h.find('.badge').removeClass('bg-primary bg-secondary').addClass('bg-secondary');
                    if (i < step) {
                        $h.addClass('text-muted');
                    } else if (i === step) {
                        $h.addClass('active fw-bold text-primary');
                        $h.find('.badge').removeClass('bg-secondary').addClass('bg-primary');
                    } else {
                        $h.addClass('text-muted');
                    }
                }

                if (step === 1) {
                    $('#stepPanel1').removeClass('d-none');
                } else if (step === 2) {
                    $('#stepPanel2').removeClass('d-none');
                } else if (step === 3) {
                    $('#stepPanel3Invoice').removeClass('d-none');
                }
            }

            function refreshStep1Next() {
                $('#btnStep1Next').prop('disabled', !$('#wizardCustomer').val());
            }

            function loadInvoices(customerId) {
                selectedInvoiceId = null;
                $('#btnContinueProcessReturn').prop('disabled', true);
                $('#selectedInvoiceSummary').addClass('d-none');
                $('#invoiceLoadStatus').text('Loading invoices…');

                var $sel = $('#wizardInvoiceSelect');
                $sel.empty().append('<option value="">-- Select Invoice --</option>');

                $.getJSON('/Returns/GetCustomerInvoices', { customerId: customerId })
                    .done(function (rows) {
                        if (!rows || !rows.length) {
                            $('#invoiceLoadStatus').text('No sales invoices found for this customer' +
                                (window.location.search.indexOf('company') >= 0 ? '' : ' under the current company scope') + '.');
                            return;
                        }

                        rows.forEach(function (inv) {
                            var label = inv.invoiceNumber + ' (' + inv.invoiceDate + ') — Total: $' +
                                Number(inv.grandTotal).toFixed(2);
                            $sel.append($('<option></option>').val(inv.invoiceId).text(label)
                                .attr('data-number', inv.invoiceNumber)
                                .attr('data-date', inv.invoiceDate)
                                .attr('data-total', inv.grandTotal)
                                .attr('data-paid', inv.paidAmount)
                                .attr('data-balance', inv.balance));
                        });

                        $('#invoiceLoadStatus').text(rows.length + ' invoice(s) available. Select one to continue.');
                        if ($sel.hasClass('select2-hidden-accessible')) {
                            $sel.trigger('change.select2');
                        }
                    })
                    .fail(function () {
                        $('#invoiceLoadStatus').text('Could not load invoices. Please try again.');
                    });
            }

            function onInvoiceSelected() {
                var $opt = $('#wizardInvoiceSelect option:selected');
                selectedInvoiceId = $opt.val() ? parseInt($opt.val(), 10) : null;

                if (!selectedInvoiceId) {
                    $('#selectedInvoiceSummary').addClass('d-none');
                    $('#btnContinueProcessReturn').prop('disabled', true);
                    return;
                }

                $('#summaryInvoiceNumber').text($opt.data('number') || ('Invoice #' + selectedInvoiceId));
                $('#summaryInvoiceMeta').text(
                    'Date: ' + ($opt.data('date') || '—') +
                    ' · Total: $' + Number($opt.data('total') || 0).toFixed(2) +
                    ' · Balance: $' + Number($opt.data('balance') || 0).toFixed(2)
                );
                $('#selectedInvoiceSummary').removeClass('d-none');
                $('#btnContinueProcessReturn').prop('disabled', false);
            }

            $('#wizardCustomer').on('change', function () {
                selectedCustomerId = $(this).val() ? parseInt($(this).val(), 10) : null;
                refreshStep1Next();
            });

            $('#btnStep1Next').on('click', function () {
                if (!$('#wizardCustomer').val()) return;
                setStep(2);
            });

            $('#btnStep2Prev').on('click', function () { setStep(1); });

            $('#btnStep2Next').on('click', function () {
                var type = $('input[name="wizardReturnType"]:checked').val();
                if (type === 'MANUAL') {
                    // Reuse the dedicated manual return page (same as Process Manual Sales Return).
                    var url = '@Url.Action("ProcessManualSalesReturn", "Returns")';
                    var cust = $('#wizardCustomer').val();
                    if (cust) {
                        url += (url.indexOf('?') >= 0 ? '&' : '?') + 'customerId=' + encodeURIComponent(cust);
                    }
                    window.location.href = url;
                    return;
                }

                loadInvoices(parseInt($('#wizardCustomer').val(), 10));
                setStep(3);
            });

            $('#btnStep3Prev').on('click', function () { setStep(2); });

            $('#wizardInvoiceSelect').on('change', onInvoiceSelected);

            $('#btnContinueProcessReturn').on('click', function () {
                if (!selectedInvoiceId) return;
                // Same destination as Sales Invoice → Process Return
                window.location.href = '@Url.Action("ProcessSalesReturn", "Returns")' +
                    '?invoiceId=' + encodeURIComponent(selectedInvoiceId);
            });

            refreshStep1Next();
            setStep(1);
        })();
    </script>
}
