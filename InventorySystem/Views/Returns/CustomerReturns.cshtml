@model InventorySystem.ViewModels.Returns.CustomerReturnsListViewModel
@{
    ViewData["Title"] = "Customer Returns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h3 mb-0 text-gray-800"><i class="bi bi-arrow-return-left text-danger me-2"></i> Customer Returns</h2>
        <p class="text-muted small mb-0">Manage invoice-based and direct manual customer returns, restock inventory, and manage refund settlements.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CreateReturn" class="btn btn-warning shadow-sm text-dark fw-bold">
            <i class="bi bi-pencil-square me-1"></i> + Create Return Wizard
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- FILTER CARD -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-controller="Returns" asp-action="CustomerReturns" class="row g-3">
            <div class="col-md-2">
                <label class="form-label small fw-bold">Return Number</label>
                <input type="text" asp-for="Filter.ReturnNumber" class="form-control form-control-sm" placeholder="e.g. SR-00001" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Invoice Number</label>
                <input type="text" asp-for="Filter.InvoiceNumber" class="form-control form-control-sm" placeholder="e.g. INV-00001" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Customer</label>
                <select asp-for="Filter.CustomerID" asp-items="Model.Customers" class="form-select form-select-sm">
                    <option value="">-- All Customers --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Return Type</label>
                <select asp-for="Filter.ReturnType" class="form-select form-select-sm">
                    <option value="">-- All Types --</option>
                    <option value="INVOICE">Invoice Return</option>
                    <option value="MANUAL">Manual Return</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Settlement</label>
                <select asp-for="Filter.SettlementMethod" class="form-select form-select-sm">
                    <option value="">-- All Settlements --</option>
                    <option value="ACCOUNT_ADJUSTMENT">Account Credit</option>
                    <option value="CASH">Cash Refund</option>
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter"></i></button>
                <a asp-action="CustomerReturns" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- RETURNS TABLE -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Return #</th>
                        <th class="text-center">Type</th>
                        <th>Invoice #</th>
                        <th>Customer</th>
                        <th class="text-center">Settlement</th>
                        <th>Return Date</th>
                        <th class="text-center">Items</th>
                        <th class="text-end">Gross Return</th>
                        <th class="text-end">Clawbacks</th>
                        <th class="text-end">Net Refund</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Returns != null && Model.Returns.Items.Any())
                    {
                        @foreach (var item in Model.Returns.Items)
                        {
                            decimal totalClawback = item.ClawbackPenalty + item.PromoPenalty;
                            bool isManual = string.Equals(item.ReturnType, "MANUAL", StringComparison.OrdinalIgnoreCase);
                            bool isCash = string.Equals(item.SettlementMethod, "CASH", StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td class="fw-bold text-danger">@item.ReturnNumber</td>
                                <td class="text-center">
                                    @if (isManual)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-pencil-square me-1"></i> Manual</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary px-2 py-1"><i class="bi bi-receipt me-1"></i> Invoice</span>
                                    }
                                </td>
                                <td>
                                    @if (item.InvoiceID.HasValue && item.InvoiceID.Value > 0)
                                    {
                                        <a asp-controller="Sales" asp-action="Details" asp-route-id="@item.InvoiceID" class="text-decoration-none fw-semibold">
                                            @item.InvoiceNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-semibold">—</span>
                                    }
                                </td>
                                <td>@item.CustomerName</td>
                                <td class="text-center">
                                    @if (isCash)
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="bi bi-cash-stack me-1"></i> Cash</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-person-badge me-1"></i> Account</span>
                                    }
                                </td>
                                <td>@item.ReturnDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center"><span class="badge bg-secondary">@item.ItemCount</span></td>
                                <td class="text-end fw-semibold">@item.GrossAmount.ToString("C2")</td>
                                <td class="text-end text-danger">@(totalClawback > 0 ? $"-{totalClawback:C2}" : "$0.00")</td>
                                <td class="text-end fw-bold text-success">@item.NetRefundAmount.ToString("C2")</td>
                                <td class="text-center">
                                    <a asp-action="SalesReturnDetails" asp-route-id="@item.SalesReturnID" class="btn btn-xs btn-outline-info me-1" title="View Details">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a asp-action="DownloadSalesReturnPdf" asp-route-id="@item.SalesReturnID" class="btn btn-xs btn-outline-danger" title="Download PDF Receipt">
                                        <i class="bi bi-file-earmark-pdf"></i> PDF
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i> No customer returns found matching your filter criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
