@model InventorySystem.ViewModels.LoadSheets.LoadSheetIndexViewModel
@{
    ViewData["Title"] = "Generate Load Sheet";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1"><i class="bi bi-truck me-2 text-primary"></i> Generate Load Sheet</h2>
            <p class="text-muted mb-0">Filter sales invoices by booker, date, and supplier. Generate downloads two PDFs — product load and party invoices.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="card-title mb-0 fw-bold text-primary"><i class="bi bi-funnel me-2"></i> Load Sheet Filters</h5>
        </div>
        <div class="card-body">
            <form id="loadSheetForm" asp-action="Generate" method="post">
                @Html.AntiForgeryToken()
                <div id="loadSheetAlert" class="alert alert-danger shadow-sm @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert">
                    <div asp-validation-summary="All"></div>
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label asp-for="BookerID" class="form-label fw-semibold"></label>
                        <select asp-for="BookerID" asp-items="Model.Bookers" class="form-select" required>
                            <option value="">-- Select Booker --</option>
                        </select>
                        <span asp-validation-for="BookerID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Date" class="form-label fw-semibold"></label>
                        <input asp-for="Date" class="form-control" type="date" required />
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SupplierID" class="form-label fw-semibold"></label>
                        <select asp-for="SupplierID" asp-items="Model.Suppliers" class="form-select">
                        </select>
                        <div class="form-text small">Optional — limits the load sheet to invoices assigned to this supplier. Booker and date always apply.</div>
                    </div>
                    <div class="col-12">
                        <button type="submit" id="btnGenerateLoadSheet" class="btn btn-primary fw-bold shadow-sm">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Generate Load Sheet
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body">
            <h6 class="fw-bold text-secondary text-uppercase small mb-3">Downloaded PDFs</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-light">
                        <strong>PDF 1 — Product Load Summary</strong>
                        <p class="small text-muted mb-0 mt-2">Aggregated products in base (smallest) units with SKU, name, base unit price, and Total Count.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100 bg-light">
                        <strong>PDF 2 — Party Invoice Report</strong>
                        <p class="small text-muted mb-0 mt-2">One row per matching sales invoice with bill number, party, address, amounts, and footer totals.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('loadSheetForm');
            const alertBox = document.getElementById('loadSheetAlert');
            const button = document.getElementById('btnGenerateLoadSheet');
            if (!form) return;

            function showError(message) {
                alertBox.classList.remove('d-none');
                alertBox.innerHTML = '<ul class="mb-0"><li>' + (message || 'Unable to generate the load sheet.') + '</li></ul>';
            }

            function hideError() {
                alertBox.classList.add('d-none');
                alertBox.innerHTML = '';
            }

            function downloadBase64Pdf(base64, fileName) {
                const binary = atob(base64);
                const bytes = new Uint8Array(binary.length);
                for (let i = 0; i < binary.length; i++) {
                    bytes[i] = binary.charCodeAt(i);
                }
                const blob = new Blob([bytes], { type: 'application/pdf' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                link.remove();
                setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
            }

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                hideError();

                if (typeof form.reportValidity === 'function' && !form.reportValidity()) {
                    return;
                }

                const originalHtml = button.innerHTML;
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Generating...';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const data = await response.json();
                    if (!data || !data.success) {
                        showError(data && data.message ? data.message : 'No sales invoices found for the selected filters.');
                        return;
                    }

                    downloadBase64Pdf(data.productsPdf, data.productsFileName);
                    downloadBase64Pdf(data.invoicesPdf, data.invoicesFileName);
                } catch (err) {
                    showError('Unable to generate the load sheet. Please try again.');
                } finally {
                    button.disabled = false;
                    button.innerHTML = originalHtml;
                }
            });
        })();
    </script>
}
