@model InventorySystem.ViewModels.Reports.CompanyStockReportViewModel

@{
    ViewData["Title"] = "Company Stock Report";
}

<div class="container-fluid py-4">
    <!-- Header & Action Toolbar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-clipboard-data me-2 text-primary"></i>Company Stock Report
            </h1>
            <p class="text-muted small mb-0">
                Real-time inventory levels, reorder alerts, and stock health for
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">@Model.ScopeLabel</span>
            </p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2 flex-wrap">
            <a asp-action="ExportExcel"
               asp-route-SearchTerm="@Model.Filter.SearchTerm"
               asp-route-CategoryID="@Model.Filter.CategoryID"
               asp-route-StockStatus="@Model.Filter.StockStatus"
               class="btn btn-success shadow-sm btn-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Excel
            </a>
            <a asp-action="ExportPdf"
               asp-route-SearchTerm="@Model.Filter.SearchTerm"
               asp-route-CategoryID="@Model.Filter.CategoryID"
               asp-route-StockStatus="@Model.Filter.StockStatus"
               target="_blank"
               class="btn btn-outline-danger shadow-sm btn-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm btn-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </a>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-primary border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Total Products</span>
                    <h3 class="fw-bold mb-0">@Model.Summary.TotalProducts.ToString("N0")</h3>
                    <small class="text-muted">Distinct items in catalog</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-info border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Total Stock</span>
                    <h3 class="fw-bold mb-0">@Model.Summary.TotalStockQuantity.ToString("N0")</h3>
                    <small class="text-muted">Aggregate units on hand</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-warning border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Low Stock</span>
                    <h3 class="fw-bold mb-0 text-warning">@Model.Summary.LowStockCount.ToString("N0")</h3>
                    <small class="text-muted">At or below reorder level</small>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-danger border-4">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Out of Stock</span>
                    <h3 class="fw-bold mb-0 text-danger">@Model.Summary.OutOfStockCount.ToString("N0")</h3>
                    <small class="text-muted">Zero quantity remaining</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Search</label>
                    <input type="text"
                           asp-for="Filter.SearchTerm"
                           name="SearchTerm"
                           class="form-control form-control-sm"
                           placeholder="Product Name or SKU..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Category</label>
                    <select asp-for="Filter.CategoryID"
                            name="CategoryID"
                            asp-items="Model.Categories"
                            class="form-select form-select-sm">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Stock Status</label>
                    <select asp-for="Filter.StockStatus"
                            name="StockStatus"
                            asp-items="Model.StockStatusOptions"
                            class="form-select form-select-sm"
                            data-no-select2>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-fill">
                        <i class="bi bi-search me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stock Data Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            @if (Model.IsAllCompanies)
                            {
                                <th class="ps-3">Company</th>
                            }
                            <th class="@(!Model.IsAllCompanies ? "ps-3" : "")">Product Name</th>
                            <th>SKU</th>
                            <th>Base Unit</th>
                            <th class="text-end">Current Stock</th>
                            <th class="text-end">Reorder Level</th>
                            <th class="text-center pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows.Items != null && Model.Rows.Items.Any())
                        {
                            foreach (var row in Model.Rows.Items)
                            {
                                <tr>
                                    @if (Model.IsAllCompanies)
                                    {
                                        <td class="ps-3">
                                            <span class="badge bg-light text-dark border">@row.CompanyName</span>
                                        </td>
                                    }
                                    <td class="@(!Model.IsAllCompanies ? "ps-3" : "") fw-semibold">@row.ProductName</td>
                                    <td><code class="text-muted">@(row.SKU ?? "-")</code></td>
                                    <td><small class="text-muted">@row.BaseUnitName</small></td>
                                    <td class="text-end fw-semibold">
                                        <span class="badge @(row.CurrentStock <= 0 ? "bg-danger" : row.CurrentStock <= row.ReorderLevel ? "bg-warning text-dark" : "bg-info")">
                                            @row.CurrentStock.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="text-end text-muted">@row.ReorderLevel.ToString("N0")</td>
                                    <td class="text-center pe-3">
                                        @if (row.Status == "Out of Stock")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Out of Stock
                                            </span>
                                        }
                                        else if (row.Status == "Low Stock")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-exclamation-circle me-1"></i>Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>In Stock
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            var colSpan = Model.IsAllCompanies ? 7 : 6;
                            <tr>
                                <td colspan="@colSpan" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No stock records found matching your filter criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (Model.Rows.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    Showing Page @Model.Rows.PageNumber of @Model.Rows.TotalPages (@Model.Rows.TotalCount.ToString("N0") Total Products)
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Rows.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.Rows.PageNumber - 1)"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-CategoryID="@Model.Filter.CategoryID"
                               asp-route-StockStatus="@Model.Filter.StockStatus">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.Rows.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Rows.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-PageNumber="@i"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-CategoryID="@Model.Filter.CategoryID"
                                   asp-route-StockStatus="@Model.Filter.StockStatus">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.Rows.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.Rows.PageNumber + 1)"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-CategoryID="@Model.Filter.CategoryID"
                               asp-route-StockStatus="@Model.Filter.StockStatus">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
