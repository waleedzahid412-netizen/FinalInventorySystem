@model InventorySystem.ViewModels.Warehouses.WarehouseListViewModel
@{
    ViewData["Title"] = "Warehouses";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-building-fill-gear me-2 text-primary"></i> Warehouses
            </h1>
            <p class="text-muted small mb-0">Manage inventory locations used on purchases, sales, and stock balances.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Warehouse
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2 shadow-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Search by name or address..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-muted">Status</label>
                    <select name="IsActive" class="form-select" data-no-select2>
                        <option value="">-- All --</option>
                        <option value="true" selected="@(Model.Filter.IsActive == true)">Active</option>
                        <option value="false" selected="@(Model.Filter.IsActive == false)">Inactive</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small text-muted">Main</label>
                    <select name="IsMain" class="form-select" data-no-select2>
                        <option value="">-- All --</option>
                        <option value="true" selected="@(Model.Filter.IsMain == true)">Main only</option>
                        <option value="false" selected="@(Model.Filter.IsMain == false)">Non-main</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Address</th>
                            <th class="text-center">Main</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Warehouses.Items.Any())
                        {
                            foreach (var warehouse in Model.Warehouses.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@warehouse.Name</td>
                                    <td class="text-muted">@(string.IsNullOrWhiteSpace(warehouse.Address) ? "—" : warehouse.Address)</td>
                                    <td class="text-center">
                                        @if (warehouse.IsMain)
                                        {
                                            <span class="badge bg-primary-subtle text-primary px-2 py-1">Main</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (warehouse.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2 py-1">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@warehouse.WarehouseID" class="btn btn-outline-secondary" title="Edit Warehouse">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger btn-delete" data-id="@warehouse.WarehouseID" data-name="@warehouse.Name" title="Delete Warehouse">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    No warehouses found matching your criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Warehouses.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    Showing @(((Model.Warehouses.PageNumber - 1) * Model.Warehouses.PageSize) + 1) to @(Math.Min(Model.Warehouses.PageNumber * Model.Warehouses.PageSize, Model.Warehouses.TotalCount)) of @Model.Warehouses.TotalCount warehouses
                </span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.Warehouses.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.Warehouses.PageNumber - 1)" asp-route-SearchTerm="@Model.Filter.SearchTerm" asp-route-IsActive="@Model.Filter.IsActive" asp-route-IsMain="@Model.Filter.IsMain">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.Warehouses.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Warehouses.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-PageNumber="@i" asp-route-SearchTerm="@Model.Filter.SearchTerm" asp-route-IsActive="@Model.Filter.IsActive" asp-route-IsMain="@Model.Filter.IsMain">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.Warehouses.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.Warehouses.PageNumber + 1)" asp-route-SearchTerm="@Model.Filter.SearchTerm" asp-route-IsActive="@Model.Filter.IsActive" asp-route-IsMain="@Model.Filter.IsMain">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel"><i class="bi bi-exclamation-triangle me-2"></i>Delete Warehouse</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete warehouse <strong id="deleteWarehouseName"></strong>?</p>
                <p class="small text-muted mb-0">Note: The main warehouse and warehouses used by stock or documents cannot be deleted.</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteWarehouseId" name="id" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                document.getElementById('deleteWarehouseId').value = id;
                document.getElementById('deleteWarehouseName').textContent = name;
                new bootstrap.Modal(document.getElementById('deleteModal')).show();
            });
        });
    </script>
}
