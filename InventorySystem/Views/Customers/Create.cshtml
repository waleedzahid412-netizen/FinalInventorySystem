@model InventorySystem.ViewModels.Customers.CreateCustomerViewModel

@{
    ViewData["Title"] = "Add New Customer";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1"><i class="bi bi-person-plus text-primary me-2"></i>Add New Customer</h2>
                    <p class="text-muted mb-0">Register a new retail shop customer with location and credit settings.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createCustomerForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Basic Profile Section -->
                        <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-shop me-2"></i>Shop Profile</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ShopName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="ShopName" class="form-control" placeholder="e.g. Al-Madina Super Store" id="shopNameInput" />
                                <span asp-validation-for="ShopName" class="text-danger small"></span>
                                <div id="shopNameCheckResult" class="small mt-1"></div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OwnerName" class="form-label fw-semibold"></label>
                                <input asp-for="OwnerName" class="form-control" placeholder="e.g. Muhammad Raza" />
                                <span asp-validation-for="OwnerName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control" placeholder="e.g. 0300-1234567" id="phoneInput" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                                <div id="phoneCheckResult" class="small mt-1"></div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TaxID" class="form-label fw-semibold"></label>
                                <input asp-for="TaxID" class="form-control" placeholder="e.g. NTN-1234567-8" />
                                <span asp-validation-for="TaxID" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Location & Hierarchy Section -->
                        <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-geo-alt me-2"></i>Location Hierarchy</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="AreaID" class="form-label fw-semibold"></label>
                                <select asp-for="AreaID" class="form-select" id="areaSelect" asp-items="Model.Areas">
                                    <option value="">-- Select Area --</option>
                                </select>
                                <span asp-validation-for="AreaID" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SubAreaID" class="form-label fw-semibold"></label>
                                <select asp-for="SubAreaID" class="form-select" id="subAreaSelect" asp-items="Model.SubAreas">
                                    <option value="">-- Select Sub-Area --</option>
                                </select>
                                <span asp-validation-for="SubAreaID" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Address" class="form-label fw-semibold"></label>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street address, shop number, landmark..."></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Financial & Credit Settings -->
                        <h5 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-wallet2 me-2"></i>Financial & Credit Settings</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="CreditLimit" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">PKR</span>
                                    <input asp-for="CreditLimit" class="form-control" type="number" step="1000" min="0" />
                                </div>
                                <span asp-validation-for="CreditLimit" class="text-danger small"></span>
                                <div class="form-text small">Informational credit threshold. Warning badge triggers if exceeded.</div>
                            </div>

                            <div class="col-md-6 d-flex align-items-center mt-4">
                                <div class="form-check form-switch fs-5">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                                    <label class="form-check-label fs-6 fw-semibold ms-2" for="isActiveSwitch">Active Customer</label>
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Save Customer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Cascading Sub-Area Dropdown on Area change
        document.getElementById('areaSelect').addEventListener('change', function () {
            const areaId = this.value;
            const subAreaSelect = document.getElementById('subAreaSelect');
            subAreaSelect.innerHTML = '<option value="">-- Select Sub-Area --</option>';

            if (areaId) {
                fetch(`/Customers/GetSubAreas?areaId=${areaId}`)
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(sa => {
                            const opt = document.createElement('option');
                            opt.value = sa.id;
                            opt.textContent = sa.name;
                            subAreaSelect.appendChild(opt);
                        });
                    });
            }
        });

        // Remote validation for Shop Name
        document.getElementById('shopNameInput').addEventListener('blur', function () {
            const val = this.value.trim();
            const resDiv = document.getElementById('shopNameCheckResult');
            if (val) {
                fetch(`/Customers/CheckShopName?shopName=${encodeURIComponent(val)}`)
                    .then(res => res.json())
                    .then(isUnique => {
                        if (!isUnique) {
                            resDiv.className = 'small text-danger mt-1';
                            resDiv.textContent = '❌ This shop name is already taken.';
                        } else {
                            resDiv.className = 'small text-success mt-1';
                            resDiv.textContent = '✓ Shop name is available.';
                        }
                    });
            } else {
                resDiv.textContent = '';
            }
        });

        // Remote validation for Phone
        document.getElementById('phoneInput').addEventListener('blur', function () {
            const val = this.value.trim();
            const resDiv = document.getElementById('phoneCheckResult');
            if (val) {
                fetch(`/Customers/CheckPhone?phone=${encodeURIComponent(val)}`)
                    .then(res => res.json())
                    .then(isUnique => {
                        if (!isUnique) {
                            resDiv.className = 'small text-danger mt-1';
                            resDiv.textContent = '❌ This phone number is already registered.';
                        } else {
                            resDiv.className = 'small text-success mt-1';
                            resDiv.textContent = '✓ Phone number is available.';
                        }
                    });
            } else {
                resDiv.textContent = '';
            }
        });
    </script>
}
