@model InventorySystem.ViewModels.Customers.CustomerListViewModel

@{
    ViewData["Title"] = "Customer Management";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Customers</h2>
            <p class="text-muted mb-0">Manage retail shop customers, locations, credit limits, and balances.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Add New Customer
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Form -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Search Term</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Shop, Owner, Phone, Tax ID..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Area</label>
                    <select name="AreaID" id="filterAreaSelect" class="form-select form-select-sm" asp-items="Model.Areas">
                        <option value="">-- All Areas --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Sub-Area</label>
                    <select name="SubAreaID" id="filterSubAreaSelect" class="form-select form-select-sm" asp-items="Model.SubAreas">
                        <option value="">-- All Sub-Areas --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="IsActive" class="form-select form-select-sm">
                        <option value="">-- All Statuses --</option>
                        <option value="true" selected="@(Model.Filter.IsActive == true)">Active</option>
                        <option value="false" selected="@(Model.Filter.IsActive == false)">Inactive</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Shop Name</th>
                            <th>Owner Name</th>
                            <th>Phone</th>
                            <th>Area / Sub-Area</th>
                            <th class="text-end">Credit Limit (PKR)</th>
                            <th class="text-end">Outstanding (PKR)</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Customers == null || !Model.Customers.Items.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No customers found matching your filter criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in Model.Customers.Items)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@c.CustomerID" class="fw-bold text-decoration-none text-primary">
                                            @c.ShopName
                                        </a>
                                        @if (c.IsCreditLimitExceeded)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" title="Outstanding exceeds credit limit">
                                                <i class="bi bi-exclamation-triangle"></i> Exceeded
                                            </span>
                                        }
                                    </td>
                                    <td>@(c.OwnerName ?? "-")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Phone))
                                        {
                                            <a href="tel:@c.Phone" class="text-decoration-none text-body">
                                                <i class="bi bi-telephone me-1 text-muted"></i>@c.Phone
                                            </a>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small">
                                            <span class="badge bg-light text-dark border">@(c.AreaName ?? "No Area")</span>
                                            @if (!string.IsNullOrEmpty(c.SubAreaName))
                                            {
                                                <span class="badge bg-light text-muted border ms-1">@c.SubAreaName</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end fw-semibold">@c.CreditLimit.ToString("N2")</td>
                                    <td class="text-end fw-bold @(c.OutstandingReceivable > 0 ? "text-danger" : "text-success")">
                                        @c.OutstandingReceivable.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (c.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@c.CustomerID" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@c.CustomerID" class="btn btn-outline-primary" title="Edit Customer">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" onclick="confirmDelete(@c.CustomerID, '@c.ShopName')" title="Delete Customer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (Model.Customers != null && Model.Customers.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                    Showing @(((Model.Customers.PageNumber - 1) * Model.Customers.PageSize) + 1) to @Math.Min(Model.Customers.PageNumber * Model.Customers.PageSize, Model.Customers.TotalCount) of @Model.Customers.TotalCount customers
                </div>
                <nav aria-label="Customer pagination">
                    <ul class="pagination pagination-sm m-0">
                        <li class="page-item @(!Model.Customers.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-AreaID="@Model.Filter.AreaID"
                               asp-route-SubAreaID="@Model.Filter.SubAreaID"
                               asp-route-IsActive="@Model.Filter.IsActive"
                               asp-route-PageNumber="@(Model.Customers.PageNumber - 1)">Previous</a>
                        </li>

                        @for (int p = 1; p <= Model.Customers.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Customers.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-AreaID="@Model.Filter.AreaID"
                                   asp-route-SubAreaID="@Model.Filter.SubAreaID"
                                   asp-route-IsActive="@Model.Filter.IsActive"
                                   asp-route-PageNumber="@p">@p</a>
                            </li>
                        }

                        <li class="page-item @(!Model.Customers.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-AreaID="@Model.Filter.AreaID"
                               asp-route-SubAreaID="@Model.Filter.SubAreaID"
                               asp-route-IsActive="@Model.Filter.IsActive"
                               asp-route-PageNumber="@(Model.Customers.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Form -->
<form id="deleteForm" method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" id="deleteCustomerId" name="id" value="" />
</form>

@section Scripts {
    <script>
        // Cascading SubArea dropdown on Area filter change
        document.getElementById('filterAreaSelect').addEventListener('change', function () {
            const areaId = this.value;
            const subAreaSelect = document.getElementById('filterSubAreaSelect');
            subAreaSelect.innerHTML = '<option value="">-- All Sub-Areas --</option>';

            if (areaId) {
                fetch(`/Customers/GetSubAreas?areaId=${areaId}`)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(sa => {
                            const option = document.createElement('option');
                            option.value = sa.id;
                            option.textContent = sa.name;
                            subAreaSelect.appendChild(option);
                        });
                    });
            }
        });

        function confirmDelete(id, shopName) {
            if (confirm(`Are you sure you want to delete customer '${shopName}'?`)) {
                document.getElementById('deleteCustomerId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
