@model InventorySystem.ViewModels.Customers.EditCustomerViewModel

@{
    ViewData["Title"] = $"Edit Customer - {Model.ShopName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/invoice-form.css" asp-append-version="true" />
}

<div class="invoice-form">
    <div class="if-page-head">
        <div class="if-page-head-main">
            <nav class="if-breadcrumb" aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </nav>
            <div class="if-title-row mt-1">
                <span class="if-title-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
                <h1 class="if-page-title">Edit Customer</h1>
            </div>
            <span class="if-company-chip"><i class="bi bi-shop"></i>@Model.ShopName</span>
        </div>
        <div class="if-page-actions">
            <a asp-action="Index" class="if-btn if-btn-outline if-btn-sm">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <form asp-action="Edit" method="post" id="editCustomerForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CustomerID" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

        <section class="if-card" aria-label="Shop profile">
            <div class="if-card-head">
                <h2 class="if-card-title"><i class="bi bi-shop"></i> Shop Profile</h2>
            </div>
            <div class="if-card-body">
                <div class="if-grid">
                    <div class="if-field if-field--6">
                        <label asp-for="ShopName" class="if-label"></label> <span class="text-danger">*</span>
                        <input asp-for="ShopName" class="form-control" id="shopNameInput" />
                        <span asp-validation-for="ShopName" class="text-danger small"></span>
                        <div id="shopNameCheckResult" class="small mt-1"></div>
                    </div>
                    <div class="if-field if-field--6">
                        <label asp-for="OwnerName" class="if-label"></label>
                        <input asp-for="OwnerName" class="form-control" />
                        <span asp-validation-for="OwnerName" class="text-danger small"></span>
                    </div>
                    <div class="if-field if-field--6">
                        <label asp-for="Phone" class="if-label"></label>
                        <input asp-for="Phone" class="form-control" id="phoneInput" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                        <div id="phoneCheckResult" class="small mt-1"></div>
                    </div>
                    <div class="if-field if-field--6">
                        <label asp-for="TaxID" class="if-label"></label>
                        <input asp-for="TaxID" class="form-control" />
                        <span asp-validation-for="TaxID" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="if-card" aria-label="Location">
            <div class="if-card-head">
                <h2 class="if-card-title"><i class="bi bi-geo-alt"></i> Location</h2>
            </div>
            <div class="if-card-body">
                <div class="if-grid">
                    <div class="if-field if-field--6">
                        <label asp-for="AreaID" class="if-label"></label>
                        <select asp-for="AreaID" class="form-select" id="areaSelect" asp-items="Model.Areas">
                            <option value="">-- Select Area --</option>
                        </select>
                        <span asp-validation-for="AreaID" class="text-danger small"></span>
                    </div>
                    <div class="if-field if-field--6">
                        <label asp-for="SubAreaID" class="if-label"></label>
                        <select asp-for="SubAreaID" class="form-select" id="subAreaSelect" asp-items="Model.SubAreas">
                            <option value="">-- Select Sub-Area --</option>
                        </select>
                        <span asp-validation-for="SubAreaID" class="text-danger small"></span>
                    </div>
                    <div class="if-field if-field--12">
                        <label asp-for="Address" class="if-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="if-card" aria-label="Financial settings">
            <div class="if-card-head">
                <h2 class="if-card-title"><i class="bi bi-wallet2"></i> Financial &amp; Credit</h2>
            </div>
            <div class="if-card-body">
                <div class="if-grid">
                    <div class="if-field">
                        <label asp-for="CreditLimit" class="if-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">PKR</span>
                            <input asp-for="CreditLimit" class="form-control" type="number" step="1000" min="0" />
                        </div>
                        <span asp-validation-for="CreditLimit" class="text-danger small"></span>
                    </div>
                    <div class="if-field">
                        <label asp-for="PreferredDiscountPercent" class="if-label"></label>
                        <div class="input-group">
                            <input asp-for="PreferredDiscountPercent" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="Optional" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="PreferredDiscountPercent" class="text-danger small"></span>
                    </div>
                    <div class="if-field d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">Active Customer</label>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="if-footer-bar">
            <a asp-action="Index" class="if-btn if-btn-outline">Cancel</a>
            <button type="submit" class="if-btn if-btn-primary if-btn-lg">
                <i class="bi bi-save"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function populateCustomerSubAreas(areaId, selectedSubAreaId) {
            const subAreaSelect = document.getElementById('subAreaSelect');
            if (!subAreaSelect) return;

            subAreaSelect.innerHTML = '<option value="">-- Select Sub-Area --</option>';

            const finish = function () {
                if (selectedSubAreaId) {
                    subAreaSelect.value = String(selectedSubAreaId);
                }
                if (window.WimsSelect2) {
                    window.WimsSelect2.refresh(subAreaSelect);
                }
            };

            if (!areaId) {
                finish();
                return;
            }

            fetch(`/Customers/GetSubAreas?areaId=${encodeURIComponent(areaId)}`)
                .then(function (res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(function (data) {
                    (Array.isArray(data) ? data : []).forEach(function (sa) {
                        const id = sa.id ?? sa.Id;
                        const name = sa.name ?? sa.Name;
                        if (id == null || id === '') return;
                        const opt = document.createElement('option');
                        opt.value = id;
                        opt.textContent = name;
                        if (selectedSubAreaId && String(id) === String(selectedSubAreaId)) {
                            opt.selected = true;
                        }
                        subAreaSelect.appendChild(opt);
                    });
                    finish();
                })
                .catch(function (err) {
                    console.error('Failed to load sub-areas:', err);
                    finish();
                });
        }

        $('#areaSelect').on('change', function () {
            populateCustomerSubAreas($(this).val(), null);
        });

        document.getElementById('shopNameInput').addEventListener('blur', function () {
            const val = this.value.trim();
            const customerId = @Model.CustomerID;
            const resDiv = document.getElementById('shopNameCheckResult');
            if (val) {
                fetch(`/Customers/CheckShopName?shopName=${encodeURIComponent(val)}&excludeCustomerId=${customerId}`)
                    .then(res => res.json())
                    .then(isUnique => {
                        if (!isUnique) {
                            resDiv.className = 'small text-danger mt-1';
                            resDiv.textContent = 'This shop name is already taken.';
                        } else {
                            resDiv.className = 'small text-success mt-1';
                            resDiv.textContent = 'Shop name is available.';
                        }
                    });
            } else {
                resDiv.textContent = '';
            }
        });

        document.getElementById('phoneInput').addEventListener('blur', function () {
            const val = this.value.trim();
            const customerId = @Model.CustomerID;
            const resDiv = document.getElementById('phoneCheckResult');
            if (val) {
                fetch(`/Customers/CheckPhone?phone=${encodeURIComponent(val)}&excludeCustomerId=${customerId}`)
                    .then(res => res.json())
                    .then(isUnique => {
                        if (!isUnique) {
                            resDiv.className = 'small text-danger mt-1';
                            resDiv.textContent = 'This phone number is already registered.';
                        } else {
                            resDiv.className = 'small text-success mt-1';
                            resDiv.textContent = 'Phone number is available.';
                        }
                    });
            } else {
                resDiv.textContent = '';
            }
        });
    </script>
}
