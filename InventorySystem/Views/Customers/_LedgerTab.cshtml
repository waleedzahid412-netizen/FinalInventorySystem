@model InventorySystem.DTOs.Common.PagedResult<InventorySystem.DTOs.Customers.CustomerLedgerEntryDto>
@{
    decimal customerReceivable = ViewBag.CustomerReceivable ?? 0m;
    decimal amountOwedToCustomer = ViewBag.AmountOwedToCustomer ?? 0m;
}

@if (Model == null || !Model.Items.Any())
{
    <div class="alert alert-info my-3">
        <i class="bi bi-info-circle me-2"></i> No account ledger entries found for this customer.
    </div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm @(customerReceivable > 0 ? "bg-danger" : "bg-light") @(customerReceivable > 0 ? "text-white" : "") h-100">
                <div class="card-body py-3">
                    <div class="@(customerReceivable > 0 ? "text-white-50" : "text-muted") small fw-semibold text-uppercase">Customer Receivables</div>
                    <div class="fs-4 fw-bold mt-1">PKR @customerReceivable.ToString("N2")</div>
                    <div class="@(customerReceivable > 0 ? "text-white-50" : "text-muted") small mt-1">Amount the customer owes you</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm @(amountOwedToCustomer > 0 ? "bg-success" : "bg-light") @(amountOwedToCustomer > 0 ? "text-white" : "") h-100">
                <div class="card-body py-3">
                    <div class="@(amountOwedToCustomer > 0 ? "text-white-50" : "text-muted") small fw-semibold text-uppercase">Amount Owed to Customer</div>
                    <div class="fs-4 fw-bold mt-1">PKR @amountOwedToCustomer.ToString("N2")</div>
                    <div class="@(amountOwedToCustomer > 0 ? "text-white-50" : "text-muted") small mt-1">Amount you owe the customer</div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border small mb-3">
        <i class="bi bi-info-circle me-1 text-primary"></i>
        <strong>Running Balance</strong> is cumulative by event time (newest at top).
        Positive = customer owes you; negative = you owe the customer.
    </div>

    <div class="table-responsive my-3">
        <table class="table table-hover align-middle border">
            <thead class="table-light">
                <tr>
                    <th>Entry ID</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th class="text-end">Debit (Receivable +)</th>
                    <th class="text-end">Credit (Received -)</th>
                    <th class="text-end">Running Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">#CL-@l.CustomerLedgerID.ToString("D5")</td>
                        <td>@l.TransactionDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            @if (l.TransactionType.ToUpper() == "SALE")
                            {
                                <span class="badge bg-primary">SALE</span>
                            }
                            else if (l.TransactionType.ToUpper() == "PAYMENT")
                            {
                                <span class="badge bg-success">PAYMENT</span>
                            }
                            else if (l.TransactionType.ToUpper() == "RETURN")
                            {
                                <span class="badge bg-warning text-dark">RETURN</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@l.TransactionType</span>
                            }
                        </td>
                        <td>@(l.Description ?? "-")</td>
                        <td class="text-end fw-semibold text-danger">@l.DebitAmount.ToString("N2")</td>
                        <td class="text-end fw-semibold text-success">@l.CreditAmount.ToString("N2")</td>
                        <td class="text-end fw-bold @(l.RunningBalance >= 0 ? "text-danger" : "text-success")">
                            @(l.RunningBalance >= 0 ? "+" + l.RunningBalance.ToString("N2") : l.RunningBalance.ToString("N2"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Ledger history pagination">
            <ul class="pagination pagination-sm justify-content-center">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    int currentPage = p;
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <button type="button" class="page-link" onclick="loadLedgerTab(@ViewBag.CustomerID, @currentPage)">@p</button>
                    </li>
                }
            </ul>
        </nav>
    }
}
