@model InventorySystem.ViewModels.Suppliers.SupplierListViewModel
@{
    ViewData["Title"] = "Suppliers";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 fw-bold"><i class="bi bi-truck me-2 text-primary"></i> Suppliers</h1>
            <p class="text-muted small mb-0">Global people who take orders and deliver to customers.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-1"></i> Add Supplier</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-light">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Search by name, phone, or CNIC..." />
                </div>
                <div class="col-md-2">
                    <select name="Type" class="form-select" data-no-select2>
                        <option value="">All types</option>
                        <option value="Employee" selected="@(Model.Filter.Type == "Employee")">Employee</option>
                        <option value="External" selected="@(Model.Filter.Type == "External")">External</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="IsActive" class="form-select" data-no-select2>
                        <option value="">All statuses</option>
                        <option value="true" selected="@(Model.Filter.IsActive == true)">Active</option>
                        <option value="false" selected="@(Model.Filter.IsActive == false)">Inactive</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>CNIC</th>
                        <th>Phone</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Suppliers.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No suppliers found.</td></tr>
                    }
                    @foreach (var supplier in Model.Suppliers.Items)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@supplier.Name</td>
                            <td>@(supplier.CNIC ?? "—")</td>
                            <td>@(supplier.Phone ?? "—")</td>
                            <td>@supplier.Type</td>
                            <td><span class="badge @(supplier.IsActive ? "bg-success" : "bg-secondary")">@(supplier.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@supplier.SupplierID" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@supplier.SupplierID" method="post" class="d-inline" onsubmit="return confirm('Delete this supplier?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
