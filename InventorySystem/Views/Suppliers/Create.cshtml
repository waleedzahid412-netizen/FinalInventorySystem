@model InventorySystem.ViewModels.Suppliers.CreateSupplierViewModel
@{
    ViewData["Title"] = "Add Supplier";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h1 class="h4 fw-bold mb-1"><i class="bi bi-truck text-primary me-2"></i>Add Supplier</h1>
                    <p class="text-muted small mb-0">Global master — available on any company sales invoice.</p>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" placeholder="Full name" autocomplete="name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CNIC" class="form-label fw-semibold"></label>
                                <input asp-for="CNIC" class="form-control" id="supplierCnicInput"
                                       placeholder="12345-1234567-1" maxlength="15" inputmode="numeric" autocomplete="off" />
                                <span asp-validation-for="CNIC" class="text-danger small"></span>
                                <div class="form-text">Format: 5-7-1 digits</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control" placeholder="0300-1234567" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-semibold"></label>
                                <select asp-for="Type" class="form-select" data-no-select2>
                                    <option value="Employee">Employee</option>
                                    <option value="External">External</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold"></label>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Street, area, city…"></textarea>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4 pt-2 border-top">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i>Save Supplier
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function () {
            var el = document.getElementById('supplierCnicInput');
            if (!el) return;
            el.addEventListener('input', function () {
                var digits = (el.value || '').replace(/\D/g, '').slice(0, 13);
                var out = digits;
                if (digits.length > 12) {
                    out = digits.slice(0, 5) + '-' + digits.slice(5, 12) + '-' + digits.slice(12);
                } else if (digits.length > 5) {
                    out = digits.slice(0, 5) + '-' + digits.slice(5);
                }
                el.value = out;
            });
        })();
    </script>
}
