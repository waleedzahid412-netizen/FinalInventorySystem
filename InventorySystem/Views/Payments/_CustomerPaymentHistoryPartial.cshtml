@model IEnumerable<InventorySystem.DTOs.Payments.CustomerPaymentDto>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-light text-center py-4 border my-3">
        <i class="bi bi-info-circle fs-3 text-muted d-block mb-2"></i>
        <p class="text-muted mb-0">No payment receipts recorded for this sales invoice yet.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Payment #</th>
                    <th>Payment Date</th>
                    <th>Method</th>
                    <th>Reference #</th>
                    <th>Recorded By</th>
                    <th class="text-end">Amount Paid</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary">@p.PaymentNumber</td>
                        <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge bg-outline-info text-dark border">
                                <i class="bi bi-credit-card me-1"></i> @p.PaymentMethod
                            </span>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(p.ReferenceNumber) ? "-" : p.ReferenceNumber)</td>
                        <td class="small">@p.ReceivedByUserName</td>
                        <td class="text-end fw-bold text-success">PKR @p.Amount.ToString("N2")</td>
                        <td class="text-center">
                            <a asp-controller="Payments" asp-action="CustomerPaymentReceipt" asp-route-id="@p.CustomerPaymentID" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Print Receipt">
                                <i class="bi bi-printer me-1"></i> Receipt
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
