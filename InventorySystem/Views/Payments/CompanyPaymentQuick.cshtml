@model InventorySystem.ViewModels.Payments.CompanyPaymentListViewModel
@{
    ViewData["Title"] = "Quick Company Payment";
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid px-4 py-3">
    <!-- Header Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold"><i class="bi bi-credit-card text-success me-2"></i> Streamlined Company Payment</h1>
            <p class="text-muted small mb-0">Record payments to companies for purchase invoices or account debits.</p>
        </div>
        <div>
            <a asp-action="CompanyPayments" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Payment History
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT: COMPANY SELECTION & UNPAID PURCHASE INVOICES -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-success"><i class="bi bi-building me-2"></i> Step 1: Select Company</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="selectPayCompany" class="form-label fw-bold small">Company <span class="text-danger">*</span></label>
                        <select id="selectPayCompany" class="form-select">
                            <option value="">-- Select Company --</option>
                            @foreach (var c in Model.Companies)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- UNPAID PURCHASE INVOICES TABLE CARD -->
            <div id="unpaidCompanyInvoicesCard" class="card shadow-sm border-0 mb-4 d-none">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-success"><i class="bi bi-cart-check me-2"></i> Step 2: Unpaid Purchase Invoices</h6>
                    <span class="badge bg-danger" id="unpaidCompanyInvoiceBadge">0 Unpaid</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="unpaidCompanyInvoicesTable" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;" class="text-center">Pay</th>
                                    <th>Invoice #</th>
                                    <th>Date</th>
                                    <th class="text-end">Grand Total ($)</th>
                                    <th class="text-end">Balance Due ($)</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: PAYMENT DETAILS & SUBMIT -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="bi bi-cash-stack me-2"></i> Company Payment Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="inputCompanyPaymentAmount" class="form-label fw-bold small">Payment Amount ($) <span class="text-danger">*</span></label>
                        <input type="number" id="inputCompanyPaymentAmount" min="0.01" step="0.01" class="form-control form-control-lg text-end fw-bold text-success" value="0.00" />
                    </div>

                    <div class="mb-3">
                        <label for="selectCompanyPaymentMethod" class="form-label fw-bold small">Payment Method <span class="text-danger">*</span></label>
                        <select id="selectCompanyPaymentMethod" class="form-select" data-no-select2>
                            <option value="Cash">Cash</option>
                            <option value="BankTransfer">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <!-- CHEQUE DETAILS FIELDS -->
                    <div id="companyChequeFieldsContainer" class="p-3 bg-light rounded border mb-3 d-none">
                        <h6 class="fw-bold small text-muted mb-2"><i class="bi bi-card-heading me-1"></i> Cheque Details</h6>
                        <div class="mb-2">
                            <label for="inputCompanyChequeNumber" class="form-label small">Cheque Number</label>
                            <input type="text" id="inputCompanyChequeNumber" class="form-control form-control-sm" placeholder="e.g. CHQ-10029" />
                        </div>
                        <div class="mb-2">
                            <label for="inputCompanyChequeDate" class="form-label small">Cheque Date</label>
                            <input type="date" id="inputCompanyChequeDate" class="form-control form-control-sm" />
                        </div>
                        <div>
                            <label for="inputCompanyBankName" class="form-label small">Bank Name</label>
                            <input type="text" id="inputCompanyBankName" class="form-control form-control-sm" placeholder="e.g. HBL / Meezan" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="inputCompanyPaymentRemarks" class="form-label fw-bold small">Remarks / Notes</label>
                        <textarea id="inputCompanyPaymentRemarks" class="form-control" rows="2" placeholder="Optional payment reference..."></textarea>
                    </div>

                    <div class="d-grid">
                        <button type="button" id="btnSubmitCompanyPayment" class="btn btn-success btn-lg fw-bold shadow-sm">
                            <i class="bi bi-check-circle-fill me-2"></i> Record Company Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#selectPayCompany').on('change', function () {
                const compId = $(this).val();
                if (!compId) {
                    $('#unpaidCompanyInvoicesCard').addClass('d-none');
                    return;
                }

                $.getJSON('/Payments/GetUnpaidCompanyInvoices', { companyId: compId }, function (invoices) {
                    const $tbody = $('#unpaidCompanyInvoicesTable tbody').empty();
                    if (invoices && invoices.length > 0) {
                        $('#unpaidCompanyInvoiceBadge').text(`${invoices.length} Unpaid`);
                        invoices.forEach(inv => {
                            $tbody.append(`
                                <tr>
                                    <td class="text-center">
                                        <input type="radio" name="selectedCompanyInvoiceRadio" class="form-check-input rad-pay-company-invoice" data-invoice-id="${inv.purchaseInvoiceID}" data-balance="${inv.remainingBalance}" />
                                    </td>
                                    <td class="fw-bold">${inv.invoiceNumber}</td>
                                    <td>${new Date(inv.invoiceDate).toLocaleDateString()}</td>
                                    <td class="text-end">$${inv.grandTotal.toFixed(2)}</td>
                                    <td class="text-end fw-bold text-danger">$${inv.remainingBalance.toFixed(2)}</td>
                                </tr>
                            `);
                        });
                    } else {
                        $('#unpaidCompanyInvoiceBadge').text('0 Unpaid');
                        $tbody.append('<tr><td colspan="5" class="text-center py-3 text-muted">No unpaid invoices found for this company.</td></tr>');
                    }
                    $('#unpaidCompanyInvoicesCard').removeClass('d-none');
                });
            });

            $(document).on('change', '.rad-pay-company-invoice', function () {
                const bal = parseFloat($(this).data('balance')) || 0;
                if (bal > 0) {
                    $('#inputCompanyPaymentAmount').val(bal.toFixed(2));
                }
            });

            $('#selectCompanyPaymentMethod').on('change', function () {
                if ($(this).val() === 'Cheque') {
                    $('#companyChequeFieldsContainer').removeClass('d-none');
                } else {
                    $('#companyChequeFieldsContainer').addClass('d-none');
                }
            });

            $('#btnSubmitCompanyPayment').on('click', function () {
                const compId = parseInt($('#selectPayCompany').val());
                const amount = parseFloat($('#inputCompanyPaymentAmount').val()) || 0;
                const method = $('#selectCompanyPaymentMethod').val();

                if (!compId || amount <= 0) {
                    alert('Please select a company and enter a positive payment amount.');
                    return;
                }

                const selectedInvoice = $('.rad-pay-company-invoice:checked').first();
                const invoiceId = selectedInvoice.length > 0 ? parseInt(selectedInvoice.data('invoice-id')) : null;

                const payload = {
                    companyID: compId,
                    purchaseInvoiceID: invoiceId,
                    amount: amount,
                    paymentMethod: method,
                    chequeNumber: $('#inputCompanyChequeNumber').val(),
                    chequeDate: $('#inputCompanyChequeDate').val() ? new Date($('#inputCompanyChequeDate').val()).toISOString() : null,
                    bankName: $('#inputCompanyBankName').val(),
                    remarks: $('#inputCompanyPaymentRemarks').val()
                };

                const $btn = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Processing Payment...');

                $.ajax({
                    url: '/Payments/RecordCompanyPayment',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    success: function (res) {
                        if (res.success) {
                            alert('Company payment recorded successfully.');
                            window.location.href = '/Payments/CompanyPayments';
                        } else {
                            alert(res.message || 'Error recording company payment.');
                            $btn.prop('disabled', false).html('<i class="bi bi-check-circle-fill me-2"></i> Record Company Payment');
                        }
                    }
                });
            });
        });
    </script>
}
