@model InventorySystem.ViewModels.Payments.CustomerPaymentListViewModel
@{
    ViewData["Title"] = "Quick Customer Payment";
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid px-4 py-3">
    <!-- Header Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold"><i class="bi bi-wallet2 text-info me-2"></i> Streamlined Customer Payment</h1>
            <p class="text-muted small mb-0">Record payments against customer invoices or post direct account credits.</p>
        </div>
        <div>
            <a asp-action="CustomerPayments" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Payment History
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT: CUSTOMER SELECTION & UNPAID INVOICES -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-person-check me-2"></i> Step 1: Select Customer</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="selectPayCustomer" class="form-label fw-bold small">Customer <span class="text-danger">*</span></label>
                        <select id="selectPayCustomer" class="form-select">
                            <option value="">-- Select Customer --</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- UNPAID INVOICES SELECTION TABLE CARD -->
            <div id="unpaidInvoicesCard" class="card shadow-sm border-0 mb-4 d-none">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-receipt-cutoff me-2"></i> Step 2: Unpaid Sales Invoices</h6>
                    <span class="badge bg-danger" id="unpaidInvoiceBadge">0 Unpaid</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="unpaidInvoicesTable" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;" class="text-center">Pay</th>
                                    <th>Invoice #</th>
                                    <th>Date</th>
                                    <th class="text-end">Grand Total ($)</th>
                                    <th class="text-end">Balance Due ($)</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: PAYMENT DETAILS & SUBMIT -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-info text-dark py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="bi bi-credit-card me-2"></i> Payment Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="inputPaymentAmount" class="form-label fw-bold small">Payment Amount ($) <span class="text-danger">*</span></label>
                        <input type="number" id="inputPaymentAmount" min="0.01" step="0.01" class="form-control form-control-lg text-end fw-bold text-success" value="0.00" />
                    </div>

                    <div class="mb-3">
                        <label for="selectPaymentMethod" class="form-label fw-bold small">Payment Method <span class="text-danger">*</span></label>
                        <select id="selectPaymentMethod" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="BankTransfer">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <!-- CHEQUE DETAILS FIELDS -->
                    <div id="chequeFieldsContainer" class="p-3 bg-light rounded border mb-3 d-none">
                        <h6 class="fw-bold small text-muted mb-2"><i class="bi bi-card-heading me-1"></i> Cheque Details</h6>
                        <div class="mb-2">
                            <label for="inputChequeNumber" class="form-label small">Cheque Number</label>
                            <input type="text" id="inputChequeNumber" class="form-control form-control-sm" placeholder="e.g. CHQ-99482" />
                        </div>
                        <div class="mb-2">
                            <label for="inputChequeDate" class="form-label small">Cheque Date</label>
                            <input type="date" id="inputChequeDate" class="form-control form-control-sm" />
                        </div>
                        <div>
                            <label for="inputBankName" class="form-label small">Bank Name</label>
                            <input type="text" id="inputBankName" class="form-control form-control-sm" placeholder="e.g. HBL / Meezan" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="inputPaymentRemarks" class="form-label fw-bold small">Remarks / Notes</label>
                        <textarea id="inputPaymentRemarks" class="form-control" rows="2" placeholder="Optional payment reference..."></textarea>
                    </div>

                    <div class="d-grid">
                        <button type="button" id="btnSubmitPayment" class="btn btn-info btn-lg text-dark fw-bold shadow-sm">
                            <i class="bi bi-check-circle-fill me-2"></i> Record Customer Payment
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#selectPayCustomer').on('change', function () {
                const custId = $(this).val();
                if (!custId) {
                    $('#unpaidInvoicesCard').addClass('d-none');
                    return;
                }

                $.getJSON('/Payments/GetUnpaidCustomerInvoices', { customerId: custId }, function (invoices) {
                    const $tbody = $('#unpaidInvoicesTable tbody').empty();
                    if (invoices && invoices.length > 0) {
                        $('#unpaidInvoiceBadge').text(`${invoices.length} Unpaid`);
                        invoices.forEach(inv => {
                            $tbody.append(`
                                <tr>
                                    <td class="text-center">
                                        <input type="radio" name="selectedInvoiceRadio" class="form-check-input rad-pay-invoice" data-invoice-id="${inv.salesInvoiceID}" data-balance="${inv.remainingBalance}" />
                                    </td>
                                    <td class="fw-bold">${inv.invoiceNumber}</td>
                                    <td>${new Date(inv.invoiceDate).toLocaleDateString()}</td>
                                    <td class="text-end">$${inv.grandTotal.toFixed(2)}</td>
                                    <td class="text-end fw-bold text-danger">$${inv.remainingBalance.toFixed(2)}</td>
                                </tr>
                            `);
                        });
                    } else {
                        $('#unpaidInvoiceBadge').text('0 Unpaid');
                        $tbody.append('<tr><td colspan="5" class="text-center py-3 text-muted">No unpaid invoices found for this customer.</td></tr>');
                    }
                    $('#unpaidInvoicesCard').removeClass('d-none');
                });
            });

            $(document).on('change', '.rad-pay-invoice', function () {
                const bal = parseFloat($(this).data('balance')) || 0;
                if (bal > 0) {
                    $('#inputPaymentAmount').val(bal.toFixed(2));
                }
            });

            $('#selectPaymentMethod').on('change', function () {
                if ($(this).val() === 'Cheque') {
                    $('#chequeFieldsContainer').removeClass('d-none');
                } else {
                    $('#chequeFieldsContainer').addClass('d-none');
                }
            });

            $('#btnSubmitPayment').on('click', function () {
                const custId = parseInt($('#selectPayCustomer').val());
                const amount = parseFloat($('#inputPaymentAmount').val()) || 0;
                const method = $('#selectPaymentMethod').val();

                if (!custId || amount <= 0) {
                    alert('Please select a customer and enter a positive payment amount.');
                    return;
                }

                const selectedInvoice = $('.rad-pay-invoice:checked').first();
                const invoiceId = selectedInvoice.length > 0 ? parseInt(selectedInvoice.data('invoice-id')) : null;

                const payload = {
                    customerID: custId,
                    salesInvoiceID: invoiceId,
                    amount: amount,
                    paymentMethod: method,
                    chequeNumber: $('#inputChequeNumber').val(),
                    chequeDate: $('#inputChequeDate').val() ? new Date($('#inputChequeDate').val()).toISOString() : null,
                    bankName: $('#inputBankName').val(),
                    remarks: $('#inputPaymentRemarks').val()
                };

                const $btn = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Processing Payment...');

                $.ajax({
                    url: '/Payments/RecordCustomerPayment',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    success: function (res) {
                        if (res.success) {
                            alert('Customer payment recorded successfully.');
                            window.location.href = '/Payments/CustomerPayments';
                        } else {
                            alert(res.message || 'Error recording customer payment.');
                            $btn.prop('disabled', false).html('<i class="bi bi-check-circle-fill me-2"></i> Record Customer Payment');
                        }
                    }
                });
            });
        });
    </script>
}
