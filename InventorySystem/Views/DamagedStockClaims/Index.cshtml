@model InventorySystem.ViewModels.DamagedStockClaims.DamagedStockClaimIndexViewModel
@using InventorySystem.Constants
@{
    ViewData["Title"] = "Damaged Stock Claims";
    string StatusBadge(string status) => status switch
    {
        DamagedStockClaimStatuses.PendingSupplierConfirmation => "bg-warning text-dark",
        DamagedStockClaimStatuses.PartiallyAccepted => "bg-info text-dark",
        DamagedStockClaimStatuses.Accepted => "bg-success",
        DamagedStockClaimStatuses.Rejected => "bg-danger",
        DamagedStockClaimStatuses.Closed => "bg-secondary",
        _ => "bg-light text-dark"
    };
    string SettleBadge(string status) => status switch
    {
        DamagedStockSettlementStatuses.Settled => "bg-success",
        DamagedStockSettlementStatuses.PartiallySettled => "bg-info text-dark",
        DamagedStockSettlementStatuses.Pending => "bg-warning text-dark",
        DamagedStockSettlementStatuses.NotRequired => "bg-secondary",
        _ => "bg-light text-dark"
    };
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-exclamation-diamond me-2 text-primary"></i>Damaged Stock Claims
            </h1>
            <p class="text-muted small mb-0">
                Supplier claims for damaged stock —
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">@Model.ScopeLabel</span>
            </p>
        </div>
        <div class="mt-2 mt-md-0">
            <a asp-action="Create" class="btn btn-primary shadow-sm btn-sm">
                <i class="bi bi-plus-lg me-1"></i> New Claim
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Search</label>
                    <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Claim # or company..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Claim Status</label>
                    <select name="ClaimStatus" class="form-select form-select-sm" asp-items="Model.ClaimStatuses">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Settlement</label>
                    <select name="SettlementStatus" class="form-select form-select-sm" asp-items="Model.SettlementStatuses">
                        <option value="">All</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">From</label>
                    <input type="date" name="FromDate" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">To</label>
                    <input type="date" name="ToDate" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Claim Number</th>
                            <th>Claim Date</th>
                            <th>Company</th>
                            <th class="text-end">Products</th>
                            <th class="text-end">Claimed Qty</th>
                            <th class="text-end">Claim Amount</th>
                            <th>Claim Status</th>
                            <th>Settlement</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Claims.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">No damaged stock claims found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model.Claims)
                        {
                            <tr>
                                <td class="fw-semibold">@c.ClaimNumber</td>
                                <td>@c.ClaimDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@c.CompanyName</td>
                                <td class="text-end">@c.TotalProducts</td>
                                <td class="text-end">@c.TotalClaimedQuantity.ToString("N3")</td>
                                <td class="text-end">@c.TotalClaimAmount.ToString("N2")</td>
                                <td><span class="badge @StatusBadge(c.ClaimStatus)">@c.ClaimStatus</span></td>
                                <td><span class="badge @SettleBadge(c.SettlementStatus)">@c.SettlementStatus</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@c.DamagedStockClaimID" class="btn btn-outline-primary btn-sm">View</a>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white text-muted small">
            Showing @Model.Claims.Count of @Model.TotalCount claim(s)
        </div>
    </div>
</div>
