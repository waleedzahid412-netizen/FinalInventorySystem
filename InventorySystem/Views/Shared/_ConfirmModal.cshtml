<div class="modal fade" id="wimsConfirmModal" tabindex="-1" aria-labelledby="wimsConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white" id="wimsConfirmHeader">
                <h5 class="modal-title" id="wimsConfirmTitle">Confirm action</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="wimsConfirmMessage">Are you sure you want to continue?</p>
                <ul class="mb-0 mt-2 d-none" id="wimsConfirmDetails"></ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="wimsConfirmCancel">Cancel</button>
                <button type="button" class="btn btn-primary" id="wimsConfirmOk">Confirm</button>
            </div>
        </div>
    </div>
</div>
