@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-5 text-center">
    <div class="card border-0 shadow-sm col-lg-6 mx-auto">
        <div class="card-body p-5">
            <i class="bi bi-shield-lock text-danger display-4 mb-3"></i>
            <h1 class="h3 fw-bold mb-2">Access Denied</h1>
            <p class="text-muted mb-4">You do not have permission to perform this action. Contact your administrator if you need access.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>
