@model InventorySystem.ViewModels.UserManagement.CreateUserViewModel
@using InventorySystem.Constants
@{
    ViewData["Title"] = "Create User";
    var adminRoleId = Model.Roles.FirstOrDefault(r => r.RoleName == RoleNames.Admin)?.RoleID ?? 0;
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-person-plus me-2 text-primary"></i>Create User
            </h1>
            <p class="text-muted small mb-0">Add a new user and assign company permissions.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Users
        </a>
    </div>

    <div class="card border-0 shadow-sm col-lg-8 mx-auto">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="createUserForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="Username" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">@ViewBag.PasswordRequirements</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RoleID" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <select asp-for="RoleID" class="form-select" id="roleSelect" data-no-select2="true">
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.RoleID">@role.RoleName</option>
                            }
                        </select>
                        <span asp-validation-for="RoleID" class="text-danger small"></span>
                    </div>
                </div>

                <partial name="_CompanyAssignmentSelect" model="Model.CompanyIds" view-data="@(new ViewDataDictionary(ViewData) { { "CompanyOptions", Model.Companies } })" />

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var roleSelect = document.getElementById('roleSelect');
            var companySection = document.getElementById('companyPermissionsSection');
            var companySelect = document.getElementById('companySelect');
            var adminRoleId = '@adminRoleId';

            function initCompanySelect2() {
                if (!companySelect || !window.WimsSelect2) {
                    return;
                }
                window.WimsSelect2.destroy(companySelect);
                window.WimsSelect2.initOne(companySelect, { closeOnSelect: false });
            }

            function toggleCompanySection() {
                var isAdmin = roleSelect.value === adminRoleId;
                companySection.style.display = isAdmin ? 'none' : 'block';

                if (!companySelect) {
                    return;
                }

                var $companySelect = window.jQuery(companySelect);
                $companySelect.prop('disabled', isAdmin);
                if (isAdmin) {
                    $companySelect.val(null);
                }
                if (window.WimsSelect2) {
                    window.WimsSelect2.sync(companySelect);
                }
            }

            if (window.jQuery) {
                jQuery(initCompanySelect2);
            }
            roleSelect.addEventListener('change', toggleCompanySection);
            toggleCompanySection();
        })();
    </script>
}
