@model InventorySystem.ViewModels.UserManagement.UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-person-vcard me-2 text-primary"></i>User Details
            </h1>
            <p class="text-muted small mb-0">View account information and company access.</p>
        </div>
        <div class="d-flex gap-2">
            @if (PermCtx.CanEdit(PageKeys.Users))
            {
                <a asp-action="Edit" asp-route-id="@Model.UserID" class="btn btn-primary shadow-sm">
                    <i class="bi bi-pencil me-1"></i>Edit User
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to Users
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm col-lg-8">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Full Name</dt>
                <dd class="col-sm-9 fw-semibold">@Model.FullName</dd>

                <dt class="col-sm-3 text-muted">Username</dt>
                <dd class="col-sm-9">@Model.Username</dd>

                <dt class="col-sm-3 text-muted">Phone</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd>

                <dt class="col-sm-3 text-muted">Role</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary-subtle text-secondary">@Model.RoleName</span>
                </dd>

                <dt class="col-sm-3 text-muted">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3 text-muted">Companies</dt>
                <dd class="col-sm-9">
                    @if (Model.CompanyNames.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var company in Model.CompanyNames)
                            {
                                <span class="badge text-bg-light border">@company</span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">No companies assigned</span>
                    }
                </dd>
            </dl>
        </div>
    </div>
</div>
