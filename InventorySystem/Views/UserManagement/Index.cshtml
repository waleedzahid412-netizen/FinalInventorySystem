@model InventorySystem.ViewModels.UserManagement.UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-people-fill me-2 text-primary"></i> User Management
            </h1>
            <p class="text-muted small mb-0">Create users, assign company permissions, and manage access.</p>
        </div>
        <div>
            @if (PermCtx.CanAdd(PageKeys.Users))
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-person-plus me-1"></i> Create User
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold small text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="Search by name, username, or phone..." />
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Full Name</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Companies</th>
                            <th class="text-center">Status</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Items.Any())
                        {
                            foreach (var user in Model.Users.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@user.FullName</td>
                                    <td>@user.Username</td>
                                    <td><span class="badge bg-secondary-subtle text-secondary">@user.RoleName</span></td>
                                    <td>
                                        @if (user.CompanyNames.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var company in user.CompanyNames)
                                                {
                                                    <span class="badge text-bg-light border">@company</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No companies assigned</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            @if (PermCtx.CanView(PageKeys.Users))
                                            {
                                                <a asp-action="Details" asp-route-id="@user.UserID" class="btn btn-outline-info" title="View user">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            }
                                            @if (PermCtx.CanEdit(PageKeys.Users))
                                            {
                                                <a asp-action="Edit" asp-route-id="@user.UserID" class="btn btn-outline-secondary" title="Edit user">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (PermCtx.CanDelete(PageKeys.Users))
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-delete-user" data-id="@user.UserID" data-name="@user.FullName" title="Delete user">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                                    No users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Users.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted">
                    Showing @(((Model.Users.PageNumber - 1) * Model.Users.PageSize) + 1) to @(Math.Min(Model.Users.PageNumber * Model.Users.PageSize, Model.Users.TotalCount)) of @Model.Users.TotalCount users
                </span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.Users.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.Users.PageNumber - 1)" asp-route-SearchTerm="@Model.Filter.SearchTerm">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.Users.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Users.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-PageNumber="@i" asp-route-SearchTerm="@Model.Filter.SearchTerm">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.Users.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@(Model.Users.PageNumber + 1)" asp-route-SearchTerm="@Model.Filter.SearchTerm">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteUserModalLabel"><i class="bi bi-exclamation-triangle me-2"></i>Delete User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user <strong id="deleteUserName"></strong>?</p>
                <p class="small text-muted mb-0">This is a soft delete. The account will be deactivated and removed from the list.</p>
            </div>
            <div class="modal-footer">
                <form id="deleteUserForm" method="post" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteUserId" name="id" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete-user').forEach(btn => {
            btn.addEventListener('click', function () {
                document.getElementById('deleteUserId').value = this.getAttribute('data-id');
                document.getElementById('deleteUserName').textContent = this.getAttribute('data-name');
                new bootstrap.Modal(document.getElementById('deleteUserModal')).show();
            });
        });
    </script>
}
