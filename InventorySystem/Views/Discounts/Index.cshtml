@model IEnumerable<InventorySystem.ViewModels.Discounts.DiscountListViewModel>

@{
    ViewData["Title"] = "Order Discount Rules";
}

<div class="container-fluid py-4">
    <!-- Header & Action Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Order Discount Rules</h1>
            <p class="text-muted small mb-0">Manage order-value threshold discount rules (percentage or fixed amount off).</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create Discount Rule
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4">Priority</th>
                            <th>Rule Name</th>
                            <th>Order Threshold</th>
                            <th>Discount</th>
                            <th>Valid Dates</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-percent fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No discount rules defined yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var now = DateTime.UtcNow;
                                bool isCurrentlyValid = item.IsActive &&
                                                        (!item.StartDate.HasValue || item.StartDate <= now) &&
                                                        (!item.EndDate.HasValue || item.EndDate >= now);

                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-secondary rounded-pill">#@item.Priority</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.RuleName</div>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-primary">PKR @item.MinimumOrderAmount.ToString("N2")</span>
                                        @if (item.MaximumOrderAmount.HasValue)
                                        {
                                            <span class="text-muted small"> to PKR @item.MaximumOrderAmount.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">+</span>
                                        }
                                    </td>
                                    <td>
                                        @if (string.Equals(item.DiscountType, "Percentage", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-info text-dark font-monospace fs-6">@item.DiscountValue% Off</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success font-monospace fs-6">PKR @item.DiscountValue.ToString("N2") Off</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.StartDate.HasValue || item.EndDate.HasValue)
                                        {
                                            <span class="small text-dark">
                                                @(item.StartDate?.ToString("dd MMM yyyy") ?? "Any") — @(item.EndDate?.ToString("dd MMM yyyy") ?? "No Expiry")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border">Always Effective</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            if (isCurrentlyValid)
                                            {
                                                <span class="badge bg-success shadow-sm"><i class="bi bi-check-circle me-1"></i> Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Scheduled / Expired</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Disabled</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@item.DiscountRuleID" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.DiscountRuleID" class="btn btn-sm btn-outline-primary" title="Edit Discount Rule">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.DiscountRuleID" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                @if (item.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Disable Rule">
                                                        <i class="bi bi-slash-circle"></i> Disable
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Enable Rule">
                                                        <i class="bi bi-check-circle"></i> Enable
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
