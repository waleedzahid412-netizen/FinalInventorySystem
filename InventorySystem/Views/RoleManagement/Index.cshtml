@model InventorySystem.ViewModels.Roles.RoleListViewModel
@{
    ViewData["Title"] = "Roles";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-shield-lock me-2 text-primary"></i>Roles
            </h1>
            <p class="text-muted small mb-0">Manage roles and module permissions.</p>
        </div>
        @if (PermCtx.CanAdd(PageKeys.Roles))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i>Add Role
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Role Name</th>
                        <th>Description</th>
                        <th>Permissions</th>
                        <th>Active Users</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model.Roles)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">
                                @role.RoleName
                                @if (role.IsSystemRole)
                                {
                                    <span class="badge bg-secondary ms-1">System</span>
                                }
                            </td>
                            <td>@(role.RoleDescription ?? "—")</td>
                            <td>
                                @if (role.HasFullAccess)
                                {
                                    <span class="badge bg-primary-subtle text-primary">Full access</span>
                                }
                                else if (role.GrantedPageCount > 0)
                                {
                                    <span class="badge bg-info-subtle text-info">@role.GrantedPageCount page@(role.GrantedPageCount == 1 ? "" : "s")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No permissions</span>
                                }
                            </td>
                            <td>@role.ActiveUserCount</td>
                            <td>
                                @if (role.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (PermCtx.CanView(PageKeys.Roles))
                                    {
                                        <a asp-action="Details" asp-route-id="@role.RoleID" class="btn btn-outline-info" title="View permissions">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (PermCtx.CanEdit(PageKeys.Roles))
                                    {
                                        <a asp-action="Edit" asp-route-id="@role.RoleID" class="btn btn-outline-secondary" title="Edit role">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (!role.IsSystemRole && PermCtx.CanDelete(PageKeys.Roles))
                                    {
                                        <form asp-action="Delete" asp-route-id="@role.RoleID" method="post" class="d-inline" onsubmit="return confirm('Delete this role?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete role">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
