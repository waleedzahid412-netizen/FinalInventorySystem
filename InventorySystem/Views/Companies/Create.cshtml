@model InventorySystem.ViewModels.Companies.CreateCompanyViewModel
@{
    ViewData["Title"] = "Add New Company";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-building-add me-2 text-primary"></i>Add Company
            </h1>
            <p class="text-muted small mb-0">Register a new manufacturing company or FMCG company.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm col-lg-8 mx-auto">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3">
                    <!-- Company Name -->
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="CompanyName" class="form-control" placeholder="e.g. Nestlé Pakistan Ltd" required />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <!-- Contact Person -->
                    <div class="col-md-6">
                        <label asp-for="ContactPerson" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="ContactPerson" class="form-control" placeholder="e.g. Tariq Mehmood" required />
                        <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g. 0300-1234567" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="e.g. contact@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Tax ID (NTN) -->
                    <div class="col-md-6">
                        <label asp-for="TaxID" class="form-label fw-semibold"></label>
                        <input asp-for="TaxID" class="form-control" placeholder="e.g. 1234567-8" />
                        <span asp-validation-for="TaxID" class="text-danger small"></span>
                    </div>

                    <!-- Company Percentage (optional) -->
                    <div class="col-md-6">
                        <label asp-for="CompanyPercentage" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="CompanyPercentage" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="e.g. 5.00" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="CompanyPercentage" class="text-danger small"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter factory / head office street address..."></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Save Company
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
