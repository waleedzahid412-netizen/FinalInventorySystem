@model InventorySystem.ViewModels.Companies.EditCompanyViewModel
@{
    ViewData["Title"] = "Edit Supplier Profile";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-pencil-square me-2 text-primary"></i>Edit Supplier Profile
            </h1>
            <p class="text-muted small mb-0">Update contact and business parameters for <strong>@Model.CompanyName</strong>.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm col-lg-8 mx-auto">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="CompanyID" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3">
                    <!-- Company Name -->
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="CompanyName" class="form-control" required />
                        <span asp-validation-for="CompanyName" class="text-danger small"></span>
                    </div>

                    <!-- Contact Person -->
                    <div class="col-md-6">
                        <label asp-for="ContactPerson" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="ContactPerson" class="form-control" required />
                        <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Tax ID (NTN) -->
                    <div class="col-md-12">
                        <label asp-for="TaxID" class="form-label fw-semibold"></label>
                        <input asp-for="TaxID" class="form-control" />
                        <span asp-validation-for="TaxID" class="text-danger small"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i>Update Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
