@model InventorySystem.ViewModels.Companies.CompanyDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Company.CompanyName} - Supplier Details";
    var summary = Model.Company.FinancialSummary;
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-building me-2 text-primary"></i>@Model.Company.CompanyName
            </h1>
            <p class="text-muted small mb-0">
                Registered on @Model.Company.CreatedAt.ToString("MMMM dd, yyyy") | Contact: <strong>@(Model.Company.ContactPerson ?? "N/A")</strong>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Company.CompanyID" class="btn btn-primary shadow-sm">
                <i class="bi bi-pencil me-1"></i>Edit Supplier
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <!-- 6 Financial & Operational KPI Header Cards -->
    <div class="row g-3 mb-4">
        <!-- Outstanding Payable -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 @(summary?.OutstandingPayable > 0 ? "border-warning bg-warning-subtle" : "border-success bg-success-subtle") h-100">
                <div class="card-body p-3">
                    <div class="text-xs fw-bold text-uppercase text-muted mb-1">Outstanding Payable</div>
                    <div class="h5 mb-0 fw-bold @(summary?.OutstandingPayable > 0 ? "text-warning-emphasis" : "text-success")">
                        Rs. @((summary?.OutstandingPayable ?? 0m).ToString("N2"))
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Purchases -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-primary h-100">
                <div class="card-body p-3">
                    <div class="text-xs fw-bold text-uppercase text-muted mb-1">Total Purchases</div>
                    <div class="h5 mb-0 fw-bold text-dark">
                        Rs. @((summary?.TotalPurchases ?? 0m).ToString("N2"))
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Paid -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-info h-100">
                <div class="card-body p-3">
                    <div class="text-xs fw-bold text-uppercase text-muted mb-1">Total Payments</div>
                    <div class="h5 mb-0 fw-bold text-dark">
                        Rs. @((summary?.TotalPaid ?? 0m).ToString("N2"))
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Invoices Count -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-danger h-100">
                <div class="card-body p-3">
                    <div class="text-xs fw-bold text-uppercase text-muted mb-1">Pending Invoices</div>
                    <div class="h5 mb-0 fw-bold text-danger">
                        @(summary?.PendingInvoicesCount ?? 0) Invoices
                    </div>
                </div>
            </div>
        </div>

        <!-- Last Purchase Date -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-secondary h-100">
                <div class="card-body p-3">
                    <div class="text-xs fw-bold text-uppercase text-muted mb-1">Last Purchase</div>
                    <div class="h6 mb-0 fw-semibold text-dark">
                        @(summary?.LastPurchaseDate?.ToString("MMM dd, yyyy") ?? "No Purchases")
                    </div>
                </div>
            </div>
        </div>

        <!-- Last Payment Date -->
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-secondary h-100">
                <div class="card-body p-3">
                    <div class="text-xs fw-bold text-uppercase text-muted mb-1">Last Payment</div>
                    <div class="h6 mb-0 fw-semibold text-dark">
                        @(summary?.LastPaymentDate?.ToString("MMM dd, yyyy") ?? "No Payments")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Specs Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-info-circle me-2"></i>Supplier Basic Information</h6>
        </div>
        <div class="card-body pt-0">
            <div class="row g-3">
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted small d-block">Contact Person</span>
                    <strong class="text-dark">@(Model.Company.ContactPerson ?? "-")</strong>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted small d-block">Phone Number</span>
                    <strong class="text-dark">@(Model.Company.Phone ?? "-")</strong>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted small d-block">Email Address</span>
                    <strong class="text-dark">@(Model.Company.Email ?? "-")</strong>
                </div>
                <div class="col-md-3 col-sm-6">
                    <span class="text-muted small d-block">Tax Identification Number</span>
                    <strong class="text-dark">@(Model.Company.TaxID ?? "-")</strong>
                </div>
                <div class="col-12">
                    <span class="text-muted small d-block">Office / Factory Address</span>
                    <span class="text-dark">@(Model.Company.Address ?? "No address recorded.")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 History Tabs -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3 pb-0">
            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link fw-semibold @(Model.ActiveTab == "purchases" ? "active text-primary border-primary border-bottom-0" : "text-muted")"
                       asp-action="Details" asp-route-id="@Model.Company.CompanyID" asp-route-activeTab="purchases">
                        <i class="bi bi-cart-check me-2"></i>Purchase History
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-semibold @(Model.ActiveTab == "payments" ? "active text-primary border-primary border-bottom-0" : "text-muted")"
                       asp-action="Details" asp-route-id="@Model.Company.CompanyID" asp-route-activeTab="payments">
                        <i class="bi bi-cash-stack me-2"></i>Payment History
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-semibold @(Model.ActiveTab == "ledger" ? "active text-primary border-primary border-bottom-0" : "text-muted")"
                       asp-action="Details" asp-route-id="@Model.Company.CompanyID" asp-route-activeTab="ledger">
                        <i class="bi bi-journal-text me-2"></i>Company Ledger
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body p-0">
            <!-- TAB 1: PURCHASE HISTORY -->
            @if (Model.ActiveTab == "purchases")
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Invoice #</th>
                                <th>Date</th>
                                <th class="text-end">Total Amount</th>
                                <th class="text-end">Paid Amount</th>
                                <th class="text-end">Outstanding</th>
                                <th class="text-center pe-4">Payment Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PurchaseHistory.Items.Any())
                            {
                                foreach (var item in Model.PurchaseHistory.Items)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">@item.InvoiceNumber</td>
                                        <td>@item.InvoiceDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end fw-semibold">Rs. @item.TotalAmount.ToString("N2")</td>
                                        <td class="text-end text-success">Rs. @item.PaidAmount.ToString("N2")</td>
                                        <td class="text-end fw-bold text-danger">Rs. @item.OutstandingAmount.ToString("N2")</td>
                                        <td class="text-center pe-4">
                                            <span class="badge @(item.Status == "PAID" ? "bg-success" : (item.Status == "PARTIAL" ? "bg-warning text-dark" : "bg-danger"))">
                                                @item.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No purchase history recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- TAB 2: PAYMENT HISTORY -->
            @if (Model.ActiveTab == "payments")
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Payment #</th>
                                <th>Invoice #</th>
                                <th>Method</th>
                                <th>Reference #</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center pe-4">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PaymentHistory.Items.Any())
                            {
                                foreach (var payment in Model.PaymentHistory.Items)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">#@payment.CompanyPaymentID</td>
                                        <td class="text-primary">@payment.InvoiceNumber</td>
                                        <td><span class="badge bg-secondary">@payment.PaymentMethod</span></td>
                                        <td>@(payment.ReferenceNumber ?? "-")</td>
                                        <td class="text-end fw-bold text-success">Rs. @payment.Amount.ToString("N2")</td>
                                        <td class="text-center pe-4">@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No payment history recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- TAB 3: COMPANY LEDGER -->
            @if (Model.ActiveTab == "ledger")
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Date</th>
                                <th>Transaction Type</th>
                                <th>Description</th>
                                <th class="text-end">Debit (Payment)</th>
                                <th class="text-end">Credit (Purchase)</th>
                                <th class="text-end pe-4">Net Change</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CompanyLedger.Items.Any())
                            {
                                foreach (var ledger in Model.CompanyLedger.Items)
                                {
                                    <tr>
                                        <td class="ps-4">@ledger.TransactionDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td><span class="badge bg-dark">@ledger.TransactionType</span></td>
                                        <td class="small text-muted">@(ledger.Description ?? "-")</td>
                                        <td class="text-end text-success fw-semibold">Rs. @ledger.DebitAmount.ToString("N2")</td>
                                        <td class="text-end text-danger fw-semibold">Rs. @ledger.CreditAmount.ToString("N2")</td>
                                        <td class="text-end pe-4 fw-bold @(ledger.NetChange >= 0 ? "text-danger" : "text-success")">
                                            Rs. @ledger.NetChange.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No ledger entries recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
