@model InventorySystem.ViewModels.Promotions.PromotionDetailsViewModel

@{
    ViewData["Title"] = "Promotion Campaign Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Promotion Campaign Details</h1>
            <p class="text-muted small mb-0">View campaign metadata and rule configurations.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.PromotionID" class="btn btn-primary shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit Campaign
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Campaign Header Info -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-tag me-2"></i> Campaign Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary">Campaign ID:</dt>
                        <dd class="col-sm-8 fw-bold">#@Model.PromotionID</dd>

                        <dt class="col-sm-4 text-secondary">Campaign Name:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold">@Model.Name</dd>

                        <dt class="col-sm-4 text-secondary">Start Date:</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToString("dd MMMM yyyy")</dd>

                        <dt class="col-sm-4 text-secondary">End Date:</dt>
                        <dd class="col-sm-8">@Model.EndDate.ToString("dd MMMM yyyy")</dd>

                        <dt class="col-sm-4 text-secondary">Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                bool isValidNow = Model.StartDate <= DateTime.UtcNow && Model.EndDate >= DateTime.UtcNow;
                                if (isValidNow)
                                {
                                    <span class="badge bg-success shadow-sm"><i class="bi bi-check-circle me-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> Scheduled / Expired</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Disabled</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-secondary">Created By:</dt>
                        <dd class="col-sm-8">@Model.CreatedByName</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Rules Summary Card -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-card-checklist me-2"></i> Offer Summary</h5>
                </div>
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                    <div class="display-4 text-primary fw-bold mb-2">@Model.Rules.Count</div>
                    <div class="text-muted fw-semibold uppercase small mb-3">Total Active Rules in Campaign</div>
                    <p class="text-muted small">When a customer purchases the required base quantity of any trigger product, the system automatically suggests the designated reward product free of charge.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Rules Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-gift me-2"></i> Configured "Buy X Get Y Free" Rules</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4">Rule ID</th>
                            <th>Trigger (Buy) Product</th>
                            <th class="text-center">Required Buy Base Qty</th>
                            <th>Reward (Free) Product</th>
                            <th class="text-center">Free Reward Base Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Rules.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No rules configured for this promotion.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rule in Model.Rules)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@rule.RuleID</td>
                                    <td>
                                        <span class="fw-semibold text-dark">@rule.BuyProductName</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary px-3 py-2 fs-6">Buy @rule.BuyQuantity</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-success">@rule.FreeProductName</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success px-3 py-2 fs-6">Get @rule.FreeQuantity Free</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
